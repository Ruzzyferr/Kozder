---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ShareBox from '../../components/ShareBox.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const isActive = project.data.status === 'Aktif';
const url = new URL(Astro.url.pathname, Astro.site).toString();
---

<BaseLayout
  title={`${project.data.title_tr} — KOZ-DER`}
  description={project.data.summary_tr}
  image={project.data.coverImage}
>
  <article class="bg-brand-paper">
    <div class="container mx-auto px-4 pt-8 sm:pt-12">
      <a href="/projeler" class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-brand-ink hover:text-brand-stamp transition-colors mb-6 border-b border-brand-ink/40 pb-1">
        <span>←</span> Projeler
      </a>
    </div>

    <div class="container mx-auto px-4 pb-20">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
        <div class="lg:col-span-8">
          {project.data.coverImage && (
            <div class="bg-brand-cream border-2 border-brand-ink overflow-hidden mb-10" style="box-shadow: 6px 6px 0 0 #6B4630;">
              <img
                src={project.data.coverImage}
                alt={project.data.title_tr}
                class="block w-full h-auto"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )}

          <header class="mb-8">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-3">{project.data.programType} · {project.data.year}</p>
            <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl tracking-tightest leading-[0.95] text-brand-ink mb-6">
              {project.data.title_tr}
            </h1>
            <p class="font-display text-xl sm:text-2xl text-ink-soft leading-snug border-l-4 border-brand-stamp pl-5 italic">
              {project.data.summary_tr}
            </p>
          </header>

          <div class="prose-kozder bg-brand-cream border-2 border-brand-ink p-6 sm:p-10" style="box-shadow: 5px 5px 0 0 #6B4630;">
            <Content />
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-28 space-y-5">
            <div class={`border-2 border-brand-ink p-6 ${isActive ? 'bg-brand-stamp text-brand-cream' : 'bg-brand-cream text-brand-ink'}`} style="box-shadow: 5px 5px 0 0 #6B4630;">
              <p class={`text-xs font-bold uppercase tracking-[0.2em] mb-2 ${isActive ? 'text-brand-cream' : 'text-brand-stamp'}`}>Durum</p>
              <p class="font-display font-black text-3xl tracking-tight leading-none">
                {isActive ? 'Aktif başvuru' : 'Tamamlandı'}
              </p>
            </div>

            <div class="bg-brand-cream border-2 border-brand-ink divide-y-2 divide-brand-ink">
              <div class="p-5">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Program</p>
                <p class="font-display font-bold text-xl text-brand-ink">{project.data.programType}</p>
              </div>
              <div class="p-5">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Yıl</p>
                <p class="font-display font-bold text-xl text-brand-ink">{project.data.year}</p>
              </div>
              <div class="p-5">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Konum</p>
                <p class="font-display font-bold text-lg text-brand-ink leading-snug">{project.data.location}</p>
              </div>
              <div class="p-5">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Tarih</p>
                <p class="text-sm text-brand-ink font-semibold">{project.data.startDate}{project.data.endDate ? ` → ${project.data.endDate}` : ''}</p>
              </div>
              {project.data.themes.length > 0 && (
                <div class="p-5">
                  <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-3">Temalar</p>
                  <div class="flex flex-wrap gap-1.5">
                    {project.data.themes.map(theme => (
                      <span class="text-[11px] font-semibold uppercase tracking-wider px-2 py-1 border border-brand-ink/40 text-brand-walnut">{theme}</span>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <div class="space-y-3">
              {project.data.infoPackUrl && (
                <a
                  href={project.data.infoPackUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block bg-brand-cream border-2 border-brand-ink hover:bg-brand-paper p-5 transition-colors"
                >
                  <p class="font-display font-bold text-lg text-brand-ink flex items-center justify-between">
                    Bilgi Paketi (PDF) <span>↓</span>
                  </p>
                </a>
              )}
              <a
                href={project.data.applicationUrl ?? '/iletisim'}
                target={project.data.applicationUrl ? '_blank' : undefined}
                rel={project.data.applicationUrl ? 'noopener noreferrer' : undefined}
                class="block bg-brand-ink text-brand-cream border-2 border-brand-ink hover:bg-brand-stamp p-5 transition-colors"
                style="box-shadow: 5px 5px 0 0 #6B4630;"
              >
                <p class="font-display font-black text-2xl flex items-center justify-between">
                  Başvuru Yap <span>→</span>
                </p>
              </a>
            </div>

            <ShareBox title={project.data.title_tr} url={url} />
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
