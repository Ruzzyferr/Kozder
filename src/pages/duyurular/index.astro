---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { byNewest } from '../../utils/contentSort';

const posts = (await getCollection('posts')).filter(p => !p.data.draft);
const sortedPosts = posts.sort(byNewest('posts', 'date'));
---

<BaseLayout
  title="Duyurular — KOZ-DER"
  description="KOZ-DER'den son duyurular, çağrılar ve haberler."
>
  <Breadcrumb
    kicker="Duyurular"
    items={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Duyurular', href: '/duyurular' }]}
    pageTitle="Yeni çağrılar."
    intro="Başvuru tarihleri ve dernekten güncel duyurular."
  />

  <div class="container mx-auto px-4 py-12 sm:py-16">
    {sortedPosts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedPosts.map((post) => (
          <PostCard
            title={post.data.title_tr}
            summary={post.data.summary_tr}
            date={post.data.date}
            tags={post.data.tags}
            slug={post.slug}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-brand-cream card card-2">
        <p class="font-display font-bold text-xl text-brand-ink">Henüz duyuru eklenmemiş.</p>
      </div>
    )}
  </div>
</BaseLayout>
