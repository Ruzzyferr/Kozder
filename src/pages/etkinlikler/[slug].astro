---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatEventDate, formatEventTime } from '../../utils/date';
import { buildEventStartDate, buildIcsString, googleCalendarUrl, isAllDay } from '../../utils/calendar';
import { eventSchema } from '../../utils/seo';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await event.render();

const formattedDate = formatEventDate(event.data.date, { weekday: true });
const formattedTime = formatEventTime(event.data.time);

const startDate = buildEventStartDate(event.data.date, event.data.time);
const allDay = startDate ? isAllDay(startDate) : true;
const endDate = startDate ? new Date(startDate.getTime() + (allDay ? 0 : 2 * 60 * 60 * 1000)) : null;

const url = new URL(Astro.url.pathname, Astro.site).toString();

const ics = startDate
  ? buildIcsString({
      uid: `${event.slug}@kozder.com`,
      title: event.data.title_tr,
      description: event.data.title_tr,
      location: event.data.location,
      start: startDate,
      end: endDate ?? undefined,
      url,
      allDay,
    })
  : null;
const icsDataUri = ics ? `data:text/calendar;charset=utf-8,${encodeURIComponent(ics)}` : null;

const gcalUrl = startDate
  ? googleCalendarUrl({
      uid: `${event.slug}@kozder.com`,
      title: event.data.title_tr,
      description: `${event.data.title_tr}\n\n${url}`,
      location: event.data.location,
      start: startDate,
      end: endDate ?? undefined,
      url,
      allDay,
    })
  : null;

const ld = startDate
  ? eventSchema({
      name: event.data.title_tr,
      description: `${event.data.title_tr} — KOZ-DER etkinliği`,
      startDate: startDate.toISOString(),
      endDate: endDate?.toISOString(),
      location: event.data.location,
      image: event.data.coverImage ? new URL(event.data.coverImage, Astro.site).toString() : undefined,
      url,
      registrationUrl: event.data.registrationUrl,
    })
  : undefined;

const dayNum = startDate ? startDate.getDate() : '?';
const monthShort = startDate ? startDate.toLocaleDateString('tr-TR', { month: 'short' }).toUpperCase().replace('.', '') : '';
---

<BaseLayout
  title={`${event.data.title_tr} — KOZ-DER`}
  description={`${event.data.title_tr} — ${event.data.location}, ${formattedDate}.`}
  image={event.data.coverImage}
  jsonLd={ld}
>
  <article class="bg-brand-paper">
    <div class="container mx-auto px-4 pt-8 sm:pt-12">
      <a href="/etkinlikler" class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-brand-ink hover:text-brand-stamp transition-colors mb-6 border-b border-brand-ink/40 pb-1">
        <span>←</span> Etkinlikler
      </a>
    </div>

    <div class="container mx-auto px-4 pb-20">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
        <div class="lg:col-span-8">
          {event.data.coverImage && (
            <div class="bg-brand-cream border-2 border-brand-ink overflow-hidden mb-10" style="box-shadow: 6px 6px 0 0 #6B4630;">
              <img
                src={event.data.coverImage}
                alt={event.data.title_tr}
                class="block w-full h-auto"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )}

          <header class="mb-8">
            <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl tracking-tightest leading-[0.95] text-brand-ink">
              {event.data.title_tr}
            </h1>
          </header>

          <div class="prose-kozder bg-brand-cream border-2 border-brand-ink p-6 sm:p-10" style="box-shadow: 5px 5px 0 0 #6B4630;">
            <Content />
          </div>
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-28 space-y-5">
            <div class="bg-brand-cream border-2 border-brand-ink divide-y-2 divide-brand-ink" style="box-shadow: 5px 5px 0 0 #6B4630;">
              <div class="p-5">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Tarih</p>
                <p class="font-display font-bold text-xl text-brand-ink leading-snug">{formattedDate}</p>
              </div>
              {formattedTime && (
                <div class="p-5">
                  <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Saat</p>
                  <p class="font-display font-bold text-xl text-brand-ink">{formattedTime}</p>
                </div>
              )}
              <div class="p-5">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Konum</p>
                <p class="font-display font-bold text-lg text-brand-ink leading-snug">{event.data.location}</p>
              </div>
            </div>

            {event.data.registrationUrl && (
              <a
                href={event.data.registrationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="block bg-brand-stamp text-brand-cream hover:bg-brand-ink border-2 border-brand-ink p-5 transition-colors"
                style="box-shadow: 5px 5px 0 0 #231C1C;"
              >
                <p class="font-display font-black text-2xl leading-none tracking-tight flex items-center justify-between">
                  Kayıt Ol
                  <span>→</span>
                </p>
              </a>
            )}

            {(gcalUrl || icsDataUri) && (
              <div class="bg-brand-cream border-2 border-brand-ink p-6">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-3">Takvime ekle</p>
                <div class="space-y-2">
                  {gcalUrl && (
                    <a href={gcalUrl} target="_blank" rel="noopener noreferrer" class="flex items-center justify-between border border-brand-ink/40 hover:border-brand-ink hover:bg-brand-paper px-4 py-2.5 transition-colors text-sm font-semibold text-brand-ink">
                      Google Takvim <span>→</span>
                    </a>
                  )}
                  {icsDataUri && (
                    <a href={icsDataUri} download={`${event.slug}.ics`} class="flex items-center justify-between border border-brand-ink/40 hover:border-brand-ink hover:bg-brand-paper px-4 py-2.5 transition-colors text-sm font-semibold text-brand-ink">
                      Apple / Outlook (.ics) <span>↓</span>
                    </a>
                  )}
                </div>
              </div>
            )}

            <div class="bg-brand-cream border-2 border-brand-ink p-6">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-3">Paylaş</p>
              <div class="grid grid-cols-3 gap-2">
                <a href={`https://wa.me/?text=${encodeURIComponent(event.data.title_tr + ' ' + url)}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center h-11 border border-brand-ink/40 hover:bg-brand-ink hover:text-brand-cream text-sm font-bold uppercase tracking-wider transition-colors">WhatsApp</a>
                <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(event.data.title_tr)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center h-11 border border-brand-ink/40 hover:bg-brand-ink hover:text-brand-cream text-sm font-bold uppercase tracking-wider transition-colors">X</a>
                <button type="button" data-copy={url} class="flex items-center justify-center h-11 border border-brand-ink/40 hover:bg-brand-ink hover:text-brand-cream text-sm font-bold uppercase tracking-wider transition-colors">Link</button>
              </div>
              <p id="copy-toast" class="mt-3 text-xs font-bold uppercase tracking-wider text-brand-stamp hidden">Kopyalandı ✓</p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const toast = document.getElementById('copy-toast');
        toast?.classList.remove('hidden');
        setTimeout(() => toast?.classList.add('hidden'), 2000);
      } catch {}
    });
  });
</script>
