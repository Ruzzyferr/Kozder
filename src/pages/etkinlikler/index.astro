---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getEventDateSortKey } from '../../utils/date';
import { byNewest } from '../../utils/contentSort';

const events = (await getCollection('events')).filter(e => !e.data.draft);
const todayMidnight = new Date();
todayMidnight.setHours(0, 0, 0, 0);

// "Yaklaşan etkinlikler": only upcoming, soonest event date first.
const upcoming = events
  .filter(e => getEventDateSortKey(e.data.date) >= todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(a.data.date) - getEventDateSortKey(b.data.date));

// "Tüm etkinlikler": every event, newest-added first.
const allEvents = [...events].sort(byNewest('events', 'date'));
---

<BaseLayout
  title="Etkinlikler — KOZ-DER"
  description="KOZ-DER'in düzenlediği yaklaşan ve geçmiş etkinlikler. Kitap kulübü, speaking club, gönüllü buluşmaları ve daha fazlası."
>
  <Breadcrumb
    items={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Etkinlikler', href: '/etkinlikler' }]}
    pageTitle="Etkinliklerimiz"
    intro="Atölyeler, buluşmalar, kulüpler ve sosyal aktiviteler — tek listede."
  />

  <div class="container mx-auto px-4 py-12 sm:py-16">

    {upcoming.length > 0 && (
      <section class="mb-16">
        <header class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
          <h2 class="font-display font-black text-3xl sm:text-4xl tracking-tightest text-brand-ink leading-none">
            Yaklaşan etkinlikler.
          </h2>
          <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-walnut">Tarihi en yakın olan önce · {upcoming.length}</p>
        </header>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {upcoming.map(event => (
            <EventCard
              title={event.data.title_tr}
              date={event.data.date}
              time={event.data.time}
              location={event.data.location}
              coverImage={event.data.coverImage}
              slug={event.slug}
            />
          ))}
        </div>
      </section>
    )}

    {allEvents.length > 0 ? (
      <section>
        <header class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
          <h2 class="font-display font-black text-3xl sm:text-4xl tracking-tightest text-brand-ink leading-none">
            Tüm etkinlikler.
          </h2>
          <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-walnut">En son eklenen önce · {allEvents.length}</p>
        </header>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {allEvents.map(event => (
            <EventCard
              title={event.data.title_tr}
              date={event.data.date}
              time={event.data.time}
              location={event.data.location}
              coverImage={event.data.coverImage}
              slug={event.slug}
            />
          ))}
        </div>
      </section>
    ) : (
      <div class="text-center py-16 bg-brand-cream border-2 border-brand-ink">
        <p class="text-ink-muted text-lg">Henüz etkinlik eklenmemiş. Yakında burada olacak!</p>
      </div>
    )}
  </div>
</BaseLayout>
