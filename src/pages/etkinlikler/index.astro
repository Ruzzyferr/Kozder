---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getEventDateSortKey } from '../../utils/date';

const events = (await getCollection('events')).filter(e => !e.data.draft);
const todayMidnight = new Date();
todayMidnight.setHours(0, 0, 0, 0);

const isUpcoming = (date: string) => getEventDateSortKey(date) >= todayMidnight.getTime();

// Yaklaşanlar tarihi en yakın olan önce, geçmişler en yeni olan önce.
const upcoming = events
  .filter(e => isUpcoming(e.data.date))
  .sort((a, b) => getEventDateSortKey(a.data.date) - getEventDateSortKey(b.data.date));

const past = events
  .filter(e => !isUpcoming(e.data.date))
  .sort((a, b) => getEventDateSortKey(b.data.date) - getEventDateSortKey(a.data.date));
---

<BaseLayout
  title="Etkinlikler — KOZ-DER"
  description="KOZ-DER'in düzenlediği yaklaşan ve geçmiş etkinlikler. Kitap kulübü, speaking club, gönüllü buluşmaları ve daha fazlası."
>
  <Breadcrumb
    kicker="Takvim"
    items={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Etkinlikler', href: '/etkinlikler' }]}
    pageTitle="Etkinliklerimiz."
    intro="Atölyeler, buluşmalar, kulüpler ve sosyal aktiviteler — tek listede."
  />

  <div class="container mx-auto px-4 py-12 sm:py-16">

    <section class="mb-16">
      <header class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
        <h2 class="font-display font-black text-3xl sm:text-4xl tracking-tightest text-brand-ink leading-none">
          Yaklaşan etkinlikler.
        </h2>
        {upcoming.length > 0 && (
          <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-walnut">
            Tarihi en yakın olan önce · {upcoming.length}
          </p>
        )}
      </header>

      {upcoming.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {upcoming.map(event => (
            <EventCard
              title={event.data.title_tr}
              date={event.data.date}
              time={event.data.time}
              location={event.data.location}
              coverImage={event.data.coverImage}
              coverFit={event.data.coverFit}
              slug={event.slug}
            />
          ))}
        </div>
      ) : (
        <div class="bg-brand-cream p-8 sm:p-10 card card-2">
          <p class="font-display font-bold text-xl sm:text-2xl text-brand-ink leading-snug">
            Şu an takvimde açık bir etkinlik yok.
          </p>
          <p class="mt-3 text-ink-soft leading-relaxed max-w-xl">
            Yeni buluşmaları ilk sen duy: sosyal medyadan takip et ya da aktif proje çağrılarımıza göz at.
          </p>
          <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href="/projeler" class="inline-flex items-center justify-center gap-2 bg-brand-ink text-brand-cream hover:bg-brand-stamp px-6 py-3 text-sm font-bold uppercase tracking-wider transition-colors">
              Aktif Çağrılar →
            </a>
            <a href="https://www.instagram.com/kozder2018" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border border-brand-ink text-brand-ink hover:bg-brand-ink hover:text-brand-cream px-6 py-3 text-sm font-bold uppercase tracking-wider transition-colors">
              Instagram'da Takip Et ↗
            </a>
          </div>
        </div>
      )}
    </section>

    {past.length > 0 && (
      <section>
        <header class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
          <h2 class="font-display font-black text-3xl sm:text-4xl tracking-tightest text-brand-ink leading-none">
            Geçmiş etkinlikler.
          </h2>
          <p class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-walnut">
            En yeniden eskiye · {past.length}
          </p>
        </header>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {past.map(event => (
            <EventCard
              title={event.data.title_tr}
              date={event.data.date}
              time={event.data.time}
              location={event.data.location}
              coverImage={event.data.coverImage}
              coverFit={event.data.coverFit}
              slug={event.slug}
              past
            />
          ))}
        </div>
      </section>
    )}

    {events.length === 0 && (
      <div class="text-center py-16 bg-brand-cream card card-2">
        <p class="font-display font-bold text-xl text-brand-ink">Henüz etkinlik eklenmemiş. Yakında burada olacak!</p>
      </div>
    )}
  </div>
</BaseLayout>
