---
import { getCollection } from 'astro:content';
import ProjectDetail from '../../../components/pages/ProjectDetail.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects', e => e.slug.startsWith('en/'));
  return entries.map(e => ({ params: { slug: e.slug.replace(/^en\//, '') }, props: { project: e } }));
}

const { project } = Astro.props;
---

<ProjectDetail project={project} lang="en" />
