---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { byNewest } from '../../utils/contentSort';

const newsRaw = (await getCollection('news')).filter(n => !n.data.draft);
const news = newsRaw.sort(byNewest('news', 'date'));
---

<BaseLayout
  title="Haberler — KOZ-DER"
  description="KOZ-DER'in buluşmaları, etkinlikleri ve gönüllü faaliyetlerinden haberler ve kareler."
>
  <Breadcrumb
    items={[{ label: 'Ana Sayfa', href: '/' }, { label: 'Haberler', href: '/haberler' }]}
    pageTitle="Haberler"
    intro="Gerçekleştirdiğimiz buluşmalar, katıldığımız etkinlikler ve gönüllü faaliyetlerimizden kareler."
  />

  <div class="container mx-auto px-4 py-12 sm:py-16">
    {news.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {news.map((item) => (
          <NewsCard
            title={item.data.title_tr}
            date={item.data.date}
            location={item.data.location}
            coverImage={item.data.coverImage}
            summary={item.data.summary_tr}
            slug={item.slug}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-brand-cream border-2 border-brand-ink" style="box-shadow: 5px 5px 0 0 #6B4630;">
        <p class="text-ink-soft text-lg">Henüz haber eklenmemiş.</p>
      </div>
    )}
  </div>
</BaseLayout>
