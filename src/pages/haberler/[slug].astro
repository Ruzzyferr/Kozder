---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareBox from '../../components/ShareBox.astro';
import { getCollection } from 'astro:content';
import { formatEventDate } from '../../utils/date';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();

const formattedDate = formatEventDate(item.data.date, { weekday: true });
const url = new URL(Astro.url.pathname, Astro.site).toString();

// Cover image is shown separately; avoid duplicating it in the gallery.
const galleryImages = item.data.images.filter(src => src !== item.data.coverImage);
---

<BaseLayout
  title={`${item.data.title_tr} — KOZ-DER`}
  description={item.data.summary_tr}
  image={item.data.coverImage}
>
  <article class="bg-brand-paper">
    <div class="container mx-auto px-4 pt-8 sm:pt-12">
      <a href="/haberler" class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-brand-ink hover:text-brand-stamp transition-colors mb-6 border-b border-brand-ink/40 pb-1">
        <span>←</span> Haberler
      </a>
    </div>

    <div class="container mx-auto px-4 pb-20">
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
        <div class="lg:col-span-8">
          {item.data.coverImage && (
            <div class="bg-brand-cream overflow-hidden mb-10 card card-2">
              <img
                src={item.data.coverImage}
                alt={item.data.title_tr}
                class="block w-full h-auto"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          )}

          <header class="mb-8">
            {item.data.category && (
              <p class="inline-block mb-4 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-walnut border border-brand-ink/40 px-2.5 py-1">
                {item.data.category}
              </p>
            )}
            <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl tracking-tightest leading-[0.95] text-brand-ink">
              {item.data.title_tr}
            </h1>
            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-base sm:text-lg font-semibold text-brand-walnut">
              <span class="flex items-center gap-2">
                <svg class="w-5 h-5 text-brand-stamp" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                {formattedDate}
              </span>
              {item.data.location && (
                <>
                  <span class="text-brand-walnut/40">·</span>
                  <span class="flex items-center gap-2">
                    <svg class="w-5 h-5 text-brand-stamp" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    {item.data.location}
                  </span>
                </>
              )}
            </div>
          </header>

          <div class="prose-kozder bg-brand-cream p-6 sm:p-10 card card-2">
            <Content />
          </div>

          {galleryImages.length > 0 && (
            <section class="mt-10">
              <h2 class="font-display font-black text-2xl sm:text-3xl tracking-tightest text-brand-ink mb-5 leading-none">
                Galeri.
              </h2>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
                {galleryImages.map((src) => (
                  <a href={src} target="_blank" rel="noopener noreferrer" class="block group">
                    <div class="relative aspect-square bg-surface-muted overflow-hidden card">
                      <img
                        src={src}
                        alt={item.data.title_tr}
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="lg:col-span-4">
          <div class="sticky top-28 space-y-5">
            <div class="bg-brand-cream divide-y divide-line card card-2">
              <div class="p-5">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Tarih</p>
                <p class="font-display font-bold text-xl text-brand-ink leading-snug">{formattedDate}</p>
              </div>
              {item.data.location && (
                <div class="p-5">
                  <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-1">Konum</p>
                  <p class="font-display font-bold text-lg text-brand-ink leading-snug">{item.data.location}</p>
                </div>
              )}
            </div>

            <ShareBox title={item.data.title_tr} url={url} />
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
