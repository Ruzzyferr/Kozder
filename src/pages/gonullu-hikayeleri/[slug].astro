---
import { getCollection } from 'astro:content';
import StoryDetail from '../../components/pages/StoryDetail.astro';

export async function getStaticPaths() {
  const entries = await getCollection('stories', e => !e.slug.startsWith('en/'));
  return entries.map(e => ({ params: { slug: e.slug }, props: { story: e } }));
}

const { story } = Astro.props;
---

<StoryDetail story={story} lang="tr" />
