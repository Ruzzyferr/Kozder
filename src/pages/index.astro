---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import affiliations from '../data/affiliations.json';
import { getCollection } from 'astro:content';
import { getEventDateSortKey, formatEventDate } from '../utils/date';
import { byNewest } from '../utils/contentSort';

const projects = (await getCollection('projects')).filter(p => !p.data.draft);
const events = (await getCollection('events')).filter(e => !e.data.draft);
const posts = (await getCollection('posts')).filter(p => !p.data.draft);
const news = (await getCollection('news')).filter(n => !n.data.draft);
const stories = (await getCollection('stories')).filter(s => !s.data.draft);

const projectStatusRank = (s: string) => (s === 'Aktif' ? 0 : 1);
const newestProject = byNewest('projects', 'startDate');

const featuredProjects = projects
  .filter(p => p.data.featured)
  .sort((a, b) => {
    const s = projectStatusRank(a.data.status) - projectStatusRank(b.data.status);
    if (s !== 0) return s;
    return newestProject(a, b);
  })
  .slice(0, 5);

// Etkinlik bölümü: yaklaşan varsa onlar, yoksa bölüm kaybolmasın diye
// en son yapılanlar gösterilir.
const todayMidnight = new Date();
todayMidnight.setHours(0, 0, 0, 0);
const upcomingEvents = events
  .filter(e => getEventDateSortKey(e.data.date) >= todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(a.data.date) - getEventDateSortKey(b.data.date));
const pastEvents = events
  .filter(e => getEventDateSortKey(e.data.date) < todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(b.data.date) - getEventDateSortKey(a.data.date));
const showingUpcoming = upcomingEvents.length > 0;
const homeEvents = (showingUpcoming ? upcomingEvents : pastEvents).slice(0, 4);

const recentPosts = [...posts].sort(byNewest('posts', 'date')).slice(0, 3);

// Öne çıkarılmış haberler başa sabitlenir, kalanı yeniden eskiye.
const newestNews = byNewest('news', 'date');
const sortedNews = [...news].sort(
  (a, b) => (Number(b.data.featured) - Number(a.data.featured)) || newestNews(a, b),
);
const leadNews = sortedNews[0];
const restNews = sortedNews.slice(1, 3);

const featuredStories = [...stories].sort(byNewest('stories', 'startDate')).slice(0, 8);

const stats = [
  { value: String(stories.length), label: 'Gönüllü hikayesi' },
  { value: String(projects.length), label: 'Yürütülen proje' },
  { value: '15+', label: 'Avrupa ortağı' },
  { value: '7', label: 'Ülke deneyimi' },
];

const affiliationRows = [
  { ...affiliations.networks, direction: 'left' as const, duration: 30 },
  { ...affiliations.partners, direction: 'right' as const, duration: 46 },
];

const steps = [
  { n: '01', title: 'Keşfet', text: 'Açık çağrıları ve aktif projeleri incele, sana uygun olanı seç.', href: '/projeler' },
  { n: '02', title: 'Başvur', text: 'Bilgi paketini oku, başvuru formunu doldur ve mülakata hazırlan.', href: '/sss' },
  { n: '03', title: 'Yola Çık', text: 'Avrupa\'ya doğru yola çık; gönüllülük, eğitim ve dayanışmayla deneyim biriktir.', href: '/gonullu-hikayeleri' },
];

// Etkinlik tarihini gün + kısaltılmış ay olarak parçalar.
function dateParts(value: string) {
  const key = getEventDateSortKey(value);
  if (!key) return { day: '·', month: '' };
  const d = new Date(key);
  return {
    day: String(d.getDate()).padStart(2, '0'),
    month: d.toLocaleDateString('tr-TR', { month: 'short' }).replace('.', '').toUpperCase(),
  };
}
---

<BaseLayout
  title="KOZ-DER — Avrupa için, Gençlerle"
  description="Erasmus+ ve ESC projeleriyle gençlerin Avrupa'da gönüllülük, eğitim ve dayanışma deneyimi yaşamasını destekleyen sivil toplum kuruluşu."
>
  <!-- ============ HERO — asimetrik, sağda tam kanayan fotoğraf ============ -->
  <section class="bg-brand-paper">
    <div class="grid lg:grid-cols-2 items-stretch">
      <div
        class="flex items-center px-5 sm:px-8 py-14 sm:py-20 lg:py-28
               lg:pl-[max(1.5rem,calc((100vw-1280px)/2+1rem))] lg:pr-12 xl:pr-20"
      >
        <div class="w-full max-w-xl reveal">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-7">
            Kilis · Erasmus+ &amp; Avrupa Dayanışma Programı
          </p>

          <h1 class="font-display text-brand-ink leading-[0.88] tracking-tightest">
            <span class="block text-[3.4rem] sm:text-7xl xl:text-8xl font-black">Avrupa.</span>
            <span
              class="block text-[3.4rem] sm:text-7xl xl:text-8xl font-black italic text-brand-walnut"
              style="font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;"
            >Gönüllü.</span>
            <span class="block text-[3.4rem] sm:text-7xl xl:text-8xl font-black">Sen.</span>
          </h1>

          <p class="mt-8 text-base sm:text-lg text-ink-soft leading-relaxed max-w-lg">
            KOZ-DER, gençlerin Erasmus+ ve Avrupa Dayanışma Programı ile
            <em class="not-italic font-semibold text-brand-ink">eğitim, gönüllülük ve kültürlerarası deneyim</em>
            kazanmasını sağlayan, Kilis merkezli bir sivil toplum kuruluşudur.
          </p>

          <div class="mt-10 flex flex-col sm:flex-row gap-3">
            <a
              href="/projeler"
              class="group inline-flex items-center justify-center gap-3 bg-brand-ink text-brand-cream hover:bg-brand-stamp px-7 py-4 text-[11px] font-semibold uppercase tracking-[0.16em] transition-colors duration-300"
            >
              Aktif Çağrıları Gör
              <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
            <a
              href="/gonullu-hikayeleri"
              class="inline-flex items-center justify-center gap-2 border border-brand-ink text-brand-ink hover:bg-brand-ink hover:text-brand-cream px-7 py-4 text-[11px] font-semibold uppercase tracking-[0.16em] transition-colors duration-300"
            >
              Hikayeleri Dinle
            </a>
          </div>
        </div>
      </div>

      <figure class="relative m-0 min-h-[330px] sm:min-h-[440px] lg:min-h-0">
        <img
          src="/images/hero-bremen.jpg"
          alt="Bridges for Futures-2 projesi katılımcıları Bremen Hauptbahnhof önünde"
          class="absolute inset-0 w-full h-full object-cover object-[50%_58%] lg:object-center"
          loading="eager"
          fetchpriority="high"
          width="960"
          height="1200"
        />
        <figcaption
          class="absolute bottom-0 left-0 right-0 px-5 pt-16 pb-4 text-[10px] font-medium uppercase tracking-[0.18em] text-white/85 bg-gradient-to-t from-black/70 via-black/25 to-transparent"
        >
          Bridges for Futures-2 · Bremen, Almanya
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ İSTATİSTİK — ince şerit ============ -->
  <section class="border-y border-line bg-brand-cream">
    <div class="container mx-auto px-4">
      <dl class="grid grid-cols-2 md:grid-cols-4">
        {stats.map((s, i) => (
          <div class={`py-7 sm:py-9 ${i % 2 === 1 ? 'pl-6' : ''} ${i > 0 ? 'md:pl-8' : ''} ${i < 2 ? 'border-b md:border-b-0 border-line' : ''} ${i > 0 ? 'md:border-l md:border-line' : ''}`}>
            <dt class="sr-only">{s.label}</dt>
            <dd class="m-0">
              <span class="font-display font-black text-4xl sm:text-5xl text-brand-ink leading-none tracking-tightest block">
                {s.value}
              </span>
              <span class="mt-2.5 block text-[10px] sm:text-[11px] uppercase tracking-[0.18em] text-ink-muted font-semibold">
                {s.label}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ AĞLAR & PAYDAŞLAR ============ -->
  <section class="bg-brand-paper border-b border-line py-12 sm:py-16" aria-labelledby="aglar-paydaslar">
    <h2 id="aglar-paydaslar" class="sr-only">Üyesi olduğumuz ağlar ve paydaşlarımız</h2>
    <div class="space-y-9 sm:space-y-11">
      {affiliationRows.map(row => (
        <div>
          <div class="container mx-auto px-4">
            <div class="flex items-center gap-4 mb-5">
              <p class="text-[10px] uppercase tracking-[0.22em] font-semibold text-ink-muted whitespace-nowrap">
                {row.label}
              </p>
              <span class="h-px flex-1 bg-line"></span>
            </div>
          </div>
          <LogoMarquee label={row.label} items={row.items} direction={row.direction} duration={row.duration} />
        </div>
      ))}
    </div>
  </section>

  <!-- ============ ÜÇ ADIM ============ -->
  <section class="py-20 sm:py-28 bg-brand-paper">
    <div class="container mx-auto px-4">
      <header class="max-w-2xl mb-14 reveal">
        <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">Nasıl işliyor</p>
        <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
          Üç adımda, Avrupa.
        </h2>
      </header>

      <ol class="grid md:grid-cols-3 gap-px bg-line border-y border-line">
        {steps.map(step => (
          <li class="bg-brand-paper">
            <a href={step.href} class="group block h-full p-7 sm:p-9 hover:bg-brand-cream transition-colors duration-300">
              <span class="font-display font-black text-5xl text-brand-walnut/35 leading-none tracking-tightest block group-hover:text-brand-walnut transition-colors duration-300">
                {step.n}
              </span>
              <h3 class="font-display font-bold text-2xl text-brand-ink mt-7 mb-3 tracking-tight">{step.title}</h3>
              <p class="text-sm text-ink-soft leading-relaxed">{step.text}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-walnut">
                Devam <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ AÇIK ÇAĞRILAR — editoryal liste ============ -->
  {featuredProjects.length > 0 && (
    <section class="py-20 sm:py-28 bg-brand-cream border-y border-line">
      <div class="container mx-auto px-4">
        <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12 reveal">
          <div class="max-w-2xl">
            <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">Çağrılar</p>
            <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
              Sıradaki proje.
            </h2>
          </div>
          <a href="/projeler" class="group inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-ink border-b border-brand-ink pb-1 py-2 hover:text-brand-stamp hover:border-brand-stamp transition-colors w-fit">
            Tüm projeler <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </header>

        <ul class="border-t border-line">
          {featuredProjects.map((project, i) => (
            <li class="border-b border-line">
              <a href={`/projeler/${project.slug}`} class="group grid grid-cols-12 items-center gap-x-4 sm:gap-x-6 gap-y-3 py-6 sm:py-7 transition-colors duration-300 hover:bg-brand-paper/70 -mx-3 px-3">
                <span class="col-span-2 sm:col-span-1 font-display font-black text-2xl sm:text-3xl text-brand-walnut/35 leading-none tracking-tightest group-hover:text-brand-walnut transition-colors duration-300">
                  {String(i + 1).padStart(2, '0')}
                </span>

                {project.data.coverImage ? (
                  <span class="hidden sm:block sm:col-span-2 overflow-hidden bg-surface-muted aspect-[16/10]">
                    <img
                      src={project.data.coverImage}
                      alt=""
                      loading="lazy"
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                    />
                  </span>
                ) : (
                  <span class="hidden sm:block sm:col-span-2"></span>
                )}

                <span class="col-span-10 sm:col-span-5">
                  <span class="block font-display font-bold text-xl sm:text-2xl text-brand-ink leading-tight tracking-tight group-hover:text-brand-stamp transition-colors duration-300">
                    {project.data.title_tr}
                  </span>
                  <span class="mt-1.5 text-sm text-ink-muted leading-snug line-clamp-2">
                    {project.data.summary_tr}
                  </span>
                </span>

                <span class="col-span-8 sm:col-span-3 text-xs sm:text-sm text-ink-soft leading-snug">
                  <span class="block font-medium text-brand-ink">{project.data.location}</span>
                  <span class="block text-ink-muted mt-0.5">
                    {project.data.startDate}{project.data.endDate ? ` – ${project.data.endDate}` : ''}
                  </span>
                </span>

                <span class="col-span-4 sm:col-span-1 flex items-center justify-end gap-3">
                  <span class={`hidden lg:inline-block text-[10px] font-semibold uppercase tracking-[0.14em] px-2 py-1 border ${project.data.status === 'Aktif' ? 'border-brand-stamp text-brand-stamp' : 'border-line-strong text-ink-muted'}`}>
                    {project.data.status === 'Aktif' ? 'Açık' : 'Arşiv'}
                  </span>
                  <span class="text-brand-walnut text-lg transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ HİKAYELER — tam kanayan yatay şerit ============ -->
  {featuredStories.length > 0 && (
    <section class="py-20 sm:py-28 bg-brand-paper overflow-hidden">
      <div class="container mx-auto px-4">
        <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12 reveal">
          <div class="max-w-2xl">
            <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">Gönüllüler</p>
            <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
              Sınırları aşan <span class="italic text-brand-walnut" style="font-variation-settings: 'opsz' 96, 'SOFT' 100;">yolculuklar.</span>
            </h2>
          </div>
          <a href="/gonullu-hikayeleri" class="group inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-ink border-b border-brand-ink pb-1 py-2 hover:text-brand-stamp hover:border-brand-stamp transition-colors w-fit">
            Tüm hikayeler <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </header>
      </div>

      <div class="story-rail flex gap-5 overflow-x-auto pb-4 px-4 sm:pl-[max(1rem,calc((100vw-1280px)/2+1rem))]">
        {featuredStories.map(story => (
          <a href={`/gonullu-hikayeleri/${story.slug}`} class="group shrink-0 w-[62vw] sm:w-64 snap-start">
            <div class="relative aspect-[3/4] overflow-hidden bg-surface-muted card">
              {story.data.images[0] ? (
                <img
                  src={story.data.images[0]}
                  alt={story.data.name}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <span class="absolute inset-0 flex items-center justify-center bg-brand-walnut text-brand-cream font-display text-4xl font-black">
                  {story.data.name.split(' ').map(n => n[0]).join('').toUpperCase()}
                </span>
              )}
              <span class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-black/70 to-transparent"></span>
              <span class="absolute bottom-0 left-0 right-0 p-4">
                <span class="block text-[10px] uppercase tracking-[0.2em] text-white/80 font-semibold">{story.data.country}</span>
                <span class="mt-1 block font-display font-bold text-lg text-white leading-tight">{story.data.name}</span>
              </span>
            </div>
          </a>
        ))}
        <span class="shrink-0 w-4" aria-hidden="true"></span>
      </div>
    </section>
  )}

  <!-- ============ ETKİNLİKLER — ajanda ============ -->
  {homeEvents.length > 0 && (
    <section class="py-20 sm:py-28 bg-brand-cream border-y border-line">
      <div class="container mx-auto px-4">
        <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12 reveal">
          <div class="max-w-2xl">
            <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">Takvim</p>
            <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
              {showingUpcoming ? 'Yaklaşan etkinlikler.' : 'Etkinliklerimizden.'}
            </h2>
          </div>
          <a href="/etkinlikler" class="group inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-ink border-b border-brand-ink pb-1 py-2 hover:text-brand-stamp hover:border-brand-stamp transition-colors w-fit">
            Tüm etkinlikler <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </header>

        <ul class="grid md:grid-cols-2 md:gap-x-14 border-t border-line">
          {homeEvents.map(event => {
            const { day, month } = dateParts(event.data.date);
            return (
              <li class="border-b border-line">
                <a href={`/etkinlikler/${event.slug}`} class="group flex items-start gap-5 py-6 transition-colors duration-300 hover:bg-brand-paper/70 -mx-3 px-3">
                  <span class="shrink-0 w-14 text-center pt-0.5">
                    <span class="block font-display font-black text-2xl text-brand-ink leading-none tracking-tightest">{day}</span>
                    <span class="mt-1 block text-[10px] font-semibold uppercase tracking-[0.14em] text-brand-stamp">{month}</span>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-display font-bold text-lg sm:text-xl text-brand-ink leading-snug tracking-tight group-hover:text-brand-stamp transition-colors duration-300">
                      {event.data.title_tr}
                    </span>
                    <span class="mt-1.5 block text-sm text-ink-muted leading-snug">
                      {event.data.time ? `${event.data.time} · ` : ''}{event.data.location}
                    </span>
                  </span>
                  <span class="shrink-0 text-brand-walnut text-lg pt-1 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ HABERLER — 1 büyük + 2 küçük ============ -->
  {leadNews && (
    <section class="py-20 sm:py-28 bg-brand-paper">
      <div class="container mx-auto px-4">
        <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12 reveal">
          <div class="max-w-2xl">
            <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">Haberler</p>
            <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
              Son gelişmeler.
            </h2>
          </div>
          <a href="/haberler" class="group inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-ink border-b border-brand-ink pb-1 py-2 hover:text-brand-stamp hover:border-brand-stamp transition-colors w-fit">
            Tüm haberler <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </a>
        </header>

        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
          <a href={`/haberler/${leadNews.slug}`} class="group lg:col-span-7 block">
            {leadNews.data.coverImage && (
              <div class="relative aspect-[16/10] overflow-hidden bg-surface-muted card mb-6">
                <img
                  src={leadNews.data.coverImage}
                  alt={leadNews.data.title_tr}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                />
              </div>
            )}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-3">
              <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-brand-stamp">
                {formatEventDate(leadNews.data.date)}
              </span>
              {leadNews.data.category && (
                <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-muted border border-line-strong px-1.5 py-0.5">
                  {leadNews.data.category}
                </span>
              )}
            </div>
            <h3 class="font-display font-bold text-2xl sm:text-3xl text-brand-ink leading-tight tracking-tight group-hover:text-brand-stamp transition-colors duration-300">
              {leadNews.data.title_tr}
            </h3>
            <p class="mt-3 text-ink-soft leading-relaxed line-clamp-2 max-w-xl">{leadNews.data.summary_tr}</p>
          </a>

          <ul class="lg:col-span-5 border-t border-line">
            {restNews.map(item => (
              <li class="border-b border-line">
                <a href={`/haberler/${item.slug}`} class="group flex gap-4 py-5 transition-colors duration-300 hover:bg-brand-cream/70 -mx-3 px-3">
                  {item.data.coverImage && (
                    <span class="shrink-0 w-24 sm:w-28 aspect-[4/3] overflow-hidden bg-surface-muted">
                      <img src={item.data.coverImage} alt="" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    </span>
                  )}
                  <span class="min-w-0">
                    <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-brand-stamp mb-1.5">
                      {formatEventDate(item.data.date)}
                    </span>
                    <span class="font-display font-bold text-base sm:text-lg text-brand-ink leading-snug tracking-tight line-clamp-3 group-hover:text-brand-stamp transition-colors duration-300">
                      {item.data.title_tr}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- ============ DUYURULAR — ince şerit ============ -->
  {recentPosts.length > 0 && (
    <section class="bg-brand-cream border-y border-line">
      <div class="container mx-auto px-4 py-10 sm:py-12">
        <div class="flex items-center gap-4 mb-6">
          <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-brand-stamp whitespace-nowrap">Duyurular</p>
