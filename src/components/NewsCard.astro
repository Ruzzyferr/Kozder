---
import CardMedia from './CardMedia.astro';
import { formatEventDate } from '../utils/date';

interface Props {
  title: string;
  date: string;
  location?: string;
  category?: string;
  coverImage?: string;
  coverFit?: 'cover' | 'contain';
  summary?: string;
  slug: string;
}

const { title, date, location, category, coverImage, coverFit = 'cover', summary, slug } = Astro.props;
const formattedDate = formatEventDate(date);
---

<a href={`/haberler/${slug}`} class="group block h-full">
  <article class="card card-hover h-full bg-brand-cream flex flex-col">
    <CardMedia src={coverImage} alt={title} fit={coverFit} ratio="aspect-[3/2]" />

    <div class="p-5 sm:p-6 flex-1 flex flex-col">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 mb-3">
        <time datetime={date} class="text-[10px] font-semibold uppercase tracking-[0.18em] text-brand-stamp">
          {formattedDate}
        </time>
        {category && (
          <span class="text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-muted border border-line-strong px-1.5 py-0.5">
            {category}
          </span>
        )}
      </div>

      <h3 class="font-display font-bold text-xl sm:text-[1.4rem] text-brand-ink leading-[1.12] tracking-tight line-clamp-2 group-hover:text-brand-stamp transition-colors duration-300">
        {title}
      </h3>

      {summary && <p class="mt-3 text-sm text-ink-soft leading-relaxed line-clamp-3">{summary}</p>}

      {location && (
        <p class="mt-auto pt-5 text-sm text-ink-muted leading-snug border-t border-line">
          {location}
        </p>
      )}
    </div>
  </article>
</a>
