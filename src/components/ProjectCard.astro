---
import { getLangFromUrl, entryPath, stripLangPrefix, useTranslations, type Lang } from '../i18n';
import CardMedia from './CardMedia.astro';
import { isProjectApplicationOpen } from '../utils/projectApplications';

interface Props {
  title: string;
  summary: string;
  coverImage?: string;
  coverFit?: 'cover' | 'contain';
  programType: 'ESC' | 'ERASMUS';
  year: number;
  status: 'Aktif' | 'Tamamlandı';
  startDate: string;
  endDate?: string;
  location?: string;
  applicationDeadline?: string;
  slug: string;
  lang?: Lang;
}

const { title, summary, coverImage, coverFit = 'cover', programType, year, status, startDate, endDate, location, applicationDeadline, slug, lang: langProp } = Astro.props;
const lang: Lang = langProp ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isActive = isProjectApplicationOpen({ status, startDate, applicationDeadline });
---

<a href={entryPath(lang, 'projects', stripLangPrefix(slug))} class="group block h-full">
  <article data-project-card class="card card-hover h-full bg-brand-cream flex flex-col">
    <CardMedia src={coverImage} alt={title} fit={coverFit} ratio="aspect-[4/3]">
      <span class="absolute top-3 left-3 bg-brand-ink/90 backdrop-blur-sm text-brand-cream text-sm font-semibold uppercase tracking-[0.16em] px-2.5 py-1.5">
        {programType}
      </span>
      {status === 'Aktif' && (
        <span data-project-open-badge class={`absolute top-3 right-3 flex items-center gap-1.5 bg-brand-stamp text-brand-cream text-sm font-semibold uppercase tracking-[0.16em] px-2.5 py-1.5 ${isActive ? '' : 'hidden'}`}>
          <span class="w-1.5 h-1.5 rounded-full bg-brand-cream"></span>
          {t('common.open')}
        </span>
      )}
    </CardMedia>

    <div class="p-5 sm:p-6 flex-1 flex flex-col">
      <p data-project-status-label data-open-label={t('projects.applyOpen')} data-closed-label={t('projects.applicationClosed')} class="text-sm font-semibold uppercase tracking-[0.2em] text-ink-muted mb-3">
        {year} · {isActive ? t('projects.applyOpen') : t('projects.applicationClosed')}
      </p>

      <h3 class="font-display font-bold text-xl sm:text-[1.4rem] text-brand-ink leading-[1.12] tracking-tight line-clamp-2 group-hover:text-brand-stamp transition-colors duration-300">
        {title}
      </h3>

      <dl class="mt-4 space-y-2 text-sm text-ink-soft">
        {location && <div><dt class="sr-only">{lang === 'en' ? 'Location' : 'Yer'}</dt><dd class="font-semibold text-brand-ink">{location}</dd></div>}
        <div><dt class="font-semibold">{lang === 'en' ? 'Activity dates' : 'Faaliyet tarihi'}</dt><dd>{startDate}{endDate ? ` – ${endDate}` : ''}</dd></div>
        {applicationDeadline && <div><dt class="font-semibold">{lang === 'en' ? 'Application deadline' : 'Son başvuru'}</dt><dd>{applicationDeadline.split('-').reverse().join('.')}</dd></div>}
      </dl>
      <p class="mt-3 text-base text-ink-soft leading-relaxed line-clamp-3 flex-1">{summary}</p>

      <span class="mt-6 pt-4 border-t border-line flex items-center justify-between text-sm font-semibold uppercase tracking-[0.16em] text-brand-walnut">
        {t('common.details')}

      </span>
    </div>
  </article>
</a>
