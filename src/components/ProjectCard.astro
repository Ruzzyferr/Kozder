---
interface Props {
  title: string;
  summary: string;
  coverImage: string;
  programType: 'ESC' | 'ERASMUS';
  year: number;
  status: 'Aktif' | 'Tamamlandı';
  slug: string;
}

const { title, summary, coverImage, programType, year, status, slug } = Astro.props;
const isActive = status === 'Aktif';
---

<a href={`/projeler/${slug}`} class="block group h-full">
  <article class="relative h-full bg-brand-cream transition-all duration-300 hover:-translate-y-1 hover:translate-x-0.5 flex flex-col card">
    {coverImage && (
      <div class="relative aspect-[7/5] bg-surface-muted overflow-hidden border-b border-line">
        <img
          src={coverImage}
          alt={title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />

        <div class="absolute top-3 left-3">
          <span class="bg-brand-ink text-brand-cream text-[11px] font-bold uppercase tracking-[0.15em] px-2.5 py-1.5 border border-brand-ink">
            {programType}
          </span>
        </div>

        <div class="absolute top-3 right-3">
          {isActive ? (
            <div class="bg-brand-stamp text-brand-cream text-[11px] font-bold uppercase tracking-[0.15em] px-2.5 py-1.5 border border-brand-ink flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-brand-cream animate-pulse"></span>
              Aktif
            </div>
          ) : (
            <div class="bg-brand-cream text-brand-ink text-[11px] font-bold uppercase tracking-[0.15em] px-2.5 py-1.5 border border-brand-ink">
              Arşiv
            </div>
          )}
        </div>
      </div>
    )}

    <div class="p-5 sm:p-6 flex-1 flex flex-col">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-walnut mb-3">{year}</p>
      <h3 class="font-display font-bold text-xl sm:text-2xl text-brand-ink mb-3 group-hover:text-brand-stamp transition-colors leading-[1.1] tracking-tight line-clamp-2">
        {title}
      </h3>
      <p class="text-sm text-ink-soft line-clamp-3 leading-relaxed mb-4 flex-1">
        {summary}
      </p>
      <div class="pt-4 border-t border-brand-ink/15 flex items-center justify-between mt-auto">
        <span class="text-sm font-bold uppercase tracking-wider text-brand-walnut group-hover:text-brand-stamp transition-colors">Detayları gör</span>
        <span class="text-brand-walnut group-hover:text-brand-stamp group-hover:translate-x-1 transition-all">→</span>
      </div>
    </div>
  </article>
</a>
