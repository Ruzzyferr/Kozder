---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/', text: 'Ana Sayfa' },
  { href: '/hakkimizda', text: 'Hakkımızda' },
  { href: '/projeler', text: 'Projeler' },
  { href: '/gonullu-hikayeleri', text: 'Hikayeler' },
  { href: '/etkinlikler', text: 'Etkinlikler' },
  { href: '/haberler', text: 'Haberler' },
  { href: '/duyurular', text: 'Duyurular' },
  { href: '/sss', text: 'SSS' },
  { href: '/iletisim', text: 'İletişim' },
];

function isActive(href: string) {
  return href === '/' ? currentPath === '/' : currentPath.startsWith(href);
}
---

<header
  id="main-header"
  class="bg-brand-paper/95 backdrop-blur-sm border-b border-line sticky top-0 z-50 transition-shadow duration-300"
>
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16 md:h-20 gap-4">
      <a href="/" class="flex items-center gap-3 group flex-shrink-0" aria-label="KOZ-DER ana sayfa">
        <img
          src="/images/logo.png"
          alt=""
          width="48"
          height="48"
          class="h-10 md:h-12 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        />
        <div class="leading-none">
          <div class="font-display font-black text-xl sm:text-2xl md:text-3xl text-brand-ink tracking-tightest -mt-0.5 group-hover:text-brand-stamp transition-colors">
            KOZ<span class="text-brand-stamp">·</span>DER
          </div>
          <!-- Uzun alt başlık + 9 menü maddesi ancak 2xl'de yan yana sığıyor;
               daha darda taşma yapıp sayfayı yatay kaydırıyordu. -->
          <div class="hidden 2xl:block text-[11px] uppercase tracking-[0.2em] text-brand-walnut font-semibold mt-1">
            Gençlik Zeka Oyunları ve Kodlama Derneği
          </div>
        </div>
      </a>

      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Birincil navigasyon">
        {navItems.map(item => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`relative whitespace-nowrap px-2 xl:px-2.5 py-2 font-heading text-[11px] xl:text-xs font-semibold uppercase tracking-[0.07em] transition-colors duration-200
                ${active ? 'text-brand-stamp' : 'text-brand-ink hover:text-brand-stamp'}`}
            >
              {item.text}
              {active && (
                <span class="absolute left-2 right-2 xl:left-2.5 xl:right-2.5 -bottom-1 h-px bg-brand-stamp"></span>
              )}
            </a>
          );
        })}

        <a
          href="/iletisim"
          class="ml-3 hidden xl:inline-flex whitespace-nowrap items-center gap-2 bg-brand-ink hover:bg-brand-stamp text-brand-cream px-4 py-2.5 text-[11px] font-semibold uppercase tracking-[0.1em] font-heading transition-colors duration-300"
        >
          Bize Yaz
          <span>→</span>
        </a>
      </nav>

      <button
        id="mobile-menu-btn"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 border border-brand-ink bg-brand-cream text-brand-ink hover:bg-brand-walnut hover:text-brand-cream transition-colors"
        aria-label="Menüyü aç"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-menu" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2.5" d="M6 6l12 12M6 18L18 6" />
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="lg:hidden grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out border-t border-line bg-brand-cream"
  >
    <div class="overflow-hidden">
      <nav class="container mx-auto px-4 py-5 flex flex-col" aria-label="Mobil navigasyon">
        {navItems.map(item => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class={`flex items-center justify-between px-2 py-3.5 font-heading text-sm font-bold uppercase tracking-wider border-b border-brand-ink/15 transition-colors
                ${active ? 'text-brand-stamp' : 'text-brand-ink hover:text-brand-stamp'}`}
            >
              {item.text}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          );
        })}
        <a
          href="/iletisim"
          class="mt-5 inline-flex items-center justify-center gap-2 bg-brand-ink text-brand-cream px-4 py-3.5 text-sm font-bold uppercase tracking-[0.15em] font-heading transition-colors hover:bg-brand-stamp"
        >
          Bize Yaz <span>→</span>
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('main-header');
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  let isOpen = false;

  function setOpen(open: boolean) {
    if (!menu || !btn) return;
    isOpen = open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Menüyü kapat' : 'Menüyü aç');
    menu.style.gridTemplateRows = open ? '1fr' : '0fr';
    iconMenu?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.style.overflow = open ? 'hidden' : '';
  }

  btn?.addEventListener('click', () => setOpen(!isOpen));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      setOpen(false);
      btn?.focus();
    }
  });

  let resizeTimer: number | undefined;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      if (window.innerWidth >= 1024 && isOpen) setOpen(false);
    }, 100);
  });

  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    if (y > 8 && lastScroll <= 8) header?.classList.add('shadow-card');
    if (y <= 8 && lastScroll > 8) header?.classList.remove('shadow-card');
    lastScroll = y;
  }, { passive: true });
</script>
