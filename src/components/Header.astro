---
import { getLangFromUrl, useTranslations, path, alternatePath, type Lang } from '../i18n';

interface Props { lang?: Lang; alternate?: string }
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: path(lang, 'home'), text: t('nav.home') },
  { href: path(lang, 'projects'), text: t('nav.projects') },
  { href: path(lang, 'stories'), text: t('nav.stories') },
  { href: path(lang, 'events'), text: t('nav.events') },
  { href: path(lang, 'news'), text: t('nav.news') },
  { href: path(lang, 'about'), text: t('nav.about') },
  { href: path(lang, 'posts'), text: t('nav.posts') },
  { href: path(lang, 'membership'), text: t('nav.membership') },
  { href: path(lang, 'faq'), text: t('nav.faq') },
  { href: path(lang, 'contact'), text: t('nav.contact') },
];
const home = path(lang, 'home');
const contact = path(lang, 'contact');
const other: Lang = lang === 'tr' ? 'en' : 'tr';
/** Dil düğmesi mümkünse aynı sayfanın karşılığına gider, yoksa ana sayfaya. */
const otherHref = Astro.props.alternate ?? path(other, 'home');

function isActive(href: string) {
  if (href === '/' || href === '/en/') return currentPath === href;
  return currentPath.startsWith(href);
}
---
<div class="koz-glass" id="koz-header" data-lang={lang}>
  <header class="top" style="display:block;padding:0">
    <div class="wrap">
      <div class="topbar">
        <a href={home} class="brand" aria-label={t('nav.home.aria')}>
          <img src="/images/logo.png" alt="KOZ-DER" width="86" height="86" />
          <div><strong>KOZ<span>·</span>DER</strong><small>{t('site.orgName')}</small></div>
        </a>
        <div class="header-actions">
          <button type="button" class="mobile-menu-toggle" aria-label={t('nav.open')} aria-expanded="false" aria-controls="koz-navigation">⋯</button>
          <a class="lang" href={otherHref} hreflang={other} aria-label={t('nav.langSwitch')}>{other.toUpperCase()}</a>
          <a class="contact" href={contact}>{t('nav.cta')}</a>
        </div>
      </div>
      <nav id="koz-navigation" aria-label={t('nav.primary')}>
        {navItems.map(item => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.text}</a>)}
      </nav>
    </div>
  </header>
</div>
<script>
 const root=document.getElementById('koz-header');
 const toggle=root?.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
 const menu=root?.querySelector<HTMLElement>('#koz-navigation');
 const mq=matchMedia('(max-width:760px)');
 let open=false;
 function setOpen(value:boolean){open=value;if(!toggle||!menu)return;menu.classList.toggle('is-open',value);menu.inert=mq.matches&&!value;toggle.setAttribute('aria-expanded',String(value));toggle.textContent=value?'×':'⋯';toggle.setAttribute('aria-label',root?.dataset.lang==='en'?(value?'Close menu':'Open menu'):(value?'Menüyü kapat':'Menüyü aç'));}
 toggle?.addEventListener('click',()=>setOpen(!open));
 menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>setOpen(false)));
 document.addEventListener('keydown',event=>{if(event.key==='Escape'&&open){setOpen(false);toggle?.focus();}});
 mq.addEventListener('change',()=>setOpen(false));setOpen(false);
</script>
