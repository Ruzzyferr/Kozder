      </div>
    </section>

    <!-- KAPANIŞ -->
    <section class="ag-wrap ag-sec">
      <div class="ag-end">
        <div class="ag-end-crew">{crew.slice(3, 8).map((l, i) => <span class="ag-bob" style={`animation-delay:${i * .2}s`} set:html={person(l, 58)} />)}</div>
