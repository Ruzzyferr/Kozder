        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-guide]');
  if (root) {
    // Program sekmeleri
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const select = (btn: HTMLButtonElement) => {
      tabs.forEach(b => {
        const on = b === btn;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(b.getAttribute('aria-controls') || '');
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
      b.addEventListener('click', () => select(b));
      b.addEventListener('keydown', e => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(n); n.focus();
      });
    });
    // Kaydırınca belirme ve ok çizimi
    const els = root.querySelectorAll<HTMLElement>('[data-reveal]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => entries.forEach(en => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } }), { threshold: 0.2 });
      els.forEach(el => io.observe(el));
    } else els.forEach(el => el.classList.add('in'));
    // Hareket azaltma tercihinde yürüyen gönüllüyü durdur
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.querySelectorAll('animateMotion').forEach(a => a.remove());
      root.querySelector('.ag-traveler')?.setAttribute('transform', 'translate(430 82)');
    }
  }
</script>

