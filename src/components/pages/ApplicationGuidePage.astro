---
import { useTranslations, path, alternatePath, type Lang } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const en = lang === 'en';
const c = (tr: string, enText: string) => (en ? enText : tr);

const title = c('Başvuru Rehberi', 'Application Guide');
const intro = c(
  'Yurt dışı projelerine nasıl başvurulur, katılımcıları nasıl seçiyoruz, masrafları kim karşılıyor? Kilis’ten Avrupa’ya uzanan yolculuğun her adımı bu sayfada.',
  'How do you apply for a project abroad, how do we select participants and who covers the costs? Every step of the journey from Kilis to Europe is on this page.',
);
const stars = Array.from({ length: 12 }, (_, i) => { const a = (i / 12) * Math.PI * 2; return `translate(${(430 + Math.cos(a) * 38).toFixed(1)} ${(80 + Math.sin(a) * 38).toFixed(1)}) scale(.9)`; });
const WHATSAPP = 'https://whatsapp.com/channel/0029Va6oBxc4NVis1wo8hl2N';

/* ---------- Temsili gönüllü çizimleri (özgün, basit SVG) ---------- */
type Look = { skin: string; hair: string; top: string; style: 'short' | 'long' | 'curly' | 'scarf' | 'bun'; glasses?: boolean; bag?: boolean };
function person(l: Look, size = 96): string {
  const hair = {
    short: `<path d="M30 34c0-14 10-22 22-22s22 8 22 22c-4-6-12-9-22-9s-18 3-22 9z" fill="${l.hair}"/>`,
    long: `<path d="M28 40c0-18 10-28 24-28s24 10 24 28v30c-4 4-8 4-10 0V44H38v26c-2 4-6 4-10 0z" fill="${l.hair}"/>`,
    curly: `<g fill="${l.hair}"><circle cx="34" cy="28" r="9"/><circle cx="46" cy="20" r="10"/><circle cx="60" cy="21" r="10"/><circle cx="70" cy="30" r="9"/><circle cx="30" cy="40" r="7"/><circle cx="74" cy="41" r="7"/></g>`,
    scarf: `<path d="M26 44c0-20 11-32 26-32s26 12 26 32v34H26z" fill="${l.hair}"/>`,
    bun: `<g fill="${l.hair}"><circle cx="52" cy="12" r="8"/><path d="M30 36c0-14 10-22 22-22s22 8 22 22c-4-6-12-9-22-9s-18 3-22 9z"/></g>`,
  }[l.style];
  const glasses = l.glasses ? `<g fill="none" stroke="#14213d" stroke-width="2.4"><circle cx="44" cy="44" r="6"/><circle cx="60" cy="44" r="6"/><path d="M50 44h4"/></g>` : '';
  const bag = l.bag ? `<path d="M30 74 70 108" stroke="#14213d" stroke-width="4" stroke-linecap="round"/><rect x="62" y="98" width="18" height="16" rx="4" fill="#14213d"/>` : '';
  const back = l.style === 'long' || l.style === 'scarf' ? hair : '';
  const front = l.style === 'long' || l.style === 'scarf' ? '' : hair;
  return `<svg viewBox="0 0 104 124" width="${size}" height="${Math.round(size * 1.19)}" aria-hidden="true">${back}<path d="M18 124c0-24 15-40 34-40s34 16 34 40z" fill="${l.top}"/><rect x="45" y="70" width="14" height="16" rx="6" fill="${l.skin}"/><circle cx="52" cy="46" r="22" fill="${l.skin}"/>${front}<circle cx="44" cy="46" r="2.4" fill="#14213d"/><circle cx="60" cy="46" r="2.4" fill="#14213d"/><path d="M45 55q7 6 14 0" stroke="#14213d" stroke-width="2.4" fill="none" stroke-linecap="round"/><circle cx="38" cy="53" r="3.5" fill="#f9a8b8" opacity=".55"/><circle cx="66" cy="53" r="3.5" fill="#f9a8b8" opacity=".55"/>${glasses}${bag}</svg>`;
}
const crew: Look[] = [
  { skin: '#f2c9a0', hair: '#3b2416', top: '#f08a24', style: 'curly', bag: true },
  { skin: '#e8b48a', hair: '#6d28d9', top: '#0f766e', style: 'scarf' },
  { skin: '#c98d5e', hair: '#1b1b1b', top: '#1d4ed8', style: 'short', glasses: true },
  { skin: '#f6d2b4', hair: '#7a4a1e', top: '#be123c', style: 'long' },
  { skin: '#dba277', hair: '#2b1a10', top: '#ffc93c', style: 'bun', bag: true },
  { skin: '#b9784f', hair: '#111', top: '#5eead4', style: 'short' },
  { skin: '#f0c7a5', hair: '#4a2c1a', top: '#c4b5fd', style: 'long', glasses: true },
  { skin: '#e4ad83', hair: '#0f766e', top: '#f08a24', style: 'scarf', bag: true },
];

/* ---------- Program kartları ---------- */
const programs = en ? [
  { key: 'yx', color: '#1d4ed8', name: 'Erasmus+ Youth Exchange', time: '5–21 days', age: '13–30 (group leaders 18+)', what: 'Young people from several countries meet around a theme: workshops, games, intercultural evenings and a Youthpass certificate at the end.', who: 'Ideal for a first experience abroad.' },
  { key: 'tc', color: '#6d28d9', name: 'Erasmus+ Training Course', time: '5–10 days', age: '18+ (youth workers, volunteers)', what: 'Trainings for people working with young people: non-formal education methods, project writing, inclusion, digital skills.', who: 'For those active in our clubs and activities.' },
  { key: 'esc', color: '#0f766e', name: 'European Solidarity Corps (ESC)', time: '2 weeks – 12 months', age: '18–30', what: 'Volunteering in an organisation abroad: travel, accommodation, food, insurance and pocket money are covered by the programme.', who: 'A Youth Portal (PRN) registration is required.' },
] : [
  { key: 'yx', color: '#1d4ed8', name: 'Erasmus+ Gençlik Değişimi', time: '5–21 gün', age: '13–30 (grup lideri 18+)', what: 'Farklı ülkelerden gençler bir tema etrafında buluşur: atölyeler, oyunlar, kültürlerarası geceler ve sonunda Youthpass sertifikası.', who: 'Yurt dışında ilk deneyim için ideal.' },
  { key: 'tc', color: '#6d28d9', name: 'Erasmus+ Eğitim Kursu', time: '5–10 gün', age: '18+ (gençlik çalışanları, gönüllüler)', what: 'Gençlerle çalışanlara yönelik eğitimler: yaygın eğitim yöntemleri, proje yazma, kapsayıcılık, dijital beceriler.', who: 'Kulüplerimizde ve etkinliklerimizde aktif olanlar için.' },
  { key: 'esc', color: '#0f766e', name: 'Avrupa Dayanışma Programı (ESC)', time: '2 hafta – 12 ay', age: '18–30', what: 'Yurt dışındaki bir kurumda gönüllülük: yol, konaklama, yemek, sigorta ve cep harçlığı programdan karşılanır.', who: 'Youth Portal (PRN) kaydı gerekir.' },
];

/* ---------- Yolculuk adımları ---------- */
const steps = en ? [
  ['Follow the calls', 'New opportunities are announced first on our WhatsApp channel and Instagram (@kozder2018). Each call has an info pack with dates, country, age and deadline.'],
  ['Fill in the form', 'Apply through the Erasmus+ or ESC application form linked on the project page. It takes about 10–15 minutes.'],
  ['Pre-evaluation', 'After the deadline, our team reads every application. Your answers about motivation and contribution matter most.'],
  ['Online interview', 'Shortlisted candidates are invited to a short online interview (Google Meet). We talk in Turkish and English, nothing to be afraid of!'],
  ['Results', 'We announce main and reserve participants by email or phone. If a main participant cannot go, the next reserve takes the place.'],
  ['Agreement and preparation', 'You sign the participation agreement and privacy consent, join the preparation meeting and plan tickets with us. Visa support if needed.'],
  ['The journey', 'Take part fully in the programme, make friends from all over Europe and receive your Youthpass certificate at the end.'],
  ['Back home, share it', 'Hand in your tickets and boarding passes, share your experience on social media and write your story for our website.'],
] : [
  ['Çağrıları takip et', 'Yeni fırsatlar önce WhatsApp kanalımızda ve Instagram’da (@kozder2018) duyurulur. Her çağrının tarih, ülke, yaş ve son başvuru tarihini içeren bir bilgi paketi vardır.'],
  ['Formu doldur', 'Proje sayfasındaki Erasmus+ veya ESC başvuru formuyla başvurursun. Yaklaşık 10–15 dakika sürer.'],
  ['Ön değerlendirme', 'Son başvuru tarihinden sonra ekibimiz her başvuruyu okur. En çok motivasyonuna ve katkı sorularına verdiğin cevaplara bakarız.'],
  ['Online görüşme', 'Ön elemeyi geçen adaylarla kısa bir online görüşme yaparız (Google Meet). Türkçe ve biraz İngilizce sohbet ederiz; korkulacak bir şey yok!'],
  ['Sonuç', 'Asil ve yedek katılımcıları e-posta ya da telefonla bildiririz. Asil katılımcı gidemezse sıradaki yedek onun yerine geçer.'],
  ['Sözleşme ve hazırlık', 'Katılım sözleşmesini ve KVKK iznini imzalar, hazırlık toplantısına katılır, biletleri birlikte planlarız. Gerekirse vize sürecinde destek oluruz.'],
  ['Yolculuk', 'Programa tam katılır, Avrupa’nın dört bir yanından arkadaşlar edinir, sonunda Youthpass sertifikanı alırsın.'],
  ['Dön ve paylaş', 'Bilet ve biniş kartlarını teslim eder, deneyimini sosyal medyada paylaşır ve web sitemiz için hikâyeni yazarsın.'],
];
const stepIcons = ['📣', '📝', '🔍', '💻', '🎉', '✍️', '✈️', '📸'];
const stepColors = ['#f08a24', '#1d4ed8', '#0f766e', '#6d28d9', '#be123c', '#d97706', '#0e8fb3', '#16a34a'];

/* ---------- Formda neler soruluyor ---------- */
const formGroups = en ? [
  { icon: '🪪', color: '#1d4ed8', title: 'About you', items: ['Name, email and phone number', 'Date of birth and the province you will travel from', 'Passport type (green or burgundy; important for visas)', 'Dietary preferences', 'An emergency contact (optional)'] },
  { icon: '💬', color: '#f08a24', title: 'Your motivation', items: ['Why do you want to join this project?', 'Why should we choose you?', 'Your previous Erasmus+ or ESC projects, if any (year, country, type)'] },
  { icon: '🤝', color: '#0f766e', title: 'Your contribution', items: ['How will you contribute to the association after you return?', 'What can you do to introduce our association and our country during the project?', 'Will you share posts before, during and after the project, tagging us and the host organisation?', 'Can you edit and send us content about what you did?'] },
  { icon: '🗣️', color: '#6d28d9', title: 'Your English', items: ['Self-assessment of speaking, writing, reading and listening'] },
  { icon: '📱', color: '#be123c', title: 'Social media tasks', items: ['Follow our accounts (linktr.ee/kozder)', 'Tag at least 5 friends under the call post on Instagram and upload a screenshot (checked if you are selected)'] },
  { icon: '🌍', color: '#d97706', title: 'Only for ESC', items: ['Your Youth Portal PRN number', 'Your CV'] },
] : [
  { icon: '🪪', color: '#1d4ed8', title: 'Seninle ilgili', items: ['Ad soyad, e-posta ve telefon', 'Doğum tarihi ve hangi ilden katılacağın', 'Pasaport türü (yeşil ya da bordo; vize açısından önemli)', 'Yemek tercihi', 'Acil durum kişisi (zorunlu değil)'] },
  { icon: '💬', color: '#f08a24', title: 'Motivasyonun', items: ['Bu projeye neden katılmak istiyorsun?', 'Neden seni seçelim?', 'Varsa daha önce katıldığın Erasmus+ ya da ESC projeleri (yıl, ülke, tür)'] },
  { icon: '🤝', color: '#0f766e', title: 'Katkın', items: ['Döndükten sonra derneğimize ne gibi katkılar sağlarsın?', 'Proje boyunca derneğimizi ve ülkemizi tanıtmak için neler yapabilirsin?', 'Öncesinde, sırasında ve sonrasında bizi ve ev sahibi kurumu etiketleyerek paylaşım yapar mısın?', 'Yaptıklarını editleyip bize gönderebilir misin?'] },
  { icon: '🗣️', color: '#6d28d9', title: 'İngilizcen', items: ['Konuşma, yazma, okuma ve dinleme seviyeni kendin değerlendirirsin'] },
  { icon: '📱', color: '#be123c', title: 'Sosyal medya görevleri', items: ['Hesaplarımızı takip etmek (linktr.ee/kozder)', 'Instagram’daki çağrı postunun altına en az 5 arkadaşını etiketleyip ekran görüntüsünü yüklemek (seçilirsen kontrol edilir)'] },
  { icon: '🌍', color: '#d97706', title: 'Sadece ESC için', items: ['Youth Portal PRN numaran', 'CV’n'] },
];

/* ---------- Seçim ölçütleri ---------- */
const criteria = en ? [
  ['💡', 'Motivation and answers', 'Sincere, thoughtful answers to “why do you want to join?” and “why should we choose you?” make the biggest difference.'],
  ['🗣️', 'English level', 'You don’t need perfect English, but you must be able to communicate. Higher levels have an advantage in training courses.'],
  ['🧩', 'Involvement with KOZ-DER', 'Taking part in our Speaking Clubs, events and volunteering, and completing the social media tasks, count in your favour.'],
  ['🎯', 'Fit with the project', 'The project’s theme, age range and target group: we look at whether this project is right for you and you for it.'],
  ['📍', 'Kilis and the region', 'Being from Kilis and the surrounding area is an advantage, but never a requirement: more than 200 of the participants we have sent so far were selected from cities far from Kilis.'],
  ['🌱', 'A fair chance for everyone', 'Those who have never been abroad get a chance; we keep a balance with those who have already participated.'],
  ['🛂', 'Passport and timing', 'In projects with little time before departure, the visa process matters; this is why we ask about your passport type.'],
  ['⚠️', 'Keeping your word', 'If you were selected before and withdrew without a valid reason, this is taken into account in later selections.'],
] : [
  ['💡', 'Motivasyon ve cevapların', '“Neden katılmak istiyorsun?” ve “Neden seni seçelim?” sorularına verdiğin samimi ve düşünülmüş cevaplar en büyük farkı yaratır.'],
  ['🗣️', 'İngilizce seviyesi', 'Kusursuz İngilizce gerekmez ama iletişim kurabilmelisin. Eğitim kurslarında daha yüksek seviye avantajlıdır.'],
  ['🧩', 'KOZ-DER’e katılımın', 'Speaking Club’larımıza, etkinliklerimize ve gönüllü çalışmalarımıza katılman, sosyal medya görevlerini yapman artı puandır.'],
  ['🎯', 'Projeye uygunluk', 'Projenin teması, yaş aralığı ve hedef kitlesi: bu proje sana, sen de bu projeye uygun musun, ona bakarız.'],
  ['📍', 'Kilis ve çevresi', 'Kilis ve çevresinden olmak bir avantajdır ama kesinlikle şart değildir: bugüne kadar gönderdiğimiz katılımcıların 200’den fazlası Kilis’e uzak şehirlerden seçildi.'],
  ['🌱', 'Herkese adil şans', 'Daha önce hiç yurt dışına çıkmamış gençlere de fırsat veririz; daha önce katılanlarla dengeyi gözetiriz.'],
  ['🛂', 'Pasaport ve zamanlama', 'Gidişe az süre kalan projelerde vize süreci belirleyici olabilir; pasaport türünü bu yüzden sorarız.'],
  ['⚠️', 'Sözünü tutmak', 'Daha önce seçilip geçerli bir mazeret olmadan vazgeçtiysen, bu durum sonraki seçimlerde dikkate alınır.'],
];

/* ---------- Masraflar ---------- */
const covered = en
  ? ['Travel, up to the programme’s limit', 'Accommodation and meals (food allowance in ESC)', 'Insurance', 'Visa fee (when included in the project budget)', 'ESC: pocket money']
  : ['Yol masrafı (programın belirlediği üst sınıra kadar)', 'Konaklama ve yemek (ESC’de yemek ücreti)', 'Sigorta', 'Vize ücreti (proje bütçesinde varsa)', 'ESC’de cep harçlığı'];
const yours = en
  ? ['Getting a passport', 'Personal spending', 'Costs not approved in advance', 'Keeping tickets, invoices and boarding passes: travel costs are reimbursed only with these documents']
  : ['Pasaport çıkarmak', 'Kişisel harcamaların', 'Önceden onaylanmamış giderler', 'Bilet, fatura ve biniş kartlarını saklamak: yol masrafı ancak bu belgelerle geri ödenir'];

/* ---------- Kısa sorular ---------- */
const faqs = en ? [
  ['Is it free?', 'Yes. There is no participation fee. The programme covers the main costs; you only need your passport and personal spending money.'],
  ['My English isn’t very good. Can I still apply?', 'Yes. For youth exchanges, basic communication is enough. To improve, join our free Speaking Clubs (Wednesdays online, Fridays in Kilis).'],
  ['I have joined a project before. Can I apply again?', 'Yes. We try to give priority to first-timers, but active members who have contributed to the association are always welcome.'],
  ['I don’t live in Kilis. Can I apply?', 'Of course. Being from Kilis and the region is only an advantage, not a condition; more than 200 of our participants so far came from cities far from Kilis.'],
  ['When will I hear back?', 'Usually within a few days after the deadline. Shortlisted candidates are invited to an online interview first.'],
  ['What if my visa is refused or I can’t go?', 'Let us know in writing as soon as possible. Valid reasons such as a visa refusal or illness are assessed with documents; a reserve takes your place.'],
  ['What happens to my personal data?', 'Your passport, ID and contact details are used only for that project and protected under our privacy notice. Photos are shared only with your separate consent.'],
] : [
  ['Ücretli mi?', 'Hayır, katılım ücreti yok. Temel masrafları program karşılar; senin yalnızca pasaportun ve kişisel harçlığın olmalı.'],
  ['İngilizcem çok iyi değil, yine de başvurabilir miyim?', 'Evet. Gençlik değişimlerinde temel düzeyde iletişim kurabilmek yeterli. Geliştirmek için ücretsiz Speaking Club’larımıza katılabilirsin (Çarşamba online, Cuma Kilis’te).'],
  ['Daha önce bir projeye katıldım, tekrar başvurabilir miyim?', 'Evet. İlk kez gideceklere öncelik vermeye çalışırız ama derneğe katkı sunan aktif üyelerimize her zaman yer vardır.'],
  ['Kilis’te yaşamıyorum, başvurabilir miyim?', 'Elbette. Kilis ve çevresinden olmak yalnızca bir avantaj, şart değil; bugüne kadarki katılımcılarımızın 200’den fazlası Kilis’e uzak şehirlerden seçildi.'],
  ['Sonuç ne zaman açıklanır?', 'Genellikle son başvuru tarihinden sonraki birkaç gün içinde. Önce ön elemeyi geçenleri online görüşmeye çağırırız.'],
  ['Vizem çıkmazsa ya da gidemezsem ne olur?', 'En kısa sürede yazılı olarak haber vermelisin. Vize reddi, hastalık gibi geçerli mazeretler belgesiyle değerlendirilir; yerine yedek aday geçer.'],
  ['Kişisel verilerime ne oluyor?', 'Pasaport, kimlik ve iletişim bilgilerin yalnızca o proje için kullanılır ve KVKK kapsamında korunur. Fotoğrafların ancak ayrı iznin varsa paylaşılır.'],
];
---

<BaseLayout lang={lang} title={`${title} — KOZ-DER`} description={intro} alternate={alternatePath(lang, 'guide')}>
  <Breadcrumb
    lang={lang}
    kicker={c('Yurt dışı fırsatları', 'Opportunities abroad')}
    items={[{ label: t('nav.home'), href: path(lang, 'home') }, { label: title, href: path(lang, 'guide') }]}
    pageTitle={title}
    intro={intro}
  />

  <div class="ag" data-guide>
    <!-- KAHRAMAN: Kilis’ten Avrupa’ya yol -->
    <section class="ag-wrap ag-hero">
      <div class="ag-hero-copy">
        <h2>{c('Kilis’ten Avrupa’ya, adım adım.', 'From Kilis to Europe, step by step.')}</h2>
        <p>{c('Her yıl yüzlerce genç bize başvuruyor ve aynı soruları soruyor: “Nasıl seçiyorsunuz?”, “Ne kadar tutuyor?”, “İngilizcem yeterli mi?” Cevapların hepsi burada.', 'Every year hundreds of young people apply and ask the same questions: “How do you select?”, “How much does it cost?”, “Is my English good enough?” All the answers are here.')}</p>
        <div class="ag-actions">
          <a class="ag-btn primary" href={path(lang, 'projects')}>{c('Açık çağrıları gör', 'See open calls')} <span aria-hidden="true">→</span></a>
          <a class="ag-btn" href="#yolculuk">{c('Yolculuğu incele', 'Explore the journey')} <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="ag-map" aria-hidden="true">
        <svg viewBox="0 0 520 360" class="ag-route">
          <defs>
            <linearGradient id="agRoad" x1="0" x2="1"><stop offset="0" stop-color="#f08a24"/><stop offset=".5" stop-color="#6d28d9"/><stop offset="1" stop-color="#1d4ed8"/></linearGradient>
          </defs>
          <circle cx="430" cy="80" r="58" fill="#1d4ed8" opacity=".1"/>
          {stars.map((st, i) => <path d="M0 -7 2 -2 7 -2 3 1 4.6 6.4 0 3.2 -4.6 6.4 -3 1 -7 -2 -2 -2z" transform={st} fill="#ffc93c" class="ag-star" style={`animation-delay:${i * .15}s`} />)}
          <path id="agPath" d="M70 300 C 150 300, 140 200, 230 210 S 330 260, 360 170 S 400 110, 430 82" fill="none" stroke="url(#agRoad)" stroke-width="6" stroke-linecap="round" stroke-dasharray="2 14" class="ag-dash"/>
          <g transform="translate(70 300)"><circle r="16" fill="#be123c"/><circle r="6" fill="#fff"/></g>
          <text x="40" y="340" class="ag-maplabel">Kilis</text>
          <text x="392" y="168" class="ag-maplabel">{c('Avrupa', 'Europe')}</text>
          <g class="ag-traveler">
            <g transform="translate(-22 -50) scale(.42)" set:html={person({ skin: '#f2c9a0', hair: '#3b2416', top: '#f08a24', style: 'curly', bag: true }, 104)} />
            <animateMotion dur="7s" repeatCount="indefinite" rotate="0" keyPoints="0;1" keyTimes="0;1" calcMode="linear"><mpath href="#agPath" /></animateMotion>
          </g>
        </svg>
        <div class="ag-crew">
          {crew.slice(0, 5).map((l, i) => <span class="ag-bob" style={`animation-delay:${i * .25}s`} set:html={person(l, 64)} />)}
        </div>
      </div>
    </section>

    <!-- HANGİ PROGRAM -->
    <section class="ag-wrap ag-sec">
      <h2>{c('Hangi program sana uygun?', 'Which programme suits you?')}</h2>
      <div class="ag-tabs" role="tablist" aria-label={c('Program türleri', 'Programme types')}>
        {programs.map((p, i) => <button type="button" role="tab" id={`tab-${p.key}`} aria-controls={`panel-${p.key}`} aria-selected={i === 0 ? 'true' : 'false'} style={`--c:${p.color}`} data-tab={p.key}>{p.name}</button>)}
      </div>
      {programs.map((p, i) => (
        <div class="ag-panel" role="tabpanel" id={`panel-${p.key}`} aria-labelledby={`tab-${p.key}`} hidden={i !== 0} style={`--c:${p.color}`}>
          <div class="ag-panel-art" set:html={person(crew[i * 2 + 1], 120)} />
          <div>
            <h3>{p.name}</h3>
            <dl>
              <div><dt>{c('Süre', 'Duration')}</dt><dd>{p.time}</dd></div>
              <div><dt>{c('Yaş', 'Age')}</dt><dd>{p.age}</dd></div>
            </dl>
            <p>{p.what}</p>
            <p class="ag-note">{p.who}</p>
          </div>
        </div>
      ))}
    </section>

    <!-- YOLCULUK -->
    <section class="ag-wrap ag-sec" id="yolculuk">
      <h2>{c('Başvurudan yolculuğa 8 adım', '8 steps from application to departure')}</h2>
