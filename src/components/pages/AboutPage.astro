---
import { useTranslations, usePage, path, alternatePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const p = usePage(lang);

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import teamData from '../../data/team.json';

interface TeamMember {
  name: string;
  role: string;
  bio: string;
  image?: string;
}

const values = p.about.values;
const roleLabel = (role: string) => p.about.roles[role] ?? role;
const bioText = (member: TeamMember) => p.about.bios[member.name] ?? member.bio;
const impactCopy = lang === 'en'
  ? {
      kicker: 'Our impact',
      heading: 'Young people learning, connecting and taking action.',
      intro: 'A few verified outcomes from recent activities. Each figure is labeled by programme and year.',
      metrics: [
        { value: '149', label: 'young people reached through training', source: '2025 · GSB youth resilience project' },
        { value: '99.2%', label: 'overall satisfaction', source: '2025 · 120 evaluation responses' },
        { value: '178', label: 'cultural trip attendances', source: '2025 · total attendances, not unique people' },
        { value: '25', label: 'youth exchange participants', source: '2026 · four countries' },
      ],
      note: 'The 2025 GSB figures and the 2026 Erasmus+ exchange refer to different activities. Trip attendances are not a count of unique participants.',
      voiceTitle: 'Young people’s voice',
      voiceText: 'Share an idea or suggestion with KOZ-DER. Your feedback helps shape future activities.',
      voiceCta: 'Share an idea on WhatsApp',
      privacy: 'This is a general feedback channel. Please do not send sensitive personal or safety information here.',
    }
  : {
      kicker: 'Etki göstergelerimiz',
      heading: 'Gençler öğreniyor, bağ kuruyor ve harekete geçiyor.',
      intro: 'Yakın dönem çalışmalarımızdan doğrulanmış sonuçlar. Her sayı program ve yılıyla birlikte veriliyor.',
      metrics: [
        { value: '149', label: 'eğitimlere katılan genç', source: '2025 · GSB gençlik projesi' },
        { value: '%99,2', label: 'genel memnuniyet', source: '2025 · 120 değerlendirme yanıtı' },
        { value: '178', label: 'kültürel gezi katılımı', source: '2025 · tekil kişi değil, toplam katılım' },
        { value: '25', label: 'gençlik değişimi katılımcısı', source: '2026 · dört ülkeden' },
      ],
      note: '2025 GSB sonuçları ile 2026 Erasmus+ gençlik değişimi farklı faaliyetlere aittir. Gezi sayısı tekil katılımcı sayısını değil, toplam katılımı gösterir.',
      voiceTitle: 'Gençlerin Sesi',
      voiceText: 'Bir fikir ya da önerini KOZ-DER ile paylaş. Görüşlerin gelecek faaliyetlerimizi şekillendirmemize yardımcı olur.',
      voiceCta: 'WhatsApp’tan fikir paylaş',
      privacy: 'Bu kanal genel öneriler içindir. Lütfen hassas kişisel veya güvenlik bilgilerini buradan göndermeyin.',
    };
---

<BaseLayout
  lang={lang}
  title={p.meta.about.title}
  description={p.meta.about.description}
  alternate={alternatePath(lang, 'about')}
>
  <Breadcrumb
    lang={lang}
    kicker={t('about.kicker')}
    items={[{ label: t('nav.home'), href: path(lang, 'home') }, { label: t('nav.about'), href: path(lang, 'about') }]}
    pageTitle={p.head.about.pageTitle}
    intro={p.head.about.intro}
  />

  <div class="container mx-auto px-4 py-12 sm:py-20">

    <section class="mb-16 sm:mb-24">
      <div class="mission-grid grid lg:grid-cols-2 gap-6">
        <article class="mission-card mission card card-hover p-7 sm:p-10">
          <h2 class="font-display font-black text-3xl sm:text-4xl text-brand-ink mb-4 leading-[0.95] tracking-tightest">{p.about.missionHeading}</h2>
          <p class="text-ink-soft leading-relaxed">{p.about.missionText}</p>
        </article>

        <article class="mission-card vision card card-hover p-7 sm:p-10">
          <h2 class="font-display font-black text-3xl sm:text-4xl text-brand-ink mb-4 leading-[0.95] tracking-tightest">{p.about.visionHeading}</h2>
          <p class="text-ink-soft leading-relaxed">{p.about.visionText}</p>
        </article>
      </div>
    </section>

    <section class="mb-16 sm:mb-24">
      <h2 class="font-display font-black text-4xl sm:text-5xl md:text-6xl tracking-tightest leading-none text-brand-ink mb-10">{p.about.valuesHeading}</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 card card-2 bg-brand-cream divide-y sm:divide-y-0 sm:divide-x divide-line">
        {values.map(v => (
          <div class="value-tile p-6 transition-colors">
            <p class="font-display font-black text-5xl text-brand-walnut leading-none mb-3 tracking-tightest">{v.n}</p>
            <h3 class="font-display font-bold text-xl text-brand-ink mb-2 tracking-tight">{v.title}</h3>
            <p class="text-sm text-ink-soft leading-relaxed">{v.text}</p>
          </div>
        ))}
      </div>
    </section>

    
    <section class="impact-block mb-16 sm:mb-24 rounded-[2rem] border border-white/70 bg-gradient-to-br from-white/90 via-white/70 to-blue-50/80 p-6 shadow-xl backdrop-blur-xl sm:p-10">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-brand-stamp">{impactCopy.kicker}</p>
      <h2 class="mb-4 max-w-4xl font-display text-3xl font-black leading-tight tracking-tightest text-brand-ink sm:text-4xl">{impactCopy.heading}</h2>
      <p class="mb-8 max-w-3xl leading-relaxed text-ink-soft">{impactCopy.intro}</p>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {impactCopy.metrics.map(metric => (
          <article class="impact-metric rounded-2xl border border-white/80 bg-white/75 p-5 shadow-md transition duration-200 hover:-translate-y-1 hover:shadow-xl">
            <strong class="block font-display text-4xl font-black tracking-tightest text-brand-walnut sm:text-5xl">{metric.value}</strong>
            <p class="mt-3 min-h-12 font-bold leading-snug text-brand-ink">{metric.label}</p>
            <p class="mt-3 border-t border-line pt-3 text-sm leading-relaxed text-ink-soft">{metric.source}</p>
          </article>
        ))}
      </div>
      <p class="mt-5 text-sm leading-relaxed text-ink-soft">{impactCopy.note}</p>
      <div class="mt-8 flex flex-col gap-4 rounded-2xl border border-white/75 bg-white/60 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
        <div>
          <h3 class="font-display text-2xl font-black text-brand-ink">{impactCopy.voiceTitle}</h3>
          <p class="mt-2 max-w-2xl leading-relaxed text-ink-soft">{impactCopy.voiceText}</p>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{impactCopy.privacy}</p>
        </div>
        <a href="https://wa.me/905511972997" target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center rounded-xl bg-brand-walnut px-5 py-3 font-bold text-white shadow-md transition hover:-translate-y-0.5 hover:bg-brand-stamp focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-stamp">{impactCopy.voiceCta}</a>
      </div>
    </section>

{teamData && teamData.length > 0 && (
      <section>
        <h2 class="font-display font-black text-4xl sm:text-5xl md:text-6xl tracking-tightest leading-none text-brand-ink mb-10">{p.about.teamHeading}</h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
          {teamData.map((member: TeamMember) => (
            <article class="group bg-brand-cream transition-all hover:-translate-y-1 hover:translate-x-0.5 overflow-hidden card">
              {member.image ? (
                <div class="relative aspect-[3/4] bg-surface-muted overflow-hidden border-b border-line">
                  <img
                    src={member.image}
                    alt={member.name}
                    class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="aspect-[3/4] bg-brand-walnut text-brand-cream flex items-center justify-center font-display text-5xl font-black border-b border-line">
                  {member.name.split(' ').map(n => n[0]).join('').toUpperCase()}
                </div>
              )}
              <div class="p-3 sm:p-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-brand-stamp mb-1">{roleLabel(member.role)}</p>
                <h3 class="font-display font-bold text-base sm:text-lg text-brand-ink tracking-tight leading-tight">{member.name}</h3>
                {bioText(member) && (
                  <p class="hidden sm:block mt-2 text-xs text-ink-soft leading-relaxed line-clamp-3">{bioText(member)}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
