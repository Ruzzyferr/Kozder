---
import { useTranslations, usePage, path, alternatePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const p = usePage(lang);

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import teamData from '../../data/team.json';

interface TeamMember {
  name: string;
  role: string;
  bio: string;
  image?: string;
}

const values = p.about.values;
const roleLabel = (role: string) => p.about.roles[role] ?? role;
const bioText = (member: TeamMember) => p.about.bios[member.name] ?? member.bio;
---

<BaseLayout
  lang={lang}
  title={p.meta.about.title}
  description={p.meta.about.description}
  alternate={alternatePath(lang, 'about')}
>
  <Breadcrumb
    lang={lang}
    kicker={t('about.kicker')}
    items={[{ label: t('nav.home'), href: path(lang, 'home') }, { label: t('nav.about'), href: path(lang, 'about') }]}
    pageTitle={p.head.about.pageTitle}
    intro={p.head.about.intro}
  />

  <div class="container mx-auto px-4 py-12 sm:py-20">

    <section class="mb-16 sm:mb-24">
      <div class="grid lg:grid-cols-2 gap-0 card card-2 bg-brand-cream">
        <article class="p-7 sm:p-10 bg-brand-cream border-r-0 lg:border-r-2 border-b-2 lg:border-b-0 border-brand-ink">
          <h2 class="font-display font-black text-3xl sm:text-4xl text-brand-ink mb-4 leading-[0.95] tracking-tightest">{p.about.missionHeading}</h2>
          <p class="text-ink-soft leading-relaxed">{p.about.missionText}</p>
        </article>

        <article class="p-7 sm:p-10 bg-brand-paper">
          <h2 class="font-display font-black text-3xl sm:text-4xl text-brand-ink mb-4 leading-[0.95] tracking-tightest">{p.about.visionHeading}</h2>
          <p class="text-ink-soft leading-relaxed">{p.about.visionText}</p>
        </article>
      </div>
    </section>

    <section class="mb-16 sm:mb-24">
      <h2 class="font-display font-black text-4xl sm:text-5xl md:text-6xl tracking-tightest leading-none text-brand-ink mb-10">{p.about.valuesHeading}</h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-5 card card-2 bg-brand-cream divide-y sm:divide-y-0 sm:divide-x divide-line">
        {values.map(v => (
          <div class="p-6 hover:bg-brand-paper transition-colors">
            <p class="font-display font-black text-5xl text-brand-walnut leading-none mb-3 tracking-tightest">{v.n}</p>
            <h3 class="font-display font-bold text-xl text-brand-ink mb-2 tracking-tight">{v.title}</h3>
            <p class="text-sm text-ink-soft leading-relaxed">{v.text}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-16 sm:mb-24" aria-labelledby="partnership-profiles-heading">
      <div class="mb-7 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp">
          {lang === 'en' ? 'Institutional documents' : 'Kurumsal belgeler'}
        </p>
        <h2 id="partnership-profiles-heading" class="font-display text-4xl sm:text-5xl font-black tracking-tightest leading-none text-brand-ink">
          {lang === 'en' ? 'Erasmus+ Partnership Profiles' : 'Erasmus+ Ortaklık Profilleri'}
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-ink-soft">
          {lang === 'en'
            ? 'Choose the profile that matches your application type and access KOZ-DER’s ready-to-use institutional information, experience and partnership capacity.'
            : 'Başvuru türünüze uygun profili seçerek KOZ-DER’in kullanıma hazır kurumsal bilgilerine, deneyimine ve ortaklık kapasitesine ulaşabilirsiniz.'}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        <article class="card card-2 overflow-hidden bg-brand-ink text-brand-cream p-7 sm:p-9 flex flex-col">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-postage">Erasmus+ KA1</p>
          <h3 class="mt-3 font-display text-3xl sm:text-4xl font-black tracking-tightest leading-none">
            {lang === 'en' ? 'KA1 Partnership Profile' : 'KA1 Ortaklık Profili'}
          </h3>
          <p class="mt-4 mb-7 text-sm leading-relaxed text-brand-cream/80 flex-1">
            {lang === 'en'
              ? 'For youth mobility projects: organisational profile, regular youth work, key staff, mobility experience and associated persons.'
              : 'Gençlik hareketliliği projeleri için kurumsal profil, düzenli gençlik çalışmaları, kilit ekip, hareketlilik deneyimi ve ilişkili kişiler.'}
          </p>
          <div class="grid sm:grid-cols-2 gap-3">
            <a
              href="/documents/KA1_Partner_Profile_2026.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="h-12 px-4 border border-brand-cream bg-brand-cream text-brand-ink hover:bg-brand-postage hover:border-brand-postage inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors"
            >
              {lang === 'en' ? 'View Profile' : 'Profili Görüntüle'} <span aria-hidden="true">↗</span>
            </a>
            <a
              href="/documents/KA1_Partner_Profile_2026.pdf"
              download="KOZ-DER-KA1-Partner-Profile-2026.pdf"
              class="h-12 px-4 border border-brand-cream/70 text-brand-cream hover:bg-brand-cream hover:text-brand-ink inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors"
            >
              {lang === 'en' ? 'Download PDF' : 'PDF’yi İndir'} <span aria-hidden="true">↓</span>
            </a>
          </div>
        </article>

        <article class="card card-2 overflow-hidden bg-brand-ocean text-brand-cream p-7 sm:p-9 flex flex-col">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-cream/75">Erasmus+ KA2</p>
          <h3 class="mt-3 font-display text-3xl sm:text-4xl font-black tracking-tightest leading-none">
            {lang === 'en' ? 'KA2 Partnership Profile' : 'KA2 Ortaklık Profili'}
          </h3>
          <p class="mt-4 mb-7 text-sm leading-relaxed text-brand-cream/85 flex-1">
            {lang === 'en'
              ? 'For cooperation partnerships: main activities, application-field experience, learner profiles, past participation and partnership capacity.'
              : 'İş birliği ortaklıkları için temel faaliyetler, başvuru alanındaki deneyim, öğrenici profilleri, geçmiş katılım ve ortaklık kapasitesi.'}
          </p>
          <div class="grid sm:grid-cols-2 gap-3">
            <a
              href="/documents/KA2_Partner_Profile_2026.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="h-12 px-4 border border-brand-cream bg-brand-cream text-brand-ink hover:bg-brand-postage hover:border-brand-postage inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors"
            >
              {lang === 'en' ? 'View Profile' : 'Profili Görüntüle'} <span aria-hidden="true">↗</span>
            </a>
            <a
              href="/documents/KA2_Partner_Profile_2026.pdf"
              download="KOZ-DER-KA2-Partner-Profile-2026.pdf"
              class="h-12 px-4 border border-brand-cream/80 text-brand-cream hover:bg-brand-cream hover:text-brand-ink inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors"
            >
              {lang === 'en' ? 'Download PDF' : 'PDF’yi İndir'} <span aria-hidden="true">↓</span>
            </a>
          </div>
        </article>
      </div>
    </section>

    {teamData && teamData.length > 0 && (
      <section>
        <h2 class="font-display font-black text-4xl sm:text-5xl md:text-6xl tracking-tightest leading-none text-brand-ink mb-10">{p.about.teamHeading}</h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
          {teamData.map((member: TeamMember) => (
            <article class="group bg-brand-cream transition-all hover:-translate-y-1 hover:translate-x-0.5 overflow-hidden card">
              {member.image ? (
                <div class="relative aspect-[3/4] bg-surface-muted overflow-hidden border-b border-line">
                  <img
                    src={member.image}
                    alt={member.name}
                    class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="aspect-[3/4] bg-brand-walnut text-brand-cream flex items-center justify-center font-display text-5xl font-black border-b border-line">
                  {member.name.split(' ').map(n => n[0]).join('').toUpperCase()}
                </div>
              )}
              <div class="p-3 sm:p-4">
                <p class="text-[11px] font-bold uppercase tracking-[0.15em] text-brand-stamp mb-1">{roleLabel(member.role)}</p>
                <h3 class="font-display font-bold text-base sm:text-lg text-brand-ink tracking-tight leading-tight">{member.name}</h3>
                {bioText(member) && (
                  <p class="hidden sm:block mt-2 text-xs text-ink-soft leading-relaxed line-clamp-3">{bioText(member)}</p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
