---
import { useTranslations, usePage, path, alternatePath, entryPath, stripLangPrefix, type Lang } from '../../i18n';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const p = usePage(lang);

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../ProjectCard.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import affiliations from '../../data/affiliations.json';
import { getCollection } from 'astro:content';
import { getEffectiveEventDate, getEventDateSortKey, formatEventDate } from '../../utils/date';
import { byNewest } from '../../utils/contentSort';
import { isProjectApplicationOpen } from '../../utils/projectApplications';

const projects = (await getCollection('projects', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(p => !p.data.draft);
const events = (await getCollection('events', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(e => !e.data.draft);
const posts = (await getCollection('posts', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(p => !p.data.draft);
const news = (await getCollection('news', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(n => !n.data.draft);
const stories = (await getCollection('stories', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(s => !s.data.draft);

const projectStatusRank = (p: (typeof projects)[number]) => (isProjectApplicationOpen(p.data) ? 0 : 1);
const newestProject = byNewest('projects', 'startDate');

const featuredProjects = [...projects].sort(newestProject);
const heroPhoto = news.find(item => stripLangPrefix(item.slug) === 'life-for-prr');

// Etkinlik bölümü: yaklaşan varsa onlar, yoksa bölüm kaybolmasın diye
// en son yapılanlar gösterilir.
const todayMidnight = new Date();
todayMidnight.setHours(0, 0, 0, 0);
const eventDate = (event: (typeof events)[number]) => getEffectiveEventDate(event.data.date, {
  recurring: event.data.recurring,
  weekday: event.data.weekday,
  time: event.data.time,
  timezone: event.data.timezone,
});
const upcomingEvents = events
  .filter(e => e.data.recurring === 'weekly' || getEventDateSortKey(e.data.date) >= todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(eventDate(a)) - getEventDateSortKey(eventDate(b)));
const pastEvents = events
  .filter(e => e.data.recurring !== 'weekly' && getEventDateSortKey(e.data.date) < todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(b.data.date) - getEventDateSortKey(a.data.date));
const showingUpcoming = upcomingEvents.length > 0;
const homeEvents = (showingUpcoming ? upcomingEvents : pastEvents).slice(0, 4);

const recentPosts = [...posts].sort(byNewest('posts', 'date')).slice(0, 3);

// Anasayfadaki bütün haberler, içerikte belirtilen tarihe göre yeniden eskiye sıralanır.
const newestNews = (a: (typeof news)[number], b: (typeof news)[number]) =>
  getEventDateSortKey(b.data.date) - getEventDateSortKey(a.data.date);
const sortedNews = [...news].sort(newestNews);
const leadNews = sortedNews[0];
const restNews = sortedNews.slice(1, 3);

// Hero slider News koleksiyonundan otomatik beslenir. Yeni haberler tarih sırasıyla görünür.
const heroNews = [...news]
  .filter(item => item.data.coverImage)
  .sort(newestNews)
  .slice(0, 5);

const featuredStories = [...stories]
  .sort((a, b) => getEventDateSortKey(b.data.startDate) - getEventDateSortKey(a.data.startDate))
  .slice(0, 8);

const stats = [
  { value: String(stories.length), label: t('home.stats.stories') },
  { value: String(projects.length), label: t('home.stats.projects') },
  { value: '15+', label: t('home.stats.partners') },
  { value: '7', label: t('home.stats.countries') },
];

const affiliationRows = [{
  label: lang === 'en' ? 'Our networks, partners and supporters' : 'Ağlarımız, paydaşlarımız ve destekçilerimiz',
  items: [...affiliations.networks.items, ...affiliations.partners.items],
  direction: 'left' as const,
  duration: 48,
}];

const steps = [
  { n: '01', title: t('home.steps.1.title'), text: t('home.steps.1.text'), href: path(lang, 'projects') },
  { n: '02', title: t('home.steps.2.title'), text: t('home.steps.2.text'), href: path(lang, 'faq') },
  { n: '03', title: t('home.steps.3.title'), text: t('home.steps.3.text'), href: path(lang, 'stories') },
];

// Kartlarda uzun proje adını kısa program etiketi olarak gösterir.
function storyProgramLabel(programName: string) {
  if (/Erasmus|The Power of Stories/i.test(programName)) return 'Erasmus+';
  if (/ESC|EVS|Avrupa Dayanışma|European Solidarity|gönüllül|volunteering|summer project|yaz dönemi projesi/i.test(programName)) return 'ESC';
  return programName;
}

// Etkinlik tarihini gün + kısaltılmış ay olarak parçalar.
function dateParts(value: string) {
  const key = getEventDateSortKey(value);
  if (!key) return { day: '·', month: '' };
  const d = new Date(key);
  return {
    day: String(d.getDate()).padStart(2, '0'),
    month: d.toLocaleDateString('tr-TR', { month: 'short' }).replace('.', '').toUpperCase(),
  };
}
---

<BaseLayout lang={lang} title={p.meta.home.title} description={p.meta.home.description} alternate={alternatePath(lang, 'home')}>
  <section class="journey-hero">
    <div class="container mx-auto px-4 journey-grid">
      <div class="journey-copy">
        <p class="journey-kicker">KİLİS · ERASMUS+ · ESC</p>
        <h1>{lang === 'en' ? 'From Kilis to Europe.' : 'Kilis’ten Avrupa’ya.'}<br /><span>{lang === 'en' ? 'Together.' : 'Birlikte.'}</span></h1>
        <p class="journey-lead">{lang === 'en' ? 'Meet new cultures, volunteer and turn your ideas into action. Find your next opportunity with KOZ-DER.' : 'Yeni kültürlerle tanış, gönüllü ol, fikirlerini hayata geçir. KOZ-DER ile sana uygun fırsatı keşfet.'}</p>
        <div class="journey-actions">
          <a class="journey-button" href="#opportunities">{lang === 'en' ? 'Explore opportunities' : 'Fırsatları keşfet'}</a>
          <a class="journey-button journey-button-outline" href={entryPath(lang, 'projects', 'kozder-gonullu')}>{lang === 'en' ? 'Volunteer with us' : 'Gönüllü ol'}</a>
        </div>
        <a class="journey-help" href={path(lang, 'faq')}>{lang === 'en' ? 'Your first project? Start here.' : 'İlk projen mi? Buradan başla.'}</a>
        <p class="journey-trust">{lang === 'en' ? 'Since 2019 · ESC Lead & Support Organisation' : '2019’dan beri · ESC Lider ve Destek Kuruluşu'}</p>
      </div>
      <figure class="journey-photo">
        <img src={heroPhoto?.data.coverImage ?? '/images/hero-bremen.jpg'} alt={lang === 'en' ? 'Youth exchange participants together in Kilis' : 'Kilis’te bir araya gelen gençlik değişimi katılımcıları'} width="2048" height="1152" fetchpriority="high" />
        <figcaption><span>{lang === 'en' ? 'Different countries. Shared experiences.' : 'Farklı ülkeler. Ortak deneyimler.'}</span><a href={entryPath(lang, 'news', heroPhoto ? stripLangPrefix(heroPhoto.slug) : 'bridges-for-future2')}>{lang === 'en' ? 'Discover our activities' : 'Çalışmalarımızı keşfet'}</a></figcaption>
      </figure>
    </div>
  </section>

  <section class="bg-brand-cream border-b border-line"><dl class="container mx-auto px-4 py-7 grid grid-cols-2 md:grid-cols-4 gap-6">{stats.map(stat => <div><dt class="text-sm text-ink-muted">{stat.label}</dt><dd class="font-display text-3xl font-bold text-brand-ink mt-1">{stat.value}</dd></div>)}</dl></section>

  <section id="opportunities" class="py-16 sm:py-20 bg-brand-paper border-b border-line">
    <div class="container mx-auto px-4">
      <header class="flex flex-col sm:flex-row sm:items-end justify-between gap-5 mb-8">
        <div><p class="text-sm font-semibold text-brand-stamp mb-3">{lang === 'en' ? 'Take the first step' : 'İlk adımı at'}</p><h2 class="font-display font-black text-4xl sm:text-5xl text-brand-ink">{lang === 'en' ? 'Open opportunities' : 'Açık fırsatlar'}</h2></div>
        <a class="text-base font-semibold underline underline-offset-4" href={path(lang, 'projects')}>{t('common.allProjects')}</a>
      </header>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredProjects.map(project => (
          <div data-home-opportunity data-project-static-status={project.data.status} data-project-start-date={project.data.startDate} data-project-deadline={project.data.applicationDeadline} hidden={!isProjectApplicationOpen(project.data)}>
            <ProjectCard lang={lang} title={lang === 'en' ? project.data.title_en : project.data.title_tr} summary={lang === 'en' ? project.data.summary_en : project.data.summary_tr} coverImage={project.data.coverImage} coverFit={project.data.coverFit} programType={project.data.programType} year={project.data.year} status={project.data.status} startDate={project.data.startDate} endDate={project.data.endDate} location={project.data.location} applicationDeadline={project.data.applicationDeadline} slug={project.slug} />
          </div>
        ))}
      </div>
      <p data-home-empty hidden={featuredProjects.some(project => isProjectApplicationOpen(project.data))} class="p-8 bg-brand-cream rounded-2xl text-base text-ink-soft">{lang === 'en' ? 'There are no open calls at the moment. Explore our projects and stay in touch for new opportunities.' : 'Şu anda başvurusu açık bir çağrı bulunmuyor. Projelerimizi inceleyebilir, yeni fırsatlar için bizimle iletişimde kalabilirsin.'}</p>
    </div>
  </section>
  <!-- ============ HİKAYELER — tam kanayan yatay şerit ============ -->
  {featuredStories.length > 0 && (
    <section class="py-20 sm:py-28 bg-brand-paper overflow-hidden">
      <div class="container mx-auto px-4">
        <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12 reveal">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">{t('home.stories.kicker')}</p>
            <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
              {t('home.stories.title.a')} <span class="text-brand-stamp" style="font-variation-settings: 'opsz' 72, 'wdth' 80;">{t('home.stories.title.b')}</span>
            </h2>
          </div>
          <a href={path(lang, 'stories')} class="group inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-brand-ink border-b border-brand-ink pb-1 py-2 hover:text-brand-stamp hover:border-brand-stamp transition-colors w-fit">
            {t('common.allStories')}
          </a>
        </header>
      </div>

      <div class="story-rail flex gap-5 overflow-x-auto pb-4 px-4 sm:pl-[max(1rem,calc((100vw-1280px)/2+1rem))]">
        {featuredStories.map(story => (
          <a href={entryPath(lang, 'stories', stripLangPrefix(story.slug))} class="group shrink-0 w-[62vw] sm:w-64 snap-start">
            <div class="relative aspect-[3/4] overflow-hidden bg-surface-muted card card-2">
              {story.data.images[0] ? (
                <img
                  src={story.data.images[0]}
                  alt={story.data.name}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <span class="absolute inset-0 flex items-center justify-center bg-brand-walnut text-brand-cream font-display text-4xl font-black">
                  {story.data.name.split(' ').map(n => n[0]).join('').toUpperCase()}
                </span>
              )}
              <span class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/85 via-black/45 to-transparent"></span>
              <span class="absolute bottom-0 left-0 right-0 p-4">
                <span class="block text-sm uppercase tracking-[0.2em] text-white/90 font-semibold">{story.data.country} · {storyProgramLabel(story.data.programName)}</span>
                <span class="mt-1 block font-display font-bold text-lg text-white leading-tight">{story.data.name}</span>
              </span>
            </div>
            <p class="mt-4 text-base text-ink-soft leading-relaxed line-clamp-3">{story.data.summary}</p>
          </a>
        ))}
        <span class="shrink-0 w-4" aria-hidden="true"></span>
      </div>
    </section>
  )}

  <!-- ============ ÜÇ ADIM ============ -->
  <section class="py-20 sm:py-28 bg-brand-paper">
    <div class="container mx-auto px-4">
      <header class="max-w-2xl mb-14 reveal">
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">{t('home.steps.kicker')}</p>
        <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
          {t('home.steps.title')}
        </h2>
      </header>

      <ol class="grid md:grid-cols-3 gap-px bg-line border-y border-line stagger">
        {steps.map(step => (
          <li class="bg-brand-paper">
            <a href={step.href} class="group block h-full p-7 sm:p-9 hover:bg-brand-cream transition-colors duration-300">
              <span class="font-display font-black text-5xl text-brand-walnut/35 leading-none tracking-tightest block group-hover:text-brand-walnut transition-colors duration-300">
                {step.n}
              </span>
              <h3 class="font-display font-bold text-2xl text-brand-ink mt-7 mb-3 tracking-tight">{step.title}</h3>
              <p class="text-base text-ink-soft leading-relaxed">{step.text}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-brand-walnut">
                {t('home.steps.more')}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ ETKİNLİKLER — ajanda ============ -->
  {homeEvents.length > 0 && (
    <section class="py-20 sm:py-28 bg-brand-cream border-y border-line">
      <div class="container mx-auto px-4">
        <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12 reveal">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">{t('home.events.kicker')}</p>
            <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
              {showingUpcoming ? t('home.events.title.upcoming') : t('home.events.title.past')}
            </h2>
          </div>
          <a href={path(lang, 'events')} class="group inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-brand-ink border-b border-brand-ink pb-1 py-2 hover:text-brand-stamp hover:border-brand-stamp transition-colors w-fit">
            {t('common.allEvents')}
          </a>
        </header>

        <ul class="grid md:grid-cols-2 md:gap-x-14 border-t border-line">
          {homeEvents.map(event => {
            const { day, month } = dateParts(eventDate(event));
            return (
              <li
                class="border-b border-line"
                data-recurring-event={event.data.recurring}
                data-weekday={event.data.weekday}
                data-time={event.data.time}
                data-timezone={event.data.timezone}
                data-lang={lang}
              >
                <a href={entryPath(lang, 'events', stripLangPrefix(event.slug))} class="group flex items-start gap-5 py-6 transition-colors duration-300 hover:bg-brand-paper/70 -mx-3 px-3">
                  <span class="shrink-0 w-14 text-center pt-0.5">
                    <span data-event-day class="block font-display font-black text-2xl text-brand-ink leading-none tracking-tightest">{day}</span>
                    <span data-event-month class="mt-1 block text-sm font-semibold uppercase tracking-[0.14em] text-brand-stamp">{month}</span>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-display font-bold text-lg sm:text-xl text-brand-ink leading-snug tracking-tight group-hover:text-brand-stamp transition-colors duration-300">
                      {event.data.title_tr}
                    </span>
                    <span class="mt-1.5 block text-sm text-ink-muted leading-snug">
                      {event.data.time ? `${event.data.time} · ` : ''}{event.data.location}
                    </span>
                  </span>

                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ HABERLER — 1 büyük + 2 küçük ============ -->
  {leadNews && (
    <section class="py-20 sm:py-28 bg-brand-paper">
      <div class="container mx-auto px-4">
        <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12 reveal">
          <div class="max-w-2xl">
            <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">{t('home.news.kicker')}</p>
            <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
              {t('home.news.title')}
            </h2>
          </div>
          <a href={path(lang, 'news')} class="group inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-brand-ink border-b border-brand-ink pb-1 py-2 hover:text-brand-stamp hover:border-brand-stamp transition-colors w-fit">
            {t('common.allNews')}
          </a>
        </header>

        <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
          <a href={entryPath(lang, 'news', stripLangPrefix(leadNews.slug))} class="group lg:col-span-7 block">
            {leadNews.data.coverImage && (
              <div class="relative aspect-[16/10] overflow-hidden bg-surface-muted card mb-6">
                <img
                  src={leadNews.data.coverImage}
                  alt={lang === 'en' ? leadNews.data.title_en : leadNews.data.title_tr}
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                />
              </div>
            )}
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-3">
              <span class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-stamp">
                {formatEventDate(leadNews.data.date, { lang })}
              </span>
              {leadNews.data.category && (
                <span class="text-sm font-semibold uppercase tracking-[0.14em] text-ink-muted border border-line-strong px-1.5 py-0.5">
                  {leadNews.data.category}
                </span>
              )}
            </div>
            <h3 class="font-display font-bold text-2xl sm:text-3xl text-brand-ink leading-tight tracking-tight group-hover:text-brand-stamp transition-colors duration-300">
              {lang === 'en' ? leadNews.data.title_en : leadNews.data.title_tr}
            </h3>
            <p class="mt-3 text-ink-soft leading-relaxed line-clamp-2 max-w-xl">
              {lang === 'en' ? leadNews.data.summary_en : leadNews.data.summary_tr}
            </p>
          </a>

          <ul class="lg:col-span-5 border-t border-line">
            {restNews.map(item => (
              <li class="border-b border-line">
                <a href={entryPath(lang, 'news', stripLangPrefix(item.slug))} class="group flex gap-4 py-5 transition-colors duration-300 hover:bg-brand-cream/70 -mx-3 px-3">
                  {item.data.coverImage && (
                    <span class="shrink-0 w-24 sm:w-28 aspect-[4/3] overflow-hidden rounded-lg bg-surface-muted">
                      <img src={item.data.coverImage} alt="" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    </span>
                  )}
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold uppercase tracking-[0.18em] text-brand-stamp mb-1.5">
                      {formatEventDate(item.data.date, { lang })}
                    </span>
                    <span class="font-display font-bold text-base sm:text-lg text-brand-ink leading-snug tracking-tight line-clamp-3 group-hover:text-brand-stamp transition-colors duration-300">
                      {lang === 'en' ? item.data.title_en : item.data.title_tr}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <!-- ============ DUYURULAR — ince şerit ============ -->
  {recentPosts.length > 0 && (
    <section class="bg-brand-cream border-y border-line">
      <div class="container mx-auto px-4 py-10 sm:py-12">
        <div class="flex items-center gap-4 mb-6">
          <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-stamp whitespace-nowrap">{t('home.posts.kicker')}</p>
          <span class="h-px flex-1 bg-line"></span>
          <a href={path(lang, 'posts')} class="text-sm font-semibold uppercase tracking-[0.16em] text-ink-muted hover:text-brand-stamp transition-colors whitespace-nowrap">
            {t('common.all')} →
          </a>
        </div>
        <ul class="divide-y divide-line border-y border-line">
          {recentPosts.map(post => (
            <li>
              <a href={entryPath(lang, 'posts', stripLangPrefix(post.slug))} class="group flex items-baseline gap-4 sm:gap-6 py-3.5 transition-colors duration-300 hover:bg-brand-paper/70 -mx-3 px-3">
                <span class="shrink-0 w-16 sm:w-24 text-sm font-semibold uppercase tracking-[0.14em] text-ink-muted">
                  {formatEventDate(post.data.date, { lang })}
                </span>
                <span class="min-w-0 flex-1 font-display font-semibold text-base sm:text-lg text-brand-ink leading-snug tracking-tight truncate group-hover:text-brand-stamp transition-colors duration-300">
                  {lang === 'en' ? post.data.title_en : post.data.title_tr}
                </span>

              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ ERASMUS+ ORTAKLIK PROFİLLERİ ============ -->
  <section class="bg-brand-paper border-b border-line py-16 sm:py-20" aria-labelledby="partnership-profiles-heading">
    <div class="container mx-auto px-4">
      <div class="mb-8 max-w-3xl">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-brand-stamp">
          {lang === 'en' ? 'Institutional documents' : 'Kurumsal belgeler'}
        </p>
        <h2 id="partnership-profiles-heading" class="font-display text-4xl sm:text-5xl font-black tracking-tightest leading-none text-brand-ink">
          {lang === 'en' ? 'Erasmus+ Partnership Profiles' : 'Erasmus+ Ortaklık Profilleri'}
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-ink-soft">
          {lang === 'en'
            ? 'Choose the profile that matches your application type and access KOZ-DER’s ready-to-use institutional information, experience and partnership capacity.'
            : 'Başvuru türünüze uygun profili seçerek KOZ-DER’in kullanıma hazır kurumsal bilgilerine, deneyimine ve ortaklık kapasitesine ulaşabilirsiniz.'}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        <article class="card card-2 overflow-hidden bg-brand-ink text-brand-cream p-7 sm:p-9 flex flex-col">
          <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-postage">Erasmus+ KA1</p>
