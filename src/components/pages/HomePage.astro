---
import { useTranslations, usePage, path, alternatePath, entryPath, stripLangPrefix, type Lang } from '../../i18n';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const p = usePage(lang);

import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import affiliations from '../../data/affiliations.json';
import { getCollection } from 'astro:content';
import { getEventDateSortKey, formatEventDate } from '../../utils/date';
import { byNewest } from '../../utils/contentSort';

const projects = (await getCollection('projects', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(p => !p.data.draft);
const events = (await getCollection('events', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(e => !e.data.draft);
const posts = (await getCollection('posts', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(p => !p.data.draft);
const news = (await getCollection('news', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(n => !n.data.draft);
const stories = (await getCollection('stories', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(s => !s.data.draft);

const projectStatusRank = (s: string) => (s === 'Aktif' ? 0 : 1);
const newestProject = byNewest('projects', 'startDate');

const featuredProjects = projects
  .filter(p => p.data.featured)
  .sort((a, b) => {
    const s = projectStatusRank(a.data.status) - projectStatusRank(b.data.status);
    if (s !== 0) return s;
    return newestProject(a, b);
  })
  .slice(0, 5);

// Etkinlik bölümü: yaklaşan varsa onlar, yoksa bölüm kaybolmasın diye
// en son yapılanlar gösterilir.
const todayMidnight = new Date();
todayMidnight.setHours(0, 0, 0, 0);
const upcomingEvents = events
  .filter(e => getEventDateSortKey(e.data.date) >= todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(a.data.date) - getEventDateSortKey(b.data.date));
const pastEvents = events
  .filter(e => getEventDateSortKey(e.data.date) < todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(b.data.date) - getEventDateSortKey(a.data.date));
const showingUpcoming = upcomingEvents.length > 0;
const homeEvents = (showingUpcoming ? upcomingEvents : pastEvents).slice(0, 4);

const recentPosts = [...posts].sort(byNewest('posts', 'date')).slice(0, 3);

// Anasayfadaki bütün haberler, içerikte belirtilen tarihe göre yeniden eskiye sıralanır.
const newestNews = (a: (typeof news)[number], b: (typeof news)[number]) =>
  getEventDateSortKey(b.data.date) - getEventDateSortKey(a.data.date);
const sortedNews = [...news].sort(newestNews);
const leadNews = sortedNews[0];
const restNews = sortedNews.slice(1, 3);

// Hero slider News koleksiyonundan otomatik beslenir. Yeni haberler tarih sırasıyla görünür.
const heroNews = [...news]
  .filter(item => item.data.coverImage)
  .sort(newestNews)
  .slice(0, 5);

const featuredStories = [...stories]
  .sort((a, b) => getEventDateSortKey(b.data.startDate) - getEventDateSortKey(a.data.startDate))
  .slice(0, 8);

const stats = [
  { value: String(stories.length), label: t('home.stats.stories') },
  { value: String(projects.length), label: t('home.stats.projects') },
  { value: '15+', label: t('home.stats.partners') },
  { value: '7', label: t('home.stats.countries') },
];

const affiliationRows = [
  { ...affiliations.networks, label: lang === 'en' ? affiliations.networks.label_en : affiliations.networks.label, direction: 'left' as const, duration: 30 },
  { ...affiliations.partners, label: lang === 'en' ? affiliations.partners.label_en : affiliations.partners.label, direction: 'right' as const, duration: 46 },
];

const heroMessage = lang === 'en'
  ? {
      line1: 'Europe.',
      line2: 'Volunteer.',
      rotating: [
        { text: 'Join In.', color: '#CE3A1F' },
        { text: 'Create Together.', color: '#2F6BFF' },
        { text: 'Take Part Equally.', color: '#248552' },
        { text: 'For Everyone.', color: '#7C3AED' },
        { text: 'Every Voice Counts.', color: '#0F766E' },
        { text: 'Diversity Is Strength.', color: '#B83280' },
        { text: 'Break Barriers.', color: '#C2410C' },
        { text: 'Grow Together.', color: '#2563EB' },
        { text: 'Code the Future.', color: '#5B5BD6' },
        { text: 'Discover the World.', color: '#0E7490' },
      ],
      lead: 'From Kilis to Europe, volunteer, gain experience and discover the world through Erasmus+ and European Solidarity Corps opportunities.',
      primary: 'Explore Opportunities',
      secondary: 'Discover KOZ-DER',
      how: 'How can I join?',
      trust: ['Active since 2019', 'ESC Lead & Support Organisation', 'Volunteering across Europe'],
    }
  : {
      line1: 'Avrupa.',
      line2: 'Gönüllü Ol.',
      rotating: [
        { text: 'Sen de Katıl.', color: '#CE3A1F' },
        { text: 'Birlikte Üret.', color: '#2F6BFF' },
        { text: 'Eşitçe Katıl.', color: '#248552' },
        { text: 'Herkes İçin.', color: '#7C3AED' },
        { text: 'Sesini Duyur.', color: '#0F766E' },
        { text: 'Farklılık Güçtür.', color: '#B83280' },
        { text: 'Engelleri Aş.', color: '#C2410C' },
        { text: 'Dayanışmayla Büyü.', color: '#2563EB' },
        { text: 'Geleceği Kodla.', color: '#5B5BD6' },
        { text: 'Dünyayı Keşfet.', color: '#0E7490' },
      ],
      lead: "Kilis’ten Avrupa’ya uzanan Erasmus+ ve Avrupa Dayanışma Programı fırsatlarıyla gönüllü ol, deneyim kazan ve dünyayı keşfet.",
      primary: 'Fırsatları İncele',
      secondary: 'KOZ-DER’i Tanı',
      how: 'Nasıl katılırım?',
      trust: ['2019’dan beri aktif', 'ESC Lider ve Destek Kuruluşu', 'Avrupa çapında gönüllülük'],
    };

const steps = [
  { n: '01', title: t('home.steps.1.title'), text: t('home.steps.1.text'), href: path(lang, 'projects') },
  { n: '02', title: t('home.steps.2.title'), text: t('home.steps.2.text'), href: path(lang, 'faq') },
  { n: '03', title: t('home.steps.3.title'), text: t('home.steps.3.text'), href: path(lang, 'stories') },
];

// Kartlarda uzun proje adını kısa program etiketi olarak gösterir.
function storyProgramLabel(programName: string) {
  if (/Erasmus|The Power of Stories/i.test(programName)) return 'Erasmus+';
  if (/ESC|EVS|Avrupa Dayanışma|European Solidarity|gönüllül|volunteering|summer project|yaz dönemi projesi/i.test(programName)) return 'ESC';
  return programName;
}

// Etkinlik tarihini gün + kısaltılmış ay olarak parçalar.
function dateParts(value: string) {
  const key = getEventDateSortKey(value);
  if (!key) return { day: '·', month: '' };
  const d = new Date(key);
  return {
    day: String(d.getDate()).padStart(2, '0'),
    month: d.toLocaleDateString('tr-TR', { month: 'short' }).replace('.', '').toUpperCase(),
  };
}
---

<BaseLayout
  lang={lang}
  title={p.meta.home.title}
  description={p.meta.home.description}
  alternate={alternatePath(lang, 'home')}
>
  <!-- ============ HERO — asimetrik, sağda tam kanayan fotoğraf ============ -->
  <section class="bg-brand-paper">
    <div class="grid lg:grid-cols-2 items-stretch lg:h-[720px] xl:h-[760px]">
      <div
        class="flex items-center px-5 sm:px-8 py-14 sm:py-20 lg:py-16 xl:py-20
               lg:pl-[max(1.5rem,calc((100vw-1280px)/2+1rem))] lg:pr-12 xl:pr-20"
      >
        <div class="w-full max-w-xl reveal">
          <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-7">
            {t('home.hero.kicker')}
          </p>


          <h1 class="font-display text-brand-ink leading-[0.88] tracking-tightest">
            <span class="block text-[3.15rem] sm:text-7xl xl:text-8xl font-black">{heroMessage.line1}</span>
            <span
              class="block text-[3.15rem] sm:text-7xl xl:text-8xl font-black text-brand-stamp"
              style="font-variation-settings: 'opsz' 96, 'wdth' 78;"
            >{heroMessage.line2}</span>
            <span
              class="hero-rotating-line block min-h-[0.9em] whitespace-nowrap text-[2.75rem] sm:text-6xl xl:text-7xl font-black"
              data-hero-rotating
              data-rotating-words={JSON.stringify(heroMessage.rotating)}
              aria-live="polite"
              style={`color: ${heroMessage.rotating[0].color}; font-variation-settings: 'opsz' 96, 'wdth' 78;`}
            >{heroMessage.rotating[0].text}</span>
          </h1>

          <p class="mt-7 text-base sm:text-lg text-ink-soft leading-relaxed max-w-lg">
            {heroMessage.lead}
          </p>

          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a
              href={path(lang, 'projects')}
              class="group inline-flex items-center justify-center gap-3 bg-brand-stamp text-white hover:bg-brand-ink px-7 py-4 rounded-full text-[11px] font-semibold uppercase tracking-[0.16em] transition-colors duration-300"
            >
              {heroMessage.primary}
              <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
            <a
              href={path(lang, 'about')}
              class="inline-flex items-center justify-center gap-2 border border-brand-ink text-brand-ink hover:bg-brand-ink hover:text-brand-cream px-7 py-4 rounded-full text-[11px] font-semibold uppercase tracking-[0.16em] transition-colors duration-300"
            >
              {heroMessage.secondary}
            </a>
          </div>

          <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
            <a href={path(lang, 'faq')} class="text-[11px] font-semibold text-brand-stamp underline underline-offset-4 hover:text-brand-ink transition-colors">
              {heroMessage.how} →
            </a>
            <span class="hidden sm:block h-3 w-px bg-line-strong" aria-hidden="true"></span>
            <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-[9px] sm:text-[10px] font-semibold uppercase tracking-[0.11em] text-ink-muted">
              {heroMessage.trust.map((item) => (
                <span class="inline-flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand-stamp" aria-hidden="true"></span>
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div
        class="hero-media hero-news-slider relative min-h-[340px] sm:min-h-[460px] lg:min-h-0 lg:my-8 lg:mr-6 xl:mr-10 overflow-hidden rounded-[24px] lg:rounded-[28px] bg-brand-ink"
        data-hero-news-slider
        aria-roledescription="carousel"
        aria-label={lang === 'en' ? 'Latest news' : 'Son haberler'}
      >
        {heroNews.length > 0 ? (
          <>
            {heroNews.map((item, index) => {
              const title = lang === 'en' ? item.data.title_en : item.data.title_tr;
              return (
                <a
                  href={entryPath(lang, 'news', stripLangPrefix(item.slug))}
                  class="hero-news-slide group absolute inset-0 block"
                  data-hero-news-slide
                  data-active={index === 0 ? 'true' : 'false'}
                  aria-hidden={index === 0 ? 'false' : 'true'}
                  tabindex={index === 0 ? 0 : -1}
                >
                  <img
                    src={item.data.coverImage}
                    alt=""
                    aria-hidden="true"
                    class="absolute inset-0 w-full h-full object-cover scale-110 blur-xl opacity-40"
                    loading={index === 0 ? 'eager' : 'lazy'}
                  />
                  <img
                    src={item.data.coverImage}
                    alt={title}
                    class="absolute inset-0 w-full h-full object-contain transition-transform duration-[1200ms] group-hover:scale-[1.01]"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                    width="960"
                    height="1200"
                  />
                  <span class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></span>
                  <span class="absolute inset-x-0 bottom-0 p-5 sm:p-7 lg:p-9 text-white">
                    <span class="block text-[10px] font-semibold uppercase tracking-[0.18em] text-white/80 mb-2">
                      {formatEventDate(item.data.date, { lang })}
                    </span>
                    <span class="block font-display font-bold text-2xl sm:text-3xl leading-tight max-w-2xl">{title}</span>
                    <span class="mt-3 inline-flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.16em]">
                      {lang === 'en' ? 'Read the news' : 'Haberi oku'} <span aria-hidden="true">→</span>
                    </span>
                  </span>
                </a>
              );
            })}

            {heroNews.length > 1 && (
              <>
                <div class="absolute z-10 right-4 top-4 flex items-center gap-2">
                  <button type="button" class="hero-news-control" data-hero-news-prev aria-label={lang === 'en' ? 'Previous news' : 'Önceki haber'}>←</button>
                  <button type="button" class="hero-news-control" data-hero-news-next aria-label={lang === 'en' ? 'Next news' : 'Sonraki haber'}>→</button>
                </div>
                <div class="absolute z-10 left-5 sm:left-7 lg:left-9 top-5 sm:top-7 flex gap-2" aria-hidden="true">
                  {heroNews.map((_, index) => (
                    <span class="hero-news-dot" data-hero-news-dot data-active={index === 0 ? 'true' : 'false'}></span>
                  ))}
                </div>
              </>
            )}
          </>
        ) : (
          <figure class="absolute inset-0 m-0">
            <img
              src="/images/hero-bremen.jpg"
              alt={t('home.hero.alt')}
              class="absolute inset-0 w-full h-full object-cover object-[50%_58%] lg:object-center"
              loading="eager"
              fetchpriority="high"
              width="960"
              height="1200"
            />
            <figcaption class="absolute bottom-0 left-0 right-0 px-5 pt-16 pb-4 text-[10px] font-medium uppercase tracking-[0.18em] text-white bg-gradient-to-t from-black/80 via-black/35 to-transparent">
              {t('home.hero.caption')}
            </figcaption>
          </figure>
        )}
      </div>
    </div>
  </section>

  <!-- ============ İSTATİSTİK — ince şerit ============ -->
  <section class="border-y border-line bg-brand-cream">
    <div class="container mx-auto px-4">
      <dl class="grid grid-cols-2 md:grid-cols-4">
        {stats.map((s, i) => (
          <div class={`py-7 sm:py-9 ${i % 2 === 1 ? 'pl-6' : ''} ${i > 0 ? 'md:pl-8' : ''} ${i < 2 ? 'border-b md:border-b-0 border-line' : ''} ${i > 0 ? 'md:border-l md:border-line' : ''}`}>
            <dt class="sr-only">{s.label}</dt>
            <dd class="m-0">
              <span class="font-display font-black text-4xl sm:text-5xl text-brand-ink leading-none tracking-tightest block">
                {s.value}
              </span>
              <span class="mt-2.5 block text-[10px] sm:text-[11px] uppercase tracking-[0.18em] text-ink-muted font-semibold">
                {s.label}
              </span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ============ AĞLAR & PAYDAŞLAR ============ -->
  <section class="bg-brand-paper border-b border-line py-12 sm:py-16" aria-labelledby="aglar-paydaslar">
    <h2 id="aglar-paydaslar" class="sr-only">{t('home.affiliations.title')}</h2>
    <div class="space-y-9 sm:space-y-11">
      {affiliationRows.map(row => (
        <div>
          <div class="container mx-auto px-4">
            <div class="flex items-center gap-4 mb-5">
              <p class="text-[10px] uppercase tracking-[0.22em] font-semibold text-ink-muted whitespace-nowrap">
                {row.label}
              </p>
              <span class="h-px flex-1 bg-line"></span>
            </div>
          </div>
          <LogoMarquee label={row.label} lang={lang} items={row.items} direction={row.direction} duration={row.duration} />
        </div>
      ))}
    </div>
  </section>

  <!-- ============ ERASMUS+ ORTAKLIK PROFİLLERİ ============ -->
  <section class="bg-brand-paper border-b border-line py-16 sm:py-20" aria-labelledby="partnership-profiles-heading">
    <div class="container mx-auto px-4">
      <div class="mb-8 max-w-3xl">
        <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp">
          {lang === 'en' ? 'Institutional documents' : 'Kurumsal belgeler'}
        </p>
        <h2 id="partnership-profiles-heading" class="font-display text-4xl sm:text-5xl font-black tracking-tightest leading-none text-brand-ink">
          {lang === 'en' ? 'Erasmus+ Partnership Profiles' : 'Erasmus+ Ortaklık Profilleri'}
        </h2>
        <p class="mt-4 text-sm sm:text-base leading-relaxed text-ink-soft">
          {lang === 'en'
            ? 'Choose the profile that matches your application type and access KOZ-DER’s ready-to-use institutional information, experience and partnership capacity.'
            : 'Başvuru türünüze uygun profili seçerek KOZ-DER’in kullanıma hazır kurumsal bilgilerine, deneyimine ve ortaklık kapasitesine ulaşabilirsiniz.'}
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-5">
        <article class="card card-2 overflow-hidden bg-brand-ink text-brand-cream p-7 sm:p-9 flex flex-col">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-postage">Erasmus+ KA1</p>
          <h3 class="mt-3 font-display text-3xl sm:text-4xl font-black tracking-tightest leading-none">
            {lang === 'en' ? 'KA1 Partnership Profile' : 'KA1 Ortaklık Profili'}
          </h3>
          <p class="mt-4 mb-7 text-sm leading-relaxed text-brand-cream/80 flex-1">
            {lang === 'en'
              ? 'For youth mobility projects: organisational profile, regular youth work, key staff, mobility experience and associated persons.'
              : 'Gençlik hareketliliği projeleri için kurumsal profil, düzenli gençlik çalışmaları, kilit ekip, hareketlilik deneyimi ve ilişkili kişiler.'}
          </p>
          <div class="grid sm:grid-cols-2 gap-3">
            <a href="/documents/KA1_Partner_Profile_2026.pdf" target="_blank" rel="noopener noreferrer" class="h-12 px-4 border border-brand-cream bg-brand-cream text-brand-ink hover:bg-brand-postage hover:border-brand-postage inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors">
              {lang === 'en' ? 'View Profile' : 'Profili Görüntüle'} <span aria-hidden="true">↗</span>
            </a>
            <a href="/documents/KA1_Partner_Profile_2026.pdf" download="KOZ-DER-KA1-Partner-Profile-2026.pdf" class="h-12 px-4 border border-brand-cream/70 text-brand-cream hover:bg-brand-cream hover:text-brand-ink inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors">
              {lang === 'en' ? 'Download PDF' : 'PDF’yi İndir'} <span aria-hidden="true">↓</span>
            </a>
          </div>
        </article>

        <article class="card card-2 overflow-hidden bg-brand-ocean text-brand-cream p-7 sm:p-9 flex flex-col">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-cream/75">Erasmus+ KA2</p>
          <h3 class="mt-3 font-display text-3xl sm:text-4xl font-black tracking-tightest leading-none">
            {lang === 'en' ? 'KA2 Partnership Profile' : 'KA2 Ortaklık Profili'}
          </h3>
          <p class="mt-4 mb-7 text-sm leading-relaxed text-brand-cream/85 flex-1">
            {lang === 'en'
              ? 'For cooperation partnerships: main activities, application-field experience, learner profiles, past participation and partnership capacity.'
              : 'İş birliği ortaklıkları için temel faaliyetler, başvuru alanındaki deneyim, öğrenici profilleri, geçmiş katılım ve ortaklık kapasitesi.'}
          </p>
          <div class="grid sm:grid-cols-2 gap-3">
            <a href="/documents/KA2_Partner_Profile_2026.pdf" target="_blank" rel="noopener noreferrer" class="h-12 px-4 border border-brand-cream bg-brand-cream text-brand-ink hover:bg-brand-postage hover:border-brand-postage inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors">
              {lang === 'en' ? 'View Profile' : 'Profili Görüntüle'} <span aria-hidden="true">↗</span>
            </a>
            <a href="/documents/KA2_Partner_Profile_2026.pdf" download="KOZ-DER-KA2-Partner-Profile-2026.pdf" class="h-12 px-4 border border-brand-cream/80 text-brand-cream hover:bg-brand-cream hover:text-brand-ink inline-flex items-center justify-center gap-2 text-xs font-bold uppercase tracking-[0.12em] transition-colors">
              {lang === 'en' ? 'Download PDF' : 'PDF’yi İndir'} <span aria-hidden="true">↓</span>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ ÜÇ ADIM ============ -->
  <section class="py-20 sm:py-28 bg-brand-paper">
    <div class="container mx-auto px-4">
      <header class="max-w-2xl mb-14 reveal">
        <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-brand-stamp mb-5">{t('home.steps.kicker')}</p>
        <h2 class="font-display font-black text-4xl sm:text-5xl tracking-tightest leading-[1.02] text-brand-ink">
          {t('home.steps.title')}
        </h2>
      </header>

      <ol class="grid md:grid-cols-3 gap-px bg-line border-y border-line stagger">
        {steps.map(step => (
          <li class="bg-brand-paper">
            <a href={step.href} class="group block h-full p-7 sm:p-9 hover:bg-brand-cream transition-colors duration-300">
              <span class="font-display font-black text-5xl text-brand-walnut/35 leading-none tracking-tightest block group-hover:text-brand-walnut transition-colors duration-300">
                {step.n}
              </span>
              <h3 class="font-display font-bold text-2xl text-brand-ink mt-7 mb-3 tracking-tight">{step.title}</h3>
              <p class="text-sm text-ink-soft leading-relaxed">{step.text}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-walnut">
                {t('home.steps.more')} <span class="transition-transform duration-300 group-hover:translate-x-1">→</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ AÇIK ÇAĞRILAR — editoryal liste ============ -->
  {featuredProjects.length > 0 && (
    <section class="py-20 sm:py-28 bg-brand-cream border-y border-line">
      <div class="container mx-auto px-4">
        <header class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-5 mb-12 reveal">
          <div class="max-w-2xl">
