<script>
// Seçenek 3: proje ve hikâye kaydırıcıları + proje durum rozetleri
const parseD=(v?:string)=>{if(!v)return 0;let m=v.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})$/);if(m)return new Date(+m[3],+m[2]-1,+m[1]).getTime();m=v.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return new Date(+m[1],+m[2]-1,+m[3]).getTime();return 0;};
const lang=document.getElementById('koz-glass')?.dataset.lang==='en'?'en':'tr';
const L:Record<string,[string,string]>={open:['Başvuru açık','Applications open'],running:['Devam ediyor','In progress'],done:['Tamamlandı','Completed'],closed:['Başvurular kapandı','Applications closed']};
function phase(el:HTMLElement){const now=Date.now();const st=parseD(el.dataset.start);const enRaw=parseD(el.dataset.end);const en=enRaw?enRaw+86399000:0;const dl=parseD(el.dataset.deadline);const dlEnd=dl?dl+86399000:0;
 if(el.dataset.status==='Aktif'&&(!st||st>now)&&(!dlEnd||dlEnd>=now)&&dl)return 'open';
 if(el.dataset.status==='Tamamlandı'||(en&&en<now))return 'done';
 if(st&&st<=now&&(!en||en>=now))return 'running';
 return 'closed';}
function syncPhases(){document.querySelectorAll<HTMLElement>('[data-v3-project]').forEach(el=>{const b=el.querySelector<HTMLElement>('[data-v3-status]');if(!b)return;const ph=phase(el);b.className='v3-status ph-'+ph;b.textContent=L[ph][lang==='en'?1:0];});}
syncPhases();setInterval(syncPhases,60000);
document.querySelectorAll<HTMLElement>('[data-carousel-root]').forEach(root=>{
 const vp=root.querySelector<HTMLElement>('.v3-viewport');const track=root.querySelector<HTMLElement>('.v3-track');if(!vp||!track)return;
 const cards=Array.from(track.children) as HTMLElement[];const prev=root.querySelector<HTMLButtonElement>('[data-c-prev]');const next=root.querySelector<HTMLButtonElement>('[data-c-next]');const dots=root.querySelector<HTMLElement>('.v3-dots');let i=0;
 const gap=()=>parseFloat(getComputedStyle(track).columnGap||'20')||20;
 const per=()=>{const cw=cards[0]?.getBoundingClientRect().width||1;return Math.max(1,Math.round((vp.clientWidth+gap())/(cw+gap())));};
 const upd=()=>{if(!cards.length)return;const p=per();const max=Math.max(0,cards.length-p);i=Math.min(Math.max(i,0),max);const step=cards[0].getBoundingClientRect().width+gap();track.style.transform=`translateX(${-i*step}px)`;if(prev)prev.disabled=i===0;if(next)next.disabled=i>=max;cards.forEach((c,k)=>{c.inert=k<i||k>=i+p;});
  if(dots){if(dots.childElementCount!==max+1){dots.replaceChildren(...Array.from({length:max+1},(_,k)=>{const b=document.createElement('button');b.type='button';b.setAttribute('aria-label',String(k+1));b.addEventListener('click',()=>{i=k;upd();});return b;}));}Array.from(dots.children).forEach((b,k)=>b.setAttribute('aria-current',String(k===i)));dots.hidden=max===0;}};
 prev?.addEventListener('click',()=>{i--;upd();});next?.addEventListener('click',()=>{i++;upd();});
 let sx:number|null=null;vp.addEventListener('pointerdown',e=>{sx=e.clientX;});vp.addEventListener('pointerup',e=>{if(sx!==null&&Math.abs(e.clientX-sx)>50){i+=e.clientX<sx?1:-1;upd();}sx=null;});vp.addEventListener('pointercancel',()=>{sx=null;});
 let tx=0,ty=0;vp.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;ty=e.touches[0].clientY;},{passive:true});vp.addEventListener('touchend',e=>{const t=e.changedTouches[0];const dx=t.clientX-tx,dy=t.clientY-ty;if(Math.abs(dx)>45&&Math.abs(dx)>Math.abs(dy)*1.3){i+=dx<0?1:-1;upd();}},{passive:true});
 new ResizeObserver(upd).observe(vp);upd();
});
</script>
