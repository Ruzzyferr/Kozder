---
import { srcsetFor, smallFor } from '../../utils/responsive';
import { useTranslations, usePage, path, alternatePath, entryPath, stripLangPrefix, type Lang } from '../../i18n';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const p = usePage(lang);

import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import affiliations from '../../data/affiliations.json';
import { getCollection } from 'astro:content';
import { getEffectiveEventDate, getEventDateSortKey, formatEventDate } from '../../utils/date';
import { byNewest } from '../../utils/contentSort';
import { isProjectApplicationOpen } from '../../utils/projectApplications';

const projects = (await getCollection('projects', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(p => !p.data.draft);
const events = (await getCollection('events', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(e => !e.data.draft);
const posts = (await getCollection('posts', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(p => !p.data.draft);
const news = (await getCollection('news', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(n => !n.data.draft);
const stories = (await getCollection('stories', e => lang === 'en' ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'))).filter(s => !s.data.draft);

const projectStatusRank = (p: (typeof projects)[number]) => (isProjectApplicationOpen(p.data) ? 0 : 1);
const newestProject = byNewest('projects', 'startDate');

const featuredProjects = projects
  .filter(p => p.data.featured)
  .sort((a, b) => {
    const s = projectStatusRank(a) - projectStatusRank(b);
    if (s !== 0) return s;
    // Başvurusu açık projelerde son tarihi en yakın olan (en acil) önce gelir.
    const da = a.data.applicationDeadline, db = b.data.applicationDeadline;
    if (projectStatusRank(a) === 0 && da && db && da !== db) return da < db ? -1 : 1;
    return newestProject(a, b);
  })
  .slice(0, 2);

// Etkinlik bölümü: yaklaşan varsa onlar, yoksa bölüm kaybolmasın diye
// en son yapılanlar gösterilir.
const todayMidnight = new Date();
todayMidnight.setHours(0, 0, 0, 0);
const eventDate = (event: (typeof events)[number]) => getEffectiveEventDate(event.data.date, {
  recurring: event.data.recurring,
  weekday: event.data.weekday,
  time: event.data.time,
  timezone: event.data.timezone,
});
const upcomingEvents = events
  .filter(e => e.data.recurring === 'weekly' || getEventDateSortKey(e.data.date) >= todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(eventDate(a)) - getEventDateSortKey(eventDate(b)));
const pastEvents = events
  .filter(e => e.data.recurring !== 'weekly' && getEventDateSortKey(e.data.date) < todayMidnight.getTime())
  .sort((a, b) => getEventDateSortKey(b.data.date) - getEventDateSortKey(a.data.date));
const showingUpcoming = upcomingEvents.length > 0;
const homeEvents = (showingUpcoming ? upcomingEvents : pastEvents).slice(0, 4);

const recentPosts = [...posts].sort(byNewest('posts', 'date')).slice(0, 3);

// Anasayfadaki bütün haberler, içerikte belirtilen tarihe göre yeniden eskiye sıralanır.
const newestNews = (a: (typeof news)[number], b: (typeof news)[number]) =>
  getEventDateSortKey(b.data.date) - getEventDateSortKey(a.data.date);
const sortedNews = [...news].sort(newestNews);
const leadNews = sortedNews[0];
const restNews = sortedNews.slice(1, 3);

// Hero slider News koleksiyonundan otomatik beslenir. Yeni haberler tarih sırasıyla görünür.
const heroNews = [...news]
  .filter(item => item.data.coverImage)
  .sort(newestNews)
  .slice(0, 5);

const featuredStories = [...stories]
  .sort((a, b) => getEventDateSortKey(b.data.startDate) - getEventDateSortKey(a.data.startDate))
  .slice(0, 6);



const affiliationRows = [
  { ...affiliations.networks, label: lang === 'en' ? affiliations.networks.label_en : affiliations.networks.label, direction: 'left' as const, duration: 75 },
  { ...affiliations.partners, label: lang === 'en' ? affiliations.partners.label_en : affiliations.partners.label, direction: 'right' as const, duration: 100 },
];

const heroSyllableColors = ['#2466c1', '#168b79', '#7c4dbd', '#d0567a', '#c48a12', '#0e8fb3', '#bd4029', '#5b5fd6'];

const heroMessage = lang === 'en'
  ? {
      line1: 'Europe.',
      line2: 'Volunteer.',
          rotating: [
        { text: 'Join In.', syllables: ['Join ', 'In.'] },
        { text: 'Create Together.', syllables: ['Cre', 'ate ', 'To', 'ge', 'ther.'] },
        { text: 'Take Part Equally.', syllables: ['Take ', 'Part ', 'E', 'qual', 'ly.'] },
        { text: 'For Everyone.', syllables: ['For ', 'Ev', 'ery', 'one.'] },
        { text: 'Every Voice Counts.', syllables: ['Ev', 'ery ', 'Voice ', 'Counts.'] },
        { text: 'Diversity Is Strength.', syllables: ['Di', 'ver', 'si', 'ty ', 'Is ', 'Strength.'] },
        { text: 'Break Barriers.', syllables: ['Break ', 'Bar', 'ri', 'ers.'] },
        { text: 'Grow Together.', syllables: ['Grow ', 'To', 'ge', 'ther.'] },
        { text: 'Code the Future.', syllables: ['Code ', 'the ', 'Fu', 'ture.'] },
        { text: 'Discover the World.', syllables: ['Dis', 'cov', 'er ', 'the ', 'World.'] },
        { text: 'Go Greener.', syllables: ['Go ', 'Green', 'er.'] },
        { text: 'Gather Experience.', syllables: ['Gath', 'er ', 'Ex', 'pe', 'ri', 'ence.'] },
        { text: 'Start the Journey.', syllables: ['Start ', 'the ', 'Jour', 'ney.'] },
        { text: 'From Kilis to Europe.', syllables: ['From ', 'Ki', 'lis ', 'to ', 'Eu', 'rope.'] },
        { text: 'Share Your Idea.', syllables: ['Share ', 'Your ', 'I', 'de', 'a.'] },
        { text: 'Find Your Courage.', syllables: ['Find ', 'Your ', 'Cour', 'age.'] },
        { text: 'Stronger Together.', syllables: ['Strong', 'er ', 'To', 'ge', 'ther.'] },
        { text: 'Start the Change.', syllables: ['Start ', 'the ', 'Change.'] },
      ],
      lead: 'From Kilis to Europe, volunteer, gain experience and discover the world through Erasmus+ and European Solidarity Corps opportunities.',
      primary: 'Explore Opportunities',
      secondary: 'Discover KOZ-DER',
      how: 'How can I join?',
      trust: ['Active since 2019', 'ESC Lead & Support Organisation', 'Volunteering across Europe'],
    }
  : {
      line1: 'Avrupa.',
      line2: 'Gönüllü Ol.',
            rotating: [
        { text: 'Sen de Katıl.', syllables: ['Sen ', 'de ', 'Ka', 'tıl.'] },
        { text: 'Birlikte Üret.', syllables: ['Bir', 'lik', 'te ', 'Ü', 'ret.'] },
        { text: 'Eşitçe Katıl.', syllables: ['E', 'şit', 'çe ', 'Ka', 'tıl.'] },
        { text: 'Herkes İçin.', syllables: ['Her', 'kes ', 'İ', 'çin.'] },
        { text: 'Sesini Duyur.', syllables: ['Se', 'si', 'ni ', 'Du', 'yur.'] },
        { text: 'Farklılık Güçtür.', syllables: ['Fark', 'lı', 'lık ', 'Güç', 'tür.'] },
        { text: 'Engelleri Aş.', syllables: ['En', 'gel', 'le', 'ri ', 'Aş.'] },
        { text: 'Dayanışmayla Büyü.', syllables: ['Da', 'ya', 'nış', 'may', 'la ', 'Bü', 'yü.'] },
        { text: 'Geleceği Kodla.', syllables: ['Ge', 'le', 'ce', 'ği ', 'Kod', 'la.'] },
        { text: 'Dünyayı Keşfet.', syllables: ['Dün', 'ya', 'yı ', 'Keş', 'fet.'] },
        { text: 'Yeşili Büyüt.', syllables: ['Ye', 'şi', 'li ', 'Bü', 'yüt.'] },
        { text: 'Deneyim Biriktir.', syllables: ['De', 'ne', 'yim ', 'Bi', 'rik', 'tir.'] },
        { text: 'Yolculuğa Çık.', syllables: ['Yol', 'cu', 'lu', 'ğa ', 'Çık.'] },
        { text: 'Kilis’ten Avrupa’ya.', syllables: ['Ki', 'lis’', 'ten ', 'Av', 'ru', 'pa’', 'ya.'] },
        { text: 'Fikrini Paylaş.', syllables: ['Fik', 'ri', 'ni ', 'Pay', 'laş.'] },
        { text: 'Cesaretini Topla.', syllables: ['Ce', 'sa', 're', 'ti', 'ni ', 'Top', 'la.'] },
        { text: 'Birlikte Güçlüyüz.', syllables: ['Bir', 'lik', 'te ', 'Güç', 'lü', 'yüz.'] },
        { text: 'Değişimi Başlat.', syllables: ['De', 'ği', 'şi', 'mi ', 'Baş', 'lat.'] },
      ],
      lead: "Kilis’ten Avrupa’ya uzanan Erasmus+ ve Avrupa Dayanışma Programı fırsatlarıyla gönüllü ol, deneyim kazan ve dünyayı keşfet.",
      primary: 'Fırsatları İncele',
      secondary: 'KOZ-DER’i Tanı',
      how: 'Nasıl katılırım?',
      trust: ['2019’dan beri aktif', 'ESC Lider ve Destek Kuruluşu', 'Avrupa çapında gönüllülük'],
    };

const steps = [
  { n: '01', title: t('home.steps.1.title'), text: t('home.steps.1.text'), href: path(lang, 'projects') },
  { n: '02', title: t('home.steps.2.title'), text: t('home.steps.2.text'), href: path(lang, 'faq') },
  { n: '03', title: t('home.steps.3.title'), text: t('home.steps.3.text'), href: path(lang, 'stories') },
];

// Kartlarda uzun proje adını kısa program etiketi olarak gösterir.
function storyProgramLabel(programName: string) {
  if (/Erasmus|The Power of Stories/i.test(programName)) return 'Erasmus+';
  if (/ESC|EVS|Avrupa Dayanışma|European Solidarity|gönüllül|volunteering|summer project|yaz dönemi projesi/i.test(programName)) return 'ESC';
  return programName;
}

// Etkinlik tarihini gün + kısaltılmış ay olarak parçalar.
function dateParts(value: string) {
  const key = getEventDateSortKey(value);
  if (!key) return { day: '·', month: '' };
  const d = new Date(key);
  return {
    day: String(d.getDate()).padStart(2, '0'),
    month: d.toLocaleDateString(lang === 'en' ? 'en-GB' : 'tr-TR', { month: 'short' }).replace('.', '').toUpperCase(),
  };
}

const copy = (tr: string, en: string) => lang === 'en' ? en : tr;
const newsTitle = (item: (typeof news)[number]) => lang === 'en' ? item.data.title_en : item.data.title_tr;
const profileCards = [
 {code:'KA1', css:'profile-ka1', description:copy('Gençlik hareketliliği projeleri için kurumsal profil, düzenli gençlik çalışmaları, kilit ekip, hareketlilik deneyimi ve ilişkili kişiler.','Organisation profile for youth mobility projects, including regular youth work, key team members, mobility experience and contact persons.')},
 {code:'KA2', css:'profile-ka2', description:copy('İş birliği ortaklıkları için temel faaliyetler, başvuru alanındaki deneyim, öğrenici profilleri, geçmiş katılım ve ortaklık kapasitesi.','Core activities, experience in the application field, learner profiles, past participation and partnership capacity for cooperation partnerships.')},
];
import { programLabel } from '../../utils/programLabel';
import { impactTotals } from '../../utils/impactTotals';
const tot = impactTotals();
const stats = [
  { value: String(tot.abroad), label: copy('gencimizi yurt dışına gönderdik', 'young people we sent abroad'), info: copy('ESC ve Erasmus+', 'ESC and Erasmus+') },
  { value: String(tot.esc), label: copy('gönüllü kendi ESC projelerimizle gitti', 'volunteers went through our own ESC projects'), info: copy('2021–2025', '2021–2025') },
  { value: String(tot.hosted), label: copy('genci Kilis’te ağırladık', 'young people hosted in Kilis'), info: copy('Erasmus+ gençlik değişimleri', 'Erasmus+ youth exchanges') },
  { value: '15+', label: copy('Avrupa’da ortak kuruluş', 'partner organisations in Europe'), info: copy('ESC ve Erasmus+ projelerinde', 'in ESC and Erasmus+ projects') },
  { value: String(tot.countries), label: copy('ülkeye genç gönderdik', 'countries we have sent young people to'), info: copy('Portekiz’den Fas’a, İzlanda’dan Gürcistan’a', 'From Portugal to Morocco, Iceland to Georgia') },
  { value: String(stories.length), label: t('home.stats.stories'), info: copy('Kendi anlatımlarıyla', 'In their own words') },
];
---
<BaseLayout lang={lang} title={p.meta.home.title} description={p.meta.home.description} alternate={alternatePath(lang,'home')}>
<div class="koz-glass" id="koz-glass" data-lang={lang}>
<section class="wrap hero hero-v2">
<div class="hv-top">
<div class="hv-title"><h1><span class="hv-l1">{heroMessage.line1}</span> <span class="red hv-l2">{heroMessage.line2}</span><span class="rotating" data-rotating-words={JSON.stringify(heroMessage.rotating)} data-rotating-colors={JSON.stringify(heroSyllableColors)} aria-label={heroMessage.rotating[0].text}>{heroMessage.rotating[0].syllables.map((s,i)=><span style={`--syllable:${heroSyllableColors[i%heroSyllableColors.length]}`}>{s}</span>)}</span></h1></div>
<div class="hv-side"><p class="lead">{heroMessage.lead}</p><div class="actions"><a href={path(lang,'projects')} class="action primary">{heroMessage.primary}</a><a href={path(lang,'about')} class="action">{heroMessage.secondary}</a></div><p class="trust">{heroMessage.trust.slice(0,2).join(' · ')}</p></div>
</div>
<div class="news hv-news" aria-roledescription="carousel" aria-label={copy('Son haberler','Latest news')}>
<div class="news-head hv-head"><div class="controls"><button type="button" data-prev aria-label={copy('Önceki haber','Previous news')}>←</button><button type="button" data-next aria-label={copy('Sonraki haber','Next news')}>→</button></div><div class="hv-dots" role="tablist" aria-label={copy('Haber seç','Choose news')}>{heroNews.map((_,i)=><button type="button" data-dot={String(i)} aria-label={`${i+1}`} aria-current={i===0?'true':'false'}></button>)}</div><span class="hv-label">{copy('KOZ-DER’DEN HABERLER','NEWS FROM KOZ-DER')}</span></div>
{heroNews.map((item,i)=><a class:list={['slide',i===0&&'active',item.data.coverFit==='contain'&&'poster-slide']} href={entryPath(lang,'news',stripLangPrefix(item.slug))} aria-hidden={i===0?'false':'true'} tabindex={i===0?0:-1}><img class="hv-bg" src={smallFor(item.data.coverImage,480)} alt="" aria-hidden="true" loading={i===0?'eager':'lazy'} /><img class="hv-img" src={item.data.coverImage} srcset={srcsetFor(item.data.coverImage)} sizes="100vw" alt={newsTitle(item)} loading={i===0?'eager':'lazy'} /><div class="news-copy"><span class="date">{formatEventDate(item.data.date,{lang})}</span><h3>{newsTitle(item)}</h3><span class="read">{copy('Haberi oku →','Read the news →')}</span></div></a>)}
</div></section>
<div class="wrap"><div class="stats glass" data-home-stats>{stats.map(s=><a class="stat" href={path(lang,'impact')}><i class="glass-sheen" aria-hidden="true"></i><i class="glass-glint" aria-hidden="true"></i><strong>{s.value}</strong><span>{s.label}</span><small>{s.info}</small></a>)}</div></div>
<section class="wrap entry" aria-label={copy('Nereden başlamak istersin?','Where would you like to start?')}>
  <p class="eyebrow">{copy('Nereden başlamak istersin?','Where would you like to start?')}</p>
  <div class="entry-grid">
    <article class="entry-card e-local">
      <span class="entry-ico" aria-hidden="true">🧩</span>
      <h2>{copy('Kilis’te katıl','Join in Kilis')}</h2>
      <p>{copy('Zekâ oyunları, robotik kodlama, Speaking Club, afet bilinci ve çevre çalışmaları. Ücretsiz ve herkese açık.','Mind games, robotic coding, Speaking Club, disaster awareness and environmental work. Free and open to all.')}</p>
      <div class="entry-links"><a class="entry-main" href={path(lang,'events')}>{copy('Etkinlik takvimi →','Event calendar →')}</a><a href={path(lang,'voice')}>{copy('Etkinlik öner','Suggest an activity')}</a></div>
    </article>
    <article class="entry-card e-abroad">
      <span class="entry-ico" aria-hidden="true">✈️</span>
      <h2>{copy('Yurt dışı fırsatları','Opportunities abroad')}</h2>
      <p>{copy('Erasmus+ gençlik değişimleri ve Avrupa Dayanışma Programı gönüllülüğü. Masrafların büyük kısmı program tarafından karşılanır.','Erasmus+ youth exchanges and European Solidarity Corps volunteering. Most costs are covered by the programme.')}</p>
      <div class="entry-links"><a class="entry-main" href={path(lang,'projects')}>{copy('Açık projeler →','Open projects →')}</a><a href="https://whatsapp.com/channel/0029Va6oBxc4NVis1wo8hl2N" target="_blank" rel="noopener noreferrer">{copy('WhatsApp kanalı','WhatsApp channel')}</a></div>
    </article>
    <article class="entry-card e-partner">
      <span class="entry-ico" aria-hidden="true">🤝</span>
      <h2>{copy('Bizimle ortak ol','Partner with us')}</h2>
      <p>{copy('Kurumlar, okullar ve Avrupa’daki kuruluşlar için: gençlik değişimleri, ESC ev sahipliği ve eğitim ortaklıkları.','For organisations, schools and partners across Europe: youth exchanges, ESC hosting and training partnerships.')}</p>
      <div class="entry-links"><a class="entry-main" href={path(lang,'contact')}>{copy('İletişime geç →','Get in touch →')}</a><a href="/documents/KOZ-DER_Partner_Profiles_KA1_KA2_2026.pdf" target="_blank" rel="noopener">{copy('KA1 + KA2 ortaklık profili (PDF)','KA1 + KA2 partner profile (PDF)')}</a></div>
    </article>
  </div>
</section>
<section class="wrap section"><div class="section-head"><div><p class="eyebrow">{copy('Sıradaki yolculuğun','Your next journey')}</p><h2>{t('home.projects.title')}</h2></div><a class="all" href={path(lang,'projects')}>{t('common.allProjects')}</a></div>
<div class="opps">{featuredProjects.map(project=><a class="opp glass" href={entryPath(lang,'projects',stripLangPrefix(project.slug))} data-featured-project data-project-static-status={project.data.status} data-project-start-date={project.data.startDate} data-project-deadline={project.data.applicationDeadline}>
{project.data.coverImage&&<img src={project.data.coverImage} srcset={srcsetFor(project.data.coverImage)} sizes="(max-width: 760px) 100vw, 50vw" alt={lang==='en'?project.data.title_en:project.data.title_tr} loading="lazy" />}<div class="opp-body"><div class="project-labels"><span class:list={['project-program',project.data.programType==='ESC'&&'esc',project.data.programType==='LOCAL'&&'local']}>{programLabel(project.data.programType,lang)}</span><span class="badge" data-featured-project-status data-open-label={t('common.open')} data-closed-label={t('projects.applicationClosed')}>{isProjectApplicationOpen(project.data)?t('common.open'):t('projects.applicationClosed')}</span></div><h3>{lang==='en'?project.data.title_en:project.data.title_tr}</h3><p class="meta">{project.data.location}<br />{formatEventDate(project.data.startDate,{lang})}{project.data.endDate&&` – ${formatEventDate(project.data.endDate,{lang})}`}</p><span class="read">{copy('Projeyi incele','Explore the project')}</span></div></a>)}</div></section>
<section class="wrap section"><div class="section-head"><div><p class="eyebrow">{copy('Gençlerin gözünden','Through young people’s eyes')}</p><h2>{copy('Sınırları aşan hikâyeler.','Stories beyond borders.')}</h2></div><a class="all" href={path(lang,'stories')}>{t('common.allStories')}</a></div>
<div class="story-controls"><button type="button" data-story-prev aria-label={copy('Önceki hikâyeler','Previous stories')}>←</button><button type="button" data-story-next aria-label={copy('Sonraki hikâyeler','Next stories')}>→</button><span class="story-counter" aria-live="polite"></span></div><div class="story-viewport"><div class="stories">
{featuredStories.map(story=><a class="story glass" href={entryPath(lang,'stories',stripLangPrefix(story.slug))}><div class="story-media">{story.data.images[0]&&<><img class="photo-backdrop" src={smallFor(story.data.images[0], 480)} alt="" aria-hidden="true" loading="lazy"/><img src={story.data.images[0]} srcset={srcsetFor(story.data.images[0])} sizes="(max-width: 760px) 100vw, 33vw" alt={story.data.name} loading="lazy" /></>}</div><h3>{story.data.name}</h3><div class="story-details"><span>{story.data.country}</span><span>{storyProgramLabel(story.data.programName)}</span></div><p>{story.data.summary}</p><span class="story-more">{copy('Hikâyeyi oku','Read the story')}</span></a>)}
</div></div></section>
<section class="wrap section"><p class="eyebrow">{copy('İlk projen mi?','Your first project?')}</p><h2>{copy('Üç adımda, Avrupa.','Europe in three steps.')}</h2><div class="steps">{steps.map(step=><a class="step glass" href={step.href}><strong>{step.n}</strong><h3>{step.title}</h3><p>{step.text}</p></a>)}</div></section>
<section class="wrap section dual"><div><p class="eyebrow">{copy('Bir araya gelelim','Let’s come together')}</p><h2>{copy('Etkinlik takvimi.','Event calendar.')}</h2><div class="events-list">
{homeEvents.map(event=>{const d=dateParts(eventDate(event));return <a class="event glass" href={entryPath(lang,'events',stripLangPrefix(event.slug))} data-recurring-event={event.data.recurring} data-start-date={event.data.date} data-weekday={event.data.weekday} data-time={event.data.time} data-timezone={event.data.timezone} data-lang={lang}><span class="event-date"><span data-event-day>{d.day}</span><small data-event-month>{d.month}</small></span><div><strong>{lang==='en'?event.data.title_en:event.data.title_tr}</strong><p>{event.data.time&&`${event.data.time} · `}{event.data.location}</p></div></a>;})}
</div><a class="all" style="display:inline-block;margin-top:18px" href={path(lang,'events')}>{t('common.allEvents')}</a></div>
<div><p class="eyebrow">{copy('Gündem','Updates')}</p><h2>{copy('Duyurular.','Announcements.')}</h2>{recentPosts.map(post=><a class="announcement" href={entryPath(lang,'posts',stripLangPrefix(post.slug))}>{lang==='en'?post.data.title_en:post.data.title_tr}</a>)}</div></section>
<section class="logos" aria-label={t('home.affiliations.title')}>{affiliationRows.map(row=><div><p class="logo-label">{row.label}</p><LogoMarquee lang={lang} label={row.label} items={row.items} direction={row.direction} duration={row.duration}/></div>)}</section>
