<script>
  function initHeroNewsSliders() {
    document.querySelectorAll('[data-hero-news-slider]').forEach((slider) => {
      if (!(slider instanceof HTMLElement) || slider.dataset.initialized === 'true') return;
      slider.dataset.initialized = 'true';

      const slides = Array.from(slider.querySelectorAll('[data-hero-news-slide]'));
      const dots = Array.from(slider.querySelectorAll('[data-hero-news-dot]'));
      if (slides.length < 2) return;

      let current = 0;
      let timer;

      const show = (nextIndex) => {
        current = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, index) => {
          const active = index === current;
          slide.setAttribute('data-active', String(active));
          slide.setAttribute('aria-hidden', String(!active));
          if (slide instanceof HTMLElement) slide.tabIndex = active ? 0 : -1;
          dots[index]?.setAttribute('data-active', String(active));
        });
      };

      const start = () => {
        window.clearInterval(timer);
        timer = window.setInterval(() => show(current + 1), 10000);
      };

      slider.querySelector('[data-hero-news-prev]')?.addEventListener('click', () => {
        show(current - 1);
        start();
      });
      slider.querySelector('[data-hero-news-next]')?.addEventListener('click', () => {
        show(current + 1);
        start();
      });
      slider.addEventListener('mouseenter', () => window.clearInterval(timer));
      slider.addEventListener('mouseleave', start);
      slider.addEventListener('focusin', () => window.clearInterval(timer));
      slider.addEventListener('focusout', start);
      start();
    });
  }


  function initHeroRotatingText() {
    document.querySelectorAll('[data-hero-rotating]').forEach((element) => {
      if (!(element instanceof HTMLElement) || element.dataset.rotatingInitialized === 'true') return;
      element.dataset.rotatingInitialized = 'true';

      let words = [];
      try {
        words = JSON.parse(element.dataset.rotatingWords || '[]');
      } catch {
        return;
      }
      if (words.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let index = 0;
      window.setInterval(() => {
        element.classList.add('is-changing');
        window.setTimeout(() => {
          index = (index + 1) % words.length;
          const item = words[index];
          element.textContent = typeof item === 'string' ? item : item.text;
          if (typeof item === 'object' && item?.color) element.style.color = item.color;
          element.classList.remove('is-changing');
        }, 220);
      }, 3000);
    });
  }

  document.addEventListener('astro:page-load', initHeroNewsSliders);
  document.addEventListener('astro:page-load', initHeroRotatingText);
  initHeroNewsSliders();
  initHeroRotatingText();
</script>

<style>
  .hero-rotating-line {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 220ms ease, transform 220ms ease, color 320ms ease;
  }
  .hero-rotating-line.is-changing {
    opacity: 0;
    transform: translateY(0.12em);
  }

  .hero-news-slide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 700ms ease, visibility 700ms ease;
  }
  .hero-news-slide[data-active='true'] {
    opacity: 1;
    visibility: visible;
