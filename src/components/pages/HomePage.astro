<script>
  import { isProjectApplicationOpen } from '../../utils/projectApplications';
  function syncOpportunities() {
    let count = 0;
    document.querySelectorAll<HTMLElement>('[data-home-opportunity]').forEach(item => {
      const status = item.dataset.projectStaticStatus;
      if (status !== 'Aktif' && status !== 'Tamamlandı') return;
      const open = isProjectApplicationOpen({ status, startDate: item.dataset.projectStartDate ?? '', applicationDeadline: item.dataset.projectDeadline });
      item.hidden = !open || count >= 3;
      if (open) count++;
    });
    const empty = document.querySelector<HTMLElement>('[data-home-empty]');
    if (empty) empty.hidden = count > 0;
  }
  syncOpportunities();
  window.setInterval(syncOpportunities, 60_000);
</script>
