  }
  @media (prefers-reduced-motion: reduce) {
    .hero-news-slide { transition: none; }
  }

  /* Hikaye şeridi: kaydırma çubuğu gizli, parmakla/trackpad ile akıcı */
  .story-rail {
    scroll-snap-type: x proximity;
