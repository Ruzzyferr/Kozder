<script>
  import { initSequence } from '../../scripts/countup';
  document.querySelectorAll('[data-home-stats] .stat').forEach(el => el.classList.add('seq'));
  initSequence('[data-home-stats]', 'strong', 150, 1200);
import { isProjectApplicationOpen } from '../../utils/projectApplications';
  function syncFeaturedProjects() {
    document.querySelectorAll<HTMLElement>('[data-featured-project]').forEach(item => {
      const status = item.dataset.projectStaticStatus;
      if (status !== 'Aktif' && status !== 'Tamamlandı') return;
      const open = isProjectApplicationOpen({
        status,
        startDate: item.dataset.projectStartDate ?? '',
        applicationDeadline: item.dataset.projectDeadline,
      });
      const badge = item.querySelector<HTMLElement>('[data-featured-project-status]');
      if (!badge) return;
      badge.textContent = open ? badge.dataset.openLabel ?? '' : badge.dataset.closedLabel ?? '';
      badge.classList.toggle('border-brand-stamp', open);
      badge.classList.toggle('text-brand-stamp', open);
      badge.classList.toggle('border-line-strong', !open);
      badge.classList.toggle('text-ink-muted', !open);
    });
  }

  syncFeaturedProjects();
setInterval(syncFeaturedProjects,60000);
</script>
<script>
const root=document.getElementById('koz-glass');
if(root){
 const reduced=matchMedia('(prefers-reduced-motion:reduce)').matches;
 const target=root.querySelector<HTMLElement>('.rotating');const fitSlogan=()=>{if(!target)return;const mobile=matchMedia('(max-width:900px)').matches;let avail=0;if(mobile){const box=target.closest('.hv-top') as HTMLElement|null;avail=box?box.clientWidth:target.clientWidth;}else{const h=target.closest('h1');const a=h?.querySelector('.hv-l1');const b=h?.querySelector('.hv-l2');if(a&&b){const r0=document.createRange();r0.setStartBefore(a);r0.setEndAfter(b);avail=r0.getBoundingClientRect().width;}}if(!avail)return;target.style.fontSize='40px';const rg=document.createRange();rg.selectNodeContents(target);const w=rg.getBoundingClientRect().width;if(w>0){const max=mobile?72:130;let f=Math.max(24,Math.min(max,40*avail/w*0.97));target.style.fontSize=f+'px';const w2=rg.getBoundingClientRect().width;if(w2>avail){f=Math.max(24,f*avail/w2*0.99);target.style.fontSize=f+'px';}}};fitSlogan();addEventListener('resize',fitSlogan);if(document.fonts)document.fonts.ready.then(fitSlogan);
 if(target){const words=JSON.parse(target.dataset.rotatingWords||'[]');const colors=JSON.parse(target.dataset.rotatingColors||'[]');let word=0;if(!reduced)setInterval(()=>{word=(word+1)%words.length;target.replaceChildren(...words[word].syllables.map((text:string,i:number)=>{const span=document.createElement('span');span.textContent=text;span.style.setProperty('--syllable',colors[i%colors.length]);return span;}));target.setAttribute('aria-label',words[word].text);fitSlogan();},3200);}
 const slides=Array.from(root.querySelectorAll<HTMLElement>('.slide'));let newsIndex=0;const showNews=(n:number)=>{if(!slides.length)return;newsIndex=(n+slides.length)%slides.length;slides.forEach((slide,i)=>{const active=i===newsIndex;slide.classList.toggle('active',active);slide.setAttribute('aria-hidden',String(!active));slide.tabIndex=active?0:-1;});root.querySelectorAll('[data-dot]').forEach((d,i)=>d.setAttribute('aria-current',String(i===newsIndex)));};root.querySelectorAll<HTMLElement>('[data-dot]').forEach(d=>d.addEventListener('click',()=>showNews(Number(d.dataset.dot))));root.querySelector('[data-prev]')?.addEventListener('click',()=>showNews(newsIndex-1));root.querySelector('[data-next]')?.addEventListener('click',()=>showNews(newsIndex+1));let newsPause=false;const news=root.querySelector('.news');news?.addEventListener('pointerenter',()=>newsPause=true);news?.addEventListener('pointerleave',()=>newsPause=false);if(!reduced)setInterval(()=>{if(!newsPause&&!news?.contains(document.activeElement)&&!document.hidden)showNews(newsIndex+1);},6500);
 const track=root.querySelector<HTMLElement>('.stories');const viewport=root.querySelector<HTMLElement>('.story-viewport');const cards=Array.from(track?.children||[]) as HTMLElement[];const prev=root.querySelector<HTMLButtonElement>('[data-story-prev]');const next=root.querySelector<HTMLButtonElement>('[data-story-next]');const counter=root.querySelector('.story-counter');let index=0;
 const visible=()=>matchMedia('(max-width:520px)').matches?1:matchMedia('(max-width:760px)').matches?2:3;
 const update=()=>{if(!track||!cards.length)return;const count=Math.min(visible(),cards.length);index=Math.max(0,Math.min(index,cards.length-count));track.style.transform=`translateX(${-index*(cards[0].getBoundingClientRect().width+24)}px)`;if(prev)prev.disabled=index===0;if(next)next.disabled=index>=cards.length-count;if(counter)counter.textContent=`${index+1}–${index+count} / ${cards.length} ${root.dataset.lang==='en'?'stories':'hikâye'}`;cards.forEach((card,i)=>card.inert=i<index||i>=index+count);};prev?.addEventListener('click',()=>{index--;update();});next?.addEventListener('click',()=>{index++;update();});let start:number|null=null;viewport?.addEventListener('pointerdown',e=>start=e.clientX);viewport?.addEventListener('pointerup',e=>{if(start!==null&&Math.abs(e.clientX-start)>50){index+=e.clientX<start?1:-1;update();}start=null;});viewport?.addEventListener('pointercancel',()=>start=null);if(viewport)new ResizeObserver(update).observe(viewport);update();
}
</script>

