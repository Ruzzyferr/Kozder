---
import { useTranslations, path, type Lang } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import fin from '../../data/finances.json';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const en = lang === 'en';
const c = (tr: string, enText: string) => (en ? enText : tr);

const nf = new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const tl = (n: number) => `${nf.format(n)} TL`;
const short = (n: number) => {
  const f = new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { maximumFractionDigits: 1 });
  if (n >= 1e6) return `${f.format(n / 1e6)} ${en ? 'm' : 'milyon'} TL`;
  if (n >= 1e3) return `${f.format(n / 1e3)} ${en ? 'k' : 'bin'} TL`;
  return `${f.format(n)} TL`;
};

const incomeCats = [
  { key: 'public', label: c('Kamu kurumları ve Ulusal Ajans hibeleri', 'Public bodies and National Agency grants'), color: '#2857a1' },
  { key: 'abroad', label: c('Yurt dışındaki ortak kuruluşlardan', 'From partner organisations abroad'), color: '#3f8f6b' },
  { key: 'financial', label: c('Finansal gelirler (faiz ve kur)', 'Financial income (interest and exchange)'), color: '#e0a32e' },
  { key: 'other', label: c('Diğer gelirler', 'Other income'), color: '#7a5aa6' },
  { key: 'donations', label: c('Bağışlar', 'Donations'), color: '#d0567a' },
  { key: 'dues', label: c('Üye aidatları', 'Membership dues'), color: '#6b7a8c' },
] as const;
const expenseCats = [
  { key: 'mission', label: c('Amaç ve hizmet giderleri', 'Programme spending'), color: '#bd4029' },
  { key: 'general', label: c('Genel giderler', 'General costs'), color: '#e07a5f' },
  { key: 'staff', label: c('Personel ve proje eğitmenleri', 'Staff and project trainers'), color: '#b07a12' },
  { key: 'other', label: c('Diğer giderler', 'Other spending'), color: '#8a6d5c' },
] as const;

const pct = (a: number, total: number) => { const v = (a / total) * 100; return v > 0 && v < 1 ? '<%1' : `%${Math.round(v)}`; };

const years = (fin.years as any[]).map(y => {
  const inc = incomeCats.map(k => ({ ...k, amount: y.income[k.key] as number })).filter(r => r.amount > 0);
  const exp = expenseCats.map(k => ({ ...k, amount: y.expense[k.key] as number })).filter(r => r.amount > 0);
  const incTotal = inc.reduce((a, r) => a + r.amount, 0);
  const expTotal = exp.reduce((a, r) => a + r.amount, 0);
  return { ...y, inc, exp, incTotal, expTotal };
});

const title = c('Yıllara göre mali tablolar', 'Financial statements by year');
const intro = c(
  'Derneğe her yıl ne kadar para girdi, nereden geldi ve hangi kategorilerde harcandı.',
  'How much money came in each year, where it came from and how it was spent, by category.',
);
---

<BaseLayout lang={lang} title={`${title} — KOZ-DER`} description={intro} alternate={en ? '/etki-ve-seffaflik/mali-tablolar' : '/en/impact-and-transparency/financial-statements'}>
  <Breadcrumb
    lang={lang}
    kicker={c('Mali şeffaflık', 'Financial transparency')}
    items={[
      { label: t('nav.home'), href: path(lang, 'home') },
      { label: c('Etki ve Şeffaflık', 'Impact and Transparency'), href: path(lang, 'impact') },
      { label: title, href: en ? '/en/impact-and-transparency/financial-statements' : '/etki-ve-seffaflik/mali-tablolar' },
    ]}
    pageTitle={title}
    intro={intro}
  />

  <div class="container mx-auto px-4 py-10 sm:py-16">
    <p class="max-w-3xl leading-relaxed text-ink-soft">{en ? fin.note_en : fin.note_tr}</p>

    <nav class="year-nav mt-6" aria-label={c('Yıllar', 'Years')}>
      {years.map(y => <a href={`#y${y.year}`}>{y.year}</a>)}
    </nav>

    <div class="mt-10 space-y-10">
      {years.map(y => (
        <section id={`y${y.year}`} class="fin-year-card" aria-labelledby={`h${y.year}`}>
          <div class="fy-head">
            <h2 id={`h${y.year}`} class="fy-title">{y.year}</h2>
            <div class="fy-stats">
              <div class="fy-stat" tabindex="0"><span>{c('Yıl içi gelir', 'Income in year')}</span><strong class="inc">{short(y.incTotal)}</strong></div>
              <div class="fy-stat" tabindex="0"><span>{c('Gider', 'Spending')}</span><strong class="exp">{short(y.expTotal)}</strong></div>
              <div class="fy-stat" tabindex="0"><span>{c('Yıl sonu bakiye', 'Year-end balance')}</span><strong>{short(y.balance)}</strong></div>
            </div>
          </div>

          <div class="grid gap-8 lg:grid-cols-2">
            <div>
              <h3 class="fy-sub">{c('Gelir nereden geldi?', 'Where the income came from')}</h3>
              {y.incTotal > 0 ? (
                <>
                  <div class="spend-bar" role="img" aria-label={y.inc.map(r => `${r.label}: ${Math.round((r.amount / y.incTotal) * 100)}%`).join(', ')}>
                    {y.inc.map(r => <span style={`width:${(r.amount / y.incTotal) * 100}%;background:${r.color}`}></span>)}
                  </div>
                  <ul class="fy-list">
                    {y.inc.map(r => (
                      <li><i style={`background:${r.color}`}></i><span class="lbl">{r.label}</span><b>{tl(r.amount)}</b><em>{pct(r.amount, y.incTotal)}</em></li>
                    ))}
                  </ul>
                </>
              ) : <p class="text-sm text-ink-soft">{c('Bu yıl yeni gelir kaydı yok.', 'No new income recorded this year.')}</p>}
              <p class="mt-3 text-xs text-ink-soft">{c('Önceki yıldan devreden', 'Carried over from previous year')}: {tl(y.carry)}</p>
            </div>

            <div>
              <h3 class="fy-sub">{c('Para nereye harcandı?', 'Where the money went')}</h3>
              <div class="spend-bar" role="img" aria-label={y.exp.map(r => `${r.label}: ${Math.round((r.amount / y.expTotal) * 100)}%`).join(', ')}>
                {y.exp.map(r => <span style={`width:${(r.amount / y.expTotal) * 100}%;background:${r.color}`}></span>)}
              </div>
              <ul class="fy-list">
                {y.exp.map(r => (
                  <li><i style={`background:${r.color}`}></i><span class="lbl">{r.label}</span><b>{tl(r.amount)}</b><em>{pct(r.amount, y.expTotal)}</em></li>
                ))}
              </ul>
              {y.expenseNote && <p class="mt-3 text-xs text-ink-soft">{en ? y.expenseNote.en : y.expenseNote.tr}</p>}
            </div>
          </div>

          {(y.publicItems.length > 0 || y.abroadOutTotal > 0) && (
            <div class="mt-8 grid gap-4 lg:grid-cols-2">
              {y.publicItems.length > 0 && (
                <div class="fy-box">
                  <h3 class="fy-sub">{c('Kamu destekleri', 'Public funding')}</h3>
                  <ul class="space-y-2 text-sm">
                    {y.publicItems.map((p: any) => <li class="flex justify-between gap-4"><span>{en ? p.en : p.tr}</span><b class="whitespace-nowrap">{tl(p.amount)}</b></li>)}
                  </ul>
                </div>
              )}
              {y.abroadOutTotal > 0 && (
                <div class="fy-box">
                  <h3 class="fy-sub">{c('Yurt dışındaki ortaklara aktarılan', 'Transferred to partners abroad')}</h3>
                  <p class="font-display text-3xl font-black text-brand-ink">{tl(y.abroadOutTotal)}</p>
                  <p class="mt-2 text-sm text-ink-soft">{c(`${y.abroadOutCount} ödeme. Gönüllülerimizi ağırlayan ev sahibi kuruluşlara proje kapsamında aktarılan kurumsal destek payları; bu tutar yukarıdaki giderlerin içindedir.`, `${y.abroadOutCount} payments. Organisational support shares transferred to the host organisations receiving our volunteers; included in the spending above.`)}</p>
                </div>
              )}
            </div>
          )}

          <p class="mt-6 text-xs text-ink-soft">{c('Yıl sonu üye sayısı', 'Members at year end')}: <b>{y.members}</b></p>
        </section>
      ))}
    </div>

    <p class="mt-12 max-w-3xl text-sm text-ink-soft">{c('Beyannamelerin tamamı üyelerin kimlik numaraları ve banka hesap bilgilerini içerdiği için yayımlanmaz. Belgeleri incelemek isteyen kurumlar bilgi@kozder.com adresinden talep edebilir.', 'The full declarations contain members’ ID numbers and bank details, so they are not published. Organisations wishing to review them can request them at bilgi@kozder.com.')}</p>
    <p class="mt-4"><a class="font-bold text-brand-stamp underline" href={path(lang, 'impact')}>{c('← Etki ve Şeffaflık', '← Impact and Transparency')}</a></p>
  </div>
</BaseLayout>

<style>
  .year-nav { display: flex; flex-wrap: wrap; gap: .5rem; position: sticky; top: calc(env(safe-area-inset-top, 0px) + 5rem); z-index: 5; }
  .year-nav a { padding: .45rem 1rem; border-radius: 999px; font-weight: 700; color: #202936; background: rgba(255,255,255,.7); border: 1px solid rgba(32,41,54,.12); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); transition: transform .2s ease, background .2s ease; }
  .year-nav a:hover, .year-nav a:focus-visible { transform: translateY(-2px); background: #fff; }
  .fin-year-card { scroll-margin-top: 9rem; position: relative; border-radius: 2rem; padding: 1.5rem; background: linear-gradient(150deg, rgba(243,246,252,.95), rgba(251,246,242,.95)); border: 1px solid #e3e9f2; box-shadow: 0 24px 50px -30px rgba(32,41,54,.35); }
  @media (min-width: 640px) { .fin-year-card { padding: 2.5rem; } }
  .fy-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; }
  .fy-title { font-family: 'Bricolage Grotesque', Arial, sans-serif; font-weight: 800; font-size: clamp(2.6rem, 6vw, 4rem); line-height: .9; letter-spacing: -0.04em; color: #202936; }
  .fy-stats { display: flex; flex-wrap: wrap; gap: .75rem; }
  .fy-stat { min-width: 9.5rem; padding: .8rem 1rem; border-radius: 1.1rem; background: rgba(255,255,255,.65); border: 1px solid rgba(255,255,255,.9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 14px 30px -20px rgba(32,41,54,.35); transition: transform .3s cubic-bezier(.2,.8,.2,1); outline: none; }
  .fy-stat:hover, .fy-stat:focus-visible { transform: translateY(-4px) scale(1.04); }
  .fy-stat:focus-visible { box-shadow: 0 0 0 3px #bd4029; }
  .fy-stat span { display: block; font-size: .75rem; color: #4a586b; }
  .fy-stat strong { display: block; margin-top: .2rem; font-family: 'Bricolage Grotesque', Arial, sans-serif; font-weight: 800; font-size: 1.45rem; color: #202936; white-space: nowrap; }
  .fy-stat strong.inc { color: #2f7d58; } .fy-stat strong.exp { color: #bd4029; }
  .fy-sub { font-family: 'Bricolage Grotesque', Arial, sans-serif; font-weight: 800; font-size: 1.15rem; color: #202936; margin-bottom: .8rem; }
  .spend-bar { display: flex; height: 18px; border-radius: 999px; overflow: hidden; background: rgba(32,41,54,.08); }
  .spend-bar span { height: 100%; }
  .fy-list { margin-top: .9rem; display: grid; gap: .45rem; }
  .fy-list li { display: grid; grid-template-columns: .75rem 1fr auto 2.8rem; align-items: center; gap: .7rem; padding: .5rem .75rem; border-radius: .8rem; background: rgba(255,255,255,.6); font-size: .92rem; color: #202936; }
  .fy-list i { width: .75rem; height: .75rem; border-radius: 50%; flex-shrink: 0; }
  .fy-list b { white-space: nowrap; }
  .fy-list em { width: 2.8rem; text-align: right; font-style: normal; font-size: .82rem; color: #4a586b; }
  .fy-box { padding: 1.25rem; border-radius: 1.25rem; background: rgba(255,255,255,.6); border: 1px solid rgba(255,255,255,.9); }
  @media (max-width: 560px) {
    .fy-list li { grid-template-columns: .75rem 1fr auto; row-gap: .2rem; }
    .fy-list .lbl { grid-column: 2 / 4; }
    .fy-list b { grid-column: 2; grid-row: 2; }
    .fy-list em { grid-column: 3; grid-row: 2; }
    .fy-stats { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .fy-stat { min-width: 0; padding: .65rem .7rem; }
    .fy-stat strong { font-size: 1.05rem; white-space: normal; }
  }
  @media (prefers-reduced-motion: reduce) { .fy-stat, .year-nav a { transition: none; } .fy-stat:hover, .fy-stat:focus-visible { transform: none; } }
</style>
