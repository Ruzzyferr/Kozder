---
import { useTranslations, usePage, path, alternatePath, type Lang } from '../../i18n';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const p = usePage(lang);

import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const english = lang === 'en';
const channels = [
  { title: p.contact.phone, value: '+90 551 197 29 97', href: 'tel:+905511972997' },
  { title: p.contact.email, value: 'bilgi@kozder.com', href: 'mailto:bilgi@kozder.com' },
  { title: 'WhatsApp', value: p.contact.whatsappDesc, href: 'https://wa.me/905511972997', external: true },
  { title: p.contact.allLinks, value: p.contact.allLinksDesc, href: path(lang, 'links') },
];
---

<BaseLayout
  lang={lang}
  title={p.meta.contact.title}
  description={p.meta.contact.description}
  alternate={alternatePath(lang, 'contact')}
>
  <Breadcrumb
    lang={lang}
    kicker={t('contact.kicker')}
    items={[{ label: t('nav.home'), href: path(lang, 'home') }, { label: t('nav.contact'), href: path(lang, 'contact') }]}
    pageTitle={p.head.contact.pageTitle}
    intro={p.head.contact.intro}
  />

  <div class="container mx-auto px-4 py-12 sm:py-20">
    <section class="contact-form-card card p-6 sm:p-10 mb-12" aria-labelledby="write-heading">
      <div class="mb-7">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-3">KOZ·DER</p>
        <h2 id="write-heading" class="font-display font-black text-3xl sm:text-4xl tracking-tightest text-brand-ink mb-3">{english ? 'Write to us.' : 'Bize yazın.'}</h2>
        <p class="text-ink-soft">{english ? 'Have a question or an idea? Send us a message. We will reply to your email address.' : 'Bir sorunuz veya fikriniz mi var? Mesajınızı iletin; e-posta adresiniz üzerinden size dönüş yapalım.'}</p>
      </div>
      <form action="https://formsubmit.co/bilgi@kozder.com" method="POST" class="grid sm:grid-cols-2 gap-5">
        <input type="hidden" name="_subject" value="KOZ-DER | Web sitesi iletişim formu" />
        <input type="hidden" name="_template" value="table" />
        <input type="hidden" name="_url" value={english ? 'https://kozder.com/en/contact' : 'https://kozder.com/iletisim'} />
        <div class="contact-honey" aria-hidden="true"><label>Leave this field empty<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label></div>
        <label class="contact-field">{english ? 'Full name' : 'Ad soyad'}<input name="name" type="text" autocomplete="name" required maxlength="120" /></label>
        <label class="contact-field">{english ? 'Email address' : 'E-posta adresi'}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
        <label class="contact-field">{english ? 'Phone (optional)' : 'Telefon (isteğe bağlı)'}<input name="phone" type="tel" autocomplete="tel" maxlength="40" /></label>
        <label class="contact-field">{english ? 'Subject' : 'Konu'}<input name="subject" type="text" required maxlength="160" /></label>
        <label class="contact-field sm:col-span-2">{english ? 'Your message' : 'Mesajınız'}<textarea name="message" rows="5" required minlength="10" maxlength="5000"></textarea></label>
        <div class="sm:col-span-2 flex flex-col sm:flex-row sm:items-center gap-5">
          <button type="submit" class="bg-brand-stamp text-white font-bold px-7 py-3 self-start">{english ? 'Send message →' : 'Mesajı gönder →'}</button>
          <p class="text-sm text-ink-soft">{english ? 'Your message is sent to bilgi@kozder.com through FormSubmit. After the security check, you will see the submission confirmation.' : 'Mesajınız FormSubmit aracılığıyla bilgi@kozder.com adresine iletilir. Güvenlik kontrolünden sonra gönderim onayını göreceksiniz.'}</p>
        </div>
        <p class="sm:col-span-2 text-xs text-ink-soft">{english ? 'We use the contact details you provide to respond to your message. Please do not include sensitive personal information.' : 'Paylaştığınız iletişim bilgilerini mesajınıza yanıt vermek için kullanırız. Lütfen hassas kişisel bilgiler eklemeyin.'} <a href={path(lang, 'privacy')} class="underline">{english ? 'Privacy notice' : 'KVKK aydınlatma metni'}</a></p>
      </form>
    </section>
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-7">
        <h2 class="font-display font-black text-3xl sm:text-4xl tracking-tightest text-brand-ink mb-8 leading-none">{p.contact.reachHeading}</h2>

        <div class="grid sm:grid-cols-2 gap-0 card card-2 bg-brand-cream mb-8">
          {channels.map((c, i) => (
            <a
              href={c.href}
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener noreferrer' : undefined}
              class={`p-5 sm:p-6 bg-brand-cream hover:bg-brand-paper transition-colors group ${i % 2 === 0 ? 'border-b sm:border-r border-brand-ink' : 'border-b border-brand-ink'} ${i >= channels.length - 2 ? 'last:border-b-0 sm:border-b-0' : ''}`}
            >
              <p class="font-display font-bold text-2xl text-brand-ink leading-tight tracking-tight mb-1 flex items-center justify-between">
                {c.title}
                <span class="text-brand-walnut group-hover:text-brand-stamp group-hover:translate-x-1 transition-all">→</span>
              </p>
              <p class="text-sm text-ink-soft">{c.value}</p>
            </a>
          ))}
        </div>

        <div class="bg-brand-ink text-brand-cream p-6 sm:p-8 card card-2">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-postage mb-2">{p.contact.postalLabel}</p>
          <address class="not-italic font-display text-2xl text-brand-cream leading-snug">
            Kazım Karabekir Mahallesi<br/>
            İstiklal Caddesi No: 33D<br/>
            <span class="text-brand-postage">79000 Kilis · Türkiye</span>
          </address>
        </div>
      </div>

      <div class="lg:col-span-5">
        <h2 class="font-display font-black text-3xl sm:text-4xl tracking-tightest text-brand-ink mb-8 leading-none">{p.contact.findHeading}</h2>

        <div class="overflow-hidden bg-brand-cream card card-2">
          <div style="height: 460px;">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d25589.311481315584!2d37.06849013486292!3d36.70661280185717!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x152fcfe799ba80e3%3A0x3a77b95cb782f824!2sGen%C3%A7lik%20Zeka%20Oyunlar%C4%B1%20ve%20Kodlama%20Derne%C4%9Fi!5e0!3m2!1str!2str!4v1766867201155!5m2!1str!2str"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={p.contact.mapTitle}
            ></iframe>
          </div>
          <div class="px-4 py-3 border-t border-line bg-brand-cream text-right">
            <a href="https://www.google.com/maps/search/?api=1&query=Kazım+Karabekir+İstiklal+Caddesi+No33D+Kilis" target="_blank" rel="noopener noreferrer" class="inline-flex items-center py-2 text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-ink hover:text-brand-stamp transition-colors">{p.contact.mapsOpen}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
.contact-form-card{border-radius:24px}
.contact-field{display:flex;flex-direction:column;gap:9px;font-size:14px;font-weight:600;color:#334155}
.contact-field input,.contact-field textarea{width:100%;padding:13px 15px;font:inherit;font-weight:400;color:#202936;border:1px solid #c5d3e5;border-radius:12px;background:#ffffffb8;transition:border-color .2s,box-shadow .2s}
.contact-field textarea{resize:vertical;min-height:150px}
.contact-field input:focus,.contact-field textarea:focus{outline:2px solid #bd4029;outline-offset:2px;box-shadow:0 0 0 5px #bd402912}
.contact-honey{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
</style>
