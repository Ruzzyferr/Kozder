<script>
  // Sayılar görünür olduğunda bir kez sıfırdan hedefe sayar. Sunucu çıktısı zaten
  // son değeri içerir; JS yoksa veya hareket azaltılmışsa sayılar olduğu gibi kalır.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector('[data-countup-root]');
  if (root && !reduce && 'IntersectionObserver' in window) {
    const fmt = (el: HTMLElement, n: number) =>
      new Intl.NumberFormat(el.dataset.lang === 'en' ? 'en-IE' : 'tr-TR').format(Math.round(n));
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.countup);
      const start = performance.now();
      const dur = 1400;
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / dur);
        el.textContent = fmt(el, target * (1 - Math.pow(1 - p, 3)));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        run(e.target as HTMLElement);
      });
    }, { threshold: 0.6 });
    root.querySelectorAll<HTMLElement>('[data-countup]').forEach(el => {
      el.textContent = fmt(el, 0);
      io.observe(el);
    });
  }

  // Gönüllü hikâyeleri: 3'erli gruplar halinde belirli aralıkla döner, üzerine gelince durur.
  const rot = document.querySelector<HTMLElement>('[data-story-rotator]');
  if (rot && !reduce) {
    const cards = Array.from(rot.querySelectorAll<HTMLElement>('[data-story]'));
    const per = () => (window.matchMedia('(min-width: 768px)').matches ? 3 : 1);
    let start = 0;
    let paused = false;
    const show = () => {
      const n = per();
      cards.forEach((card, i) => {
        const on = ((i - start + cards.length) % cards.length) < n;
        card.classList.toggle('is-on', on);
        card.toggleAttribute('aria-hidden', !on);
        card.tabIndex = on ? 0 : -1;
        if (on && card.dataset.bg && !card.style.getPropertyValue('--bg')) card.style.setProperty('--bg', `url('${card.dataset.bg}')`);
      });
    };
    const next = () => { if (paused || cards.length <= per()) return; start = (start + per()) % cards.length; show(); };
    rot.addEventListener('mouseenter', () => (paused = true));
    rot.addEventListener('mouseleave', () => (paused = false));
    rot.addEventListener('focusin', () => (paused = true));
    rot.addEventListener('focusout', () => (paused = false));
    show();
    window.setInterval(next, Number(rot.dataset.interval) || 5500);
  }
</script>
