  // Gönüllü hikâyeleri: 3'erli gruplar halinde belirli aralıkla döner, üzerine gelince durur.
  const rot = document.querySelector<HTMLElement>('[data-story-rotator]');
  if (rot && !reduce) {
    const cards = Array.from(rot.querySelectorAll<HTMLElement>('[data-story]'));
    const per = () => (window.matchMedia('(min-width: 768px)').matches ? 3 : 1);
    let start = 0;
    let paused = false;
    const show = () => {
      const n = per();
      cards.forEach((card, i) => {
        const on = ((i - start + cards.length) % cards.length) < n;
        card.classList.toggle('is-on', on);
        card.toggleAttribute('aria-hidden', !on);
        card.tabIndex = on ? 0 : -1;
        if (on && card.dataset.bg && !card.style.getPropertyValue('--bg')) card.style.setProperty('--bg', `url('${card.dataset.bg}')`);
      });
    };
    const next = () => { if (paused || cards.length <= per()) return; start = (start + per()) % cards.length; show(); };
    rot.addEventListener('mouseenter', () => (paused = true));
    rot.addEventListener('mouseleave', () => (paused = false));
    rot.addEventListener('focusin', () => (paused = true));
    rot.addEventListener('focusout', () => (paused = false));
    show();
    window.setInterval(next, Number(rot.dataset.interval) || 5500);
  }
</script>
