---
import { useTranslations, path, alternatePath, entryPath, stripLangPrefix, type Lang } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getEventDateSortKey } from '../../utils/date';
import impact from '../../data/impact.json';
import affiliations from '../../data/affiliations.json';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const en = lang === 'en';
const c = (tr: string, enText: string) => (en ? enText : tr);

const reports = (await getCollection('reports')).sort((a, b) => b.data.year - a.data.year);
const eur = (n: number) => new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const escRows = impact.escLead.rows as any[];
const escTotalGrant = escRows.reduce((a, r) => a + r.grant, 0);
const escTotalVol = escRows.reduce((a, r) => a + r.volunteers, 0);
const reportHref = (slug: string) => `/etki-ve-seffaflik/${slug}`;

// --- Sitede yayınlanmış çalışmalar: içerik koleksiyonlarından otomatik sayılır ---
const langFilter = (e: { slug: string }) => (en ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'));
const stories = (await getCollection('stories', langFilter)).filter(s => !s.data.draft);



const latestStories = stories
  .slice()
  .sort((a, b) => getEventDateSortKey(b.data.startDate) - getEventDateSortKey(a.data.startDate));
const storyCard = (s: (typeof latestStories)[number]) => ({
  href: entryPath(lang, 'stories', stripLangPrefix(s.slug)),
  img: s.data.images?.[0] ?? s.data.socialImage ?? '',
  country: s.data.country,
  name: s.data.name,
  program: s.data.programName,
  summary: s.data.summary,
});

const supporters = affiliations.partners.items.map((i: any) => (en ? i.name_en ?? i.name : i.name));
const networks = affiliations.networks.items.map((i: any) => (en ? i.name_en ?? i.name : i.name));

const hosting = impact.hosting as any[];
const hostTotal = hosting.reduce((a, r) => a + r.participants, 0);
const hostBudget = hosting.reduce((a, r) => a + r.budget, 0);
const gsb = impact.gsb as any;
const sendRows = impact.sending.rows as any[];
const sendEsc = sendRows.reduce((a, r) => a + r.esc, 0);
const sendErasmus = sendRows.reduce((a, r) => a + r.erasmus, 0);
const sendingTotal = sendEsc + sendErasmus;
const sentAbroadTotal = escTotalVol + sendingTotal;
const prodes = impact.prodes as any;
const tl = (n: number) => new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { maximumFractionDigits: 0 }).format(n) + ' TL';
const spendColors = ['#2857a1', '#bd4029', '#e0a32e', '#3f8f6b', '#7a5aa6'];
const prodesSpend = (prodes.spend as any[]).map((r, i) => ({ label: en ? r.en : r.tr, amount: r.amount, pct: (r.amount / prodes.spent) * 100, color: spendColors[i % spendColors.length] }));

const fin = impact.finances as any;
const finRows = fin.rows as any[];
const finMax = Math.max(...finRows.flatMap(r => [r.income, r.expense]));
const finIncome = finRows.reduce((a, r) => a + r.income, 0);
const finExpense = finRows.reduce((a, r) => a + r.expense, 0);
const finPublic = finRows.reduce((a, r) => a + r.public, 0);
const tlShort = (n: number) => {
  const f = new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { maximumFractionDigits: 1 });
  if (n >= 1e6) return `${f.format(n / 1e6)} ${en ? 'm' : 'milyon'} TL`;
  if (n >= 1e3) return `${f.format(n / 1e3)} ${en ? 'k' : 'bin'} TL`;
  return `${f.format(n)} TL`;
};
const exp25 = (fin.expense2025 as any[]);
const exp25Total = exp25.reduce((a, r) => a + r.amount, 0);

// Üst bölümdeki büyük sayılar. value sayısal; prefix/suffix biçim içindir.
const nf0 = new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR');
const gsbM = (gsb.metrics as any[]);
const gv = (m: any) => (en ? m.value_en : m.value_tr) ?? m.value;
const groups = [
  { key: 'esc', tag: 'ESC', tone: 'blue', title: c('Avrupa Dayanışma Programı', 'European Solidarity Corps'), sub: c('Yurt dışında 2–12 ay süren gönüllülük', 'Volunteering abroad for 2–12 months'),
    cards: [
      { value: nf0.format(escTotalVol), label: c('gönüllü kendi yürüttüğümüz 5 ESC projesiyle gitti', 'volunteers went through the 5 ESC projects we run'), info: c('2021–2025 çağrıları · 10 ülke', '2021–2025 calls · 10 countries') },
      { value: nf0.format(sendEsc), label: c('gönüllüyü başka kuruluşların ESC projelerine gönderdik', 'volunteers sent to other organisations’ ESC projects'), info: c('Gönderici kuruluş · 2022–2026', 'Sending organisation · 2022–2026') },
      { value: eur(escTotalGrant), label: c('Türkiye Ulusal Ajansı hibesi', 'Turkish National Agency grants'), info: c('Kendi 5 ESC projemiz', 'Our own 5 ESC projects') },
    ] },
  { key: 'erasmus', tag: 'Erasmus+', tone: 'green', title: c('Erasmus+ Gençlik', 'Erasmus+ Youth'), sub: c('Kilis’te ağırladığımız gençlik değişimleri ve ortak projeler', 'Youth exchanges we hosted in Kilis and partner projects'),
    cards: [
      ...hosting.map(h => ({ value: nf0.format(h.participants), label: c(`katılımcı · ${h.year === 2025 ? 'Life for PRR' : 'No More Walls, Europe Calls'}`, `participants · ${h.year === 2025 ? 'Life for PRR' : 'No More Walls, Europe Calls'}`), info: `${h.year} · Kilis · ${eur(h.budget)} · ${h.countries} ${c('ülke', 'countries')}` })),
      { value: nf0.format(sendErasmus), label: c('genci ortak kuruluşların Erasmus+ projelerine gönderdik', 'young people sent to partners’ Erasmus+ projects'), info: c('2020–2026 · İsveç, İtalya, Romanya, Bulgaristan, Polonya', '2020–2026 · Sweden, Italy, Romania, Bulgaria, Poland') },
    ] },
  { key: 'gsb', tag: 'GSB', tone: 'amber', title: c('Gençlik ve Spor Bakanlığı', 'Ministry of Youth and Sports'), sub: `${en ? gsb.title_en : gsb.title_tr} · ${gsb.year} · ${gsb.budget}`,
    cards: gsbM.map(m => ({ value: gv(m), label: en ? m.en : m.tr, info: c('Kilis · 2025', 'Kilis · 2025') })) },
  { key: 'icisleri', tag: c('İçişleri', 'Interior'), tone: 'violet', title: c('İçişleri Bakanlığı', 'Ministry of Interior'), sub: `${en ? prodes.title_en : prodes.title_tr} · ${prodes.period} · ${tl(prodes.budget)}`,
    cards: [
      { value: nf0.format(prodes.participants), label: c('öğrenci eğitimleri tamamladı', 'students completed the training'), info: c('Ön test ve son test', 'Pre- and post-test') },
      { value: `%${prodes.satisfaction}`, label: c('eğitimden memnun kaldı', 'were satisfied with the training'), info: c('Hepsi tekrar katılmak istiyor', 'All would take part again') },
      { value: new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { minimumFractionDigits: 2 }).format(prodes.trainerScore) + '/5', label: c('eğitmenlere verilen puan', 'trainer rating'), info: c('5 üzerinden ortalama', 'Average out of 5') },
      { value: nf0.format(prodes.stations), label: c('atölye istasyonlu festival', 'workshop-station festival'), info: c('VR, 3D kalem, maket, boyama', 'VR, 3D pens, models, painting') },
    ] },
];

const title = c('Etki ve Şeffaflık', 'Impact and Transparency');
const intro = c(
  'Kaç kişiye ulaştığımızı, bu sayıları nereden aldığımızı ve gençlerin hayatında neyin değiştiğini tek sayfada topluyoruz.',
  'How many people we reach, where those numbers come from and what changes for young people, in one place.',
);
---

<BaseLayout
  lang={lang}
  title={`${title} — KOZ-DER`}
  description={intro}
  alternate={alternatePath(lang, 'impact')}
>
  <Breadcrumb
    lang={lang}
    kicker={c('Hesap verebilirlik', 'Accountability')}
    items={[{ label: t('nav.home'), href: path(lang, 'home') }, { label: title, href: path(lang, 'impact') }]}
    pageTitle={title}
    intro={intro}
  />

  <section class="impact-hero" aria-labelledby="impact-hero-heading">
    <div class="impact-blobs" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container mx-auto px-4 relative">
      <h2 id="impact-hero-heading" class="impact-hero-title">{c('Rakamlarla KOZ-DER', 'KOZ-DER in numbers')}</h2>
      <p class="impact-hero-lead">{c('Her destek programı ayrı listelenir; sayılar birbirine eklenmez.', 'Each funding programme is listed separately; figures are never added across programmes.')}</p>
      <div class="lead-total seq" tabindex="0">
        <strong class="stat-value">{nf0.format(sentAbroadTotal)}</strong>
        <div><p class="lead-label">{c('kez gencimizi yurt dışına gönderdik', 'times we sent a young person abroad')}</p><p class="lead-info">{c(`${escTotalVol} kendi ESC projelerimizle · ${sendEsc} ortak ESC projeleriyle · ${sendErasmus} ortak Erasmus+ projeleriyle`, `${escTotalVol} through our own ESC projects · ${sendEsc} through partner ESC projects · ${sendErasmus} through partner Erasmus+ projects`)}</p></div>
      </div>
      <div class="prog-rows" data-seq-root>
        {groups.map(g => (
          <div class:list={['prog-row', `tone-${g.tone}`]}>
            <div class="prog-row-head seq"><span class="prog-tag">{g.tag}</span><h3>{g.title}</h3><p>{g.sub}</p></div>
            <div class="prog-row-cards">
              {g.cards.map(cd => (
                <article class="stat-glass mini seq" tabindex="0">
                  <strong class:list={['stat-value', cd.value.length > 7 && 'long']}>{cd.value}</strong>
                  <p class="stat-label">{cd.label}</p>
                  <p class="stat-source">{cd.info}</p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container mx-auto px-4 py-12 sm:py-20 space-y-16 sm:space-y-24">

    <section aria-labelledby="finance-heading" class="prodes-card">
      <div class="impact-blobs small" aria-hidden="true"><span></span><span></span></div>
      <div class="relative">
        <h2 id="finance-heading" class="font-display text-3xl font-black leading-tight text-brand-ink">{c('Yıllara göre gelir ve gider', 'Income and spending by year')}</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft">{en ? fin.note_en : fin.note_tr}</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="stat-glass mini tone-green" tabindex="0"><strong class="stat-value">{tlShort(finIncome)}</strong><p class="stat-label">{c('toplam gelir', 'total income')} · {finRows[0].year}–{finRows[finRows.length - 1].year}</p></div>
          <div class="stat-glass mini tone-red" tabindex="0"><strong class="stat-value">{tlShort(finExpense)}</strong><p class="stat-label">{c('toplam gider', 'total spending')}</p></div>
          <div class="stat-glass mini tone-blue" tabindex="0"><strong class="stat-value">%{Math.round((finPublic / finIncome) * 100)}</strong><p class="stat-label">{c('gelirin kamu ve Ulusal Ajans desteklerinden geldi', 'of income came from public and National Agency grants')}</p></div>
        </div>
        <div class="fin-legend mt-8"><span><i style="background:#2f7d58"></i>{c('Gelir', 'Income')}</span><span><i style="background:#bd4029"></i>{c('Gider', 'Spending')}</span></div>
        <ul class="fin-chart mt-3">
          {finRows.map(r => (
            <li class="fin-row" tabindex="0">
              <span class="fin-year">{r.year}</span>
              <div class="fin-bars">
                <div class="fin-bar"><span class="fin-fill inc" style={`width:${Math.max(1, (r.income / finMax) * 78)}%`}></span><b>{tlShort(r.income)}</b></div>
                <div class="fin-bar"><span class="fin-fill exp" style={`width:${Math.max(1, (r.expense / finMax) * 78)}%`}></span><b>{tlShort(r.expense)}</b></div>
              </div>
              <span class="fin-balance">{c('Yıl sonu', 'Year end')}<br /><b>{tlShort(r.balance)}</b></span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <h3 class="font-display text-xl font-black text-brand-ink">{c('2025 giderleri nereye gitti?', 'Where did 2025 spending go?')}</h3>
          <div class="spend-bar mt-3" role="img" aria-label={exp25.map(r => `${en ? r.en : r.tr}: ${Math.round((r.amount / exp25Total) * 100)}%`).join(', ')}>
            {exp25.map((r, i) => <span style={`width:${(r.amount / exp25Total) * 100}%;background:${spendColors[i]}`}></span>)}
          </div>
          <ul class="mt-4 space-y-2">
            {exp25.map((r, i) => (
              <li class="spend-row"><span class="spend-dot" style={`background:${spendColors[i]}`}></span><span class="flex-1 text-brand-ink">{en ? r.en : r.tr}</span><span class="font-bold text-brand-ink">{tl(r.amount)}</span><span class="w-12 text-right text-sm text-ink-soft">%{Math.round((r.amount / exp25Total) * 100)}</span></li>
            ))}
          </ul>
        </div>
        <div class="mt-8 flex flex-col gap-3 rounded-2xl border border-white/80 bg-white/60 p-5 sm:flex-row sm:items-center sm:justify-between">
          <p class="max-w-xl text-ink-soft">{c('Her yıl gelirin nereden geldiğini ve hangi kategorilerde harcandığını ayrı ayrı görmek için mali tablolara bakın.', 'See where each year’s income came from and how it was spent, category by category.')}</p>
          <a class="inline-flex shrink-0 items-center justify-center rounded-xl bg-brand-ink px-5 py-3 font-bold text-white hover:bg-brand-stamp" href={en ? '/en/impact-and-transparency/financial-statements' : '/etki-ve-seffaflik/mali-tablolar'}>{c('Yıllara göre mali tablolar', 'Financial statements by year')}</a>
        </div>
      </div>
    </section>





    {latestStories.length > 0 && (
      <section aria-labelledby="change-heading">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-brand-stamp">{c('Gençlerin anlatımıyla', 'In their own words')}</p>
        <h2 id="change-heading" class="mb-8 font-display text-3xl font-black leading-tight tracking-tightest text-brand-ink sm:text-4xl">{c('Gençlerin hayatında ne değişti?', 'What changed for young people?')}</h2>
        <div class="story-rotator" data-story-rotator data-interval="5500" aria-live="polite">
          {latestStories.map((st, i) => {
            const card = storyCard(st);
            return (
              <a href={card.href} class:list={['story-glass', i < 3 && 'is-on']} data-story data-bg={card.img} style={i < 3 && card.img ? `--bg:url('${card.img}')` : undefined} aria-hidden={i < 3 ? undefined : 'true'} tabindex={i < 3 ? undefined : -1}>
                <span class="story-shade" aria-hidden="true"></span>
                <span class="story-body">
                  <span class="story-country">{card.country}</span>
                  <span class="story-name">{card.name}</span>
                  <span class="story-program">{card.program}</span>
                  <span class="story-read">{t('common.readStory')} →</span>
                </span>
              </a>
            );
          })}
        </div>
        <p class="mt-4 text-sm text-ink-soft">{c(`${latestStories.length} gönüllü hikâyesi sırayla gösteriliyor. Üzerine gelince durur.`, `${latestStories.length} volunteer stories in rotation. Hover to pause.`)}</p>
      </section>
    )}

    <section aria-labelledby="esc-heading">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-brand-stamp">{c('Avrupa Dayanışma Programı', 'European Solidarity Corps')}</p>
      <h2 id="esc-heading" class="mb-4 font-display text-3xl font-black leading-tight tracking-tightest text-brand-ink sm:text-4xl">{c('Yürüttüğümüz ESC gönüllülük projeleri', 'ESC volunteering projects we run')}</h2>
      <p class="mb-6 max-w-3xl leading-relaxed text-ink-soft">{en ? impact.escLead.note_en : impact.escLead.note_tr}</p>
      <div class="esc-cards" data-seq-esc>
        {escRows.map(r => {
          const list = (en ? r.countries_en : r.countries_tr).split(',').map((x: string) => x.trim()).map((x: string) => { const m = x.match(/^(.*)\s(\d+)$/); return { name: m ? m[1] : x, n: m ? Number(m[2]) : 0 }; });
          const max = Math.max(...list.map((x: any) => x.n), 1);
          return (
            <article class="esc-card seq" tabindex="0">
              <div class="esc-top">
                <span class="esc-year">{r.call}</span>
                <span class="esc-code">{r.code}</span>
              </div>
              <div class="esc-figs">
                <div><strong class="stat-value">{r.volunteers}</strong><span>{c('gönüllü', 'volunteers')}</span></div>
                <div class="text-right"><strong class="esc-grant">{eur(r.grant)}</strong><span>{c('hibe', 'grant')}</span></div>
              </div>
              <ul class="esc-countries">
                {list.map((x: any) => (
                  <li><span class="esc-cname">{x.name}</span><span class="esc-bar"><i style={`--w:${(x.n / max) * 100}%`}></i></span><b>{x.n}</b></li>
                ))}
              </ul>
            </article>
          );
        })}
        <article class="esc-card esc-total seq" tabindex="0">
          <span class="esc-year">{c('Toplam', 'Total')}</span>
          <div class="esc-figs">
            <div><strong class="stat-value">{escTotalVol}</strong><span>{c('gönüllü · 5 proje', 'volunteers · 5 projects')}</span></div>
            <div class="text-right"><strong class="esc-grant">{eur(escTotalGrant)}</strong><span>{c('toplam hibe', 'total grants')}</span></div>
          </div>
          <p class="esc-note">{c('10 ülke: Yunanistan, İtalya, Portekiz, Bulgaristan, İspanya, Romanya, Mısır, İzlanda, Gürcistan, Fas', '10 countries: Greece, Italy, Portugal, Bulgaria, Spain, Romania, Egypt, Iceland, Georgia, Morocco')}</p>
        </article>
      </div>
    </section>

    <section aria-labelledby="sending-heading" class="max-w-3xl">
      <div>
        <h2 id="sending-heading" class="mb-3 font-display text-2xl font-black text-brand-ink">{c('Gönderici kuruluş olarak', 'As sending organisation')}</h2>
        <p class="mb-4 text-sm leading-relaxed text-ink-soft">{en ? impact.sending.note_en : impact.sending.note_tr}</p>
        <div class="send-total" tabindex="0">
          <strong>{sendingTotal}</strong>
          <span>{c(`genç · ${sendEsc} ESC + ${sendErasmus} Erasmus+`, `young people · ${sendEsc} ESC + ${sendErasmus} Erasmus+`)}</span>
        </div>
        <ul class="mt-3 space-y-2">
          {sendRows.map(r => (
            <li class="send-row" tabindex="0">
              <span class="send-year">{r.year}</span>
              <span class="flex-1 text-sm text-ink-soft">{en ? r.where_en : r.where_tr}</span>
              <b class="send-count">{r.esc + r.erasmus}</b>
            </li>
          ))}
        </ul>
      </div>
    </section>





    <section aria-labelledby="funding-heading">
      <h2 id="funding-heading" class="mb-3 font-display text-2xl font-black text-brand-ink">{c('Ulusal destekler', 'National funding')}</h2>
      <div class="overflow-x-auto rounded-2xl border border-line bg-white">
        <table class="w-full min-w-[560px] text-left text-sm">
          <thead class="bg-brand-cream text-xs uppercase tracking-[0.12em] text-brand-stamp"><tr><th class="p-3">{c('Yıl', 'Year')}</th><th class="p-3">{c('Destekleyen', 'Funder')}</th><th class="p-3">{c('Çalışma', 'Project')}</th><th class="p-3 text-right">{c('Bütçe', 'Budget')}</th></tr></thead>
          <tbody class="divide-y divide-line">
            {(impact.funding as any[]).map(r => (
              <tr><td class="p-3 font-bold text-brand-ink">{r.year}</td><td class="p-3 text-ink-soft">{en ? r.funder_en : r.funder_tr}</td><td class="p-3 text-brand-ink">{en ? r.title_en : r.title_tr}</td><td class="p-3 text-right font-bold text-brand-ink">{r.amount}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="reports-heading" class="rounded-[2rem] border border-line bg-white p-6 sm:p-10">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-brand-stamp">{c('Belgeler', 'Documents')}</p>
      <h2 id="reports-heading" class="mb-4 font-display text-3xl font-black leading-tight tracking-tightest text-brand-ink">{c('Yönetim kurulu raporları', 'Board reports')}</h2>
      {en && <p class="mb-4 text-sm text-ink-soft">The reports are published in Turkish.</p>}
      <ul class="divide-y divide-line">
        {reports.map(r => (
          <li class="flex flex-col gap-2 py-4 sm:flex-row sm:items-center sm:justify-between">
            <span><span class="font-bold text-brand-ink">{r.data.title}</span><span class="block text-sm text-ink-soft">{r.data.summary}</span></span>
            <span class="flex shrink-0 gap-4">
              <a class="font-bold text-brand-stamp underline" href={reportHref(r.slug)}>{c('Raporu oku', 'Read report')}</a>
              {r.data.pdf && <a class="font-bold text-brand-ink underline" href={r.data.pdf} target="_blank" rel="noopener noreferrer">PDF</a>}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="support-heading" class="grid gap-6 lg:grid-cols-2">
      <div>
        <h2 id="support-heading" class="mb-4 font-display text-2xl font-black text-brand-ink">{en ? affiliations.partners.label_en : affiliations.partners.label}</h2>
        <ul class="flex flex-wrap gap-2">{supporters.map(n => <li class="rounded-full border border-line-strong px-3 py-1.5 text-sm text-brand-ink">{n}</li>)}</ul>
      </div>
      <div>
        <h2 class="mb-4 font-display text-2xl font-black text-brand-ink">{en ? affiliations.networks.label_en : affiliations.networks.label}</h2>
        <ul class="flex flex-wrap gap-2">{networks.map(n => <li class="rounded-full border border-line-strong px-3 py-1.5 text-sm text-brand-ink">{n}</li>)}</ul>
      </div>
    </section>

    <section aria-labelledby="voice-heading" class="flex flex-col gap-4 rounded-2xl border border-line bg-brand-cream p-6 sm:flex-row sm:items-center sm:justify-between sm:p-8">
      <div>
        <h2 id="voice-heading" class="font-display text-2xl font-black text-brand-ink">{c('Gençlerin Sesi', 'Young people’s voice')}</h2>
