---
import { useTranslations, path, alternatePath, entryPath, stripLangPrefix, type Lang } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';
import { getEventDateSortKey } from '../../utils/date';
import impact from '../../data/impact.json';
import affiliations from '../../data/affiliations.json';

interface Props { lang: Lang }
const lang: Lang = Astro.props.lang;
const t = useTranslations(lang);
const en = lang === 'en';
const c = (tr: string, enText: string) => (en ? enText : tr);

// --- Doğrulanmış sonuçlar (src/data/impact.json) ---
type Metric = { value?: string; value_tr?: string; value_en?: string; label_tr: string; label_en: string; source_tr: string; source_en: string };
const metrics = (impact.verifiedMetrics as Metric[]).map(m => ({
  value: (en ? m.value_en : m.value_tr) ?? m.value ?? '',
  label: en ? m.label_en : m.label_tr,
  source: en ? m.source_en : m.source_tr,
}));

const reports = (await getCollection('reports')).sort((a, b) => b.data.year - a.data.year);
const eur = (n: number) => new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const escRows = impact.escLead.rows as any[];
const escTotalGrant = escRows.reduce((a, r) => a + r.grant, 0);
const escTotalVol = escRows.reduce((a, r) => a + r.volunteers, 0);
const reportHref = (slug: string) => `/etki-ve-seffaflik/${slug}`;

// --- Sitede yayınlanmış çalışmalar: içerik koleksiyonlarından otomatik sayılır ---
const langFilter = (e: { slug: string }) => (en ? e.slug.startsWith('en/') : !e.slug.startsWith('en/'));
const projects = (await getCollection('projects', langFilter)).filter(p => !p.data.draft);
const stories = (await getCollection('stories', langFilter)).filter(s => !s.data.draft);

const esc = projects.filter(p => p.data.programType === 'ESC').length;
const erasmus = projects.filter(p => p.data.programType === 'ERASMUS').length;
const local = projects.filter(p => p.data.programType === 'LOCAL').length;
const storyCountries = new Set(stories.map(s => s.data.country.split('·')[0].trim())).size;

const published = [
  { value: String(esc + erasmus), label: c('yurt dışı proje sayfası', 'international project pages'), source: c(`${erasmus} Erasmus+ · ${esc} ESC`, `${erasmus} Erasmus+ · ${esc} ESC`) },
  { value: String(stories.length), label: c('gönüllü ve katılımcı hikâyesi', 'volunteer and participant stories'), source: c(`${storyCountries} ülkeden deneyim`, `experiences from ${storyCountries} countries`) },
  local > 0 && { value: String(local), label: c('yerel gönüllülük çağrısı', 'local volunteering calls'), source: c('Kilis ve çevrim içi', 'Kilis and online') },
].filter(Boolean) as { value: string; label: string; source: string }[];

const latestStories = stories
  .slice()
  .sort((a, b) => getEventDateSortKey(b.data.startDate) - getEventDateSortKey(a.data.startDate));
const storyCard = (s: (typeof latestStories)[number]) => ({
  href: entryPath(lang, 'stories', stripLangPrefix(s.slug)),
  img: s.data.images?.[0] ?? s.data.socialImage ?? '',
  country: s.data.country,
  name: s.data.name,
  program: s.data.programName,
  summary: s.data.summary,
});

const supporters = affiliations.partners.items.map((i: any) => (en ? i.name_en ?? i.name : i.name));
const networks = affiliations.networks.items.map((i: any) => (en ? i.name_en ?? i.name : i.name));

const sendRows = impact.sending.rows as any[];
const sendEsc = sendRows.reduce((a, r) => a + r.esc, 0);
const sendErasmus = sendRows.reduce((a, r) => a + r.erasmus, 0);
const sendingTotal = sendEsc + sendErasmus;
const sentAbroadTotal = escTotalVol + sendingTotal;
const prodes = impact.prodes as any;
const tl = (n: number) => new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { maximumFractionDigits: 0 }).format(n) + ' TL';
const spendColors = ['#2857a1', '#bd4029', '#e0a32e', '#3f8f6b', '#7a5aa6'];
const prodesSpend = (prodes.spend as any[]).map((r, i) => ({ label: en ? r.en : r.tr, amount: r.amount, pct: (r.amount / prodes.spent) * 100, color: spendColors[i % spendColors.length] }));

const fin = impact.finances as any;
const finRows = fin.rows as any[];
const finMax = Math.max(...finRows.flatMap(r => [r.income, r.expense]));
const finIncome = finRows.reduce((a, r) => a + r.income, 0);
const finExpense = finRows.reduce((a, r) => a + r.expense, 0);
const finPublic = finRows.reduce((a, r) => a + r.public, 0);
const tlShort = (n: number) => {
  const f = new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { maximumFractionDigits: 1 });
  if (n >= 1e6) return `${f.format(n / 1e6)} ${en ? 'm' : 'milyon'} TL`;
  if (n >= 1e3) return `${f.format(n / 1e3)} ${en ? 'k' : 'bin'} TL`;
  return `${f.format(n)} TL`;
};
const exp25 = (fin.expense2025 as any[]);
const exp25Total = exp25.reduce((a, r) => a + r.amount, 0);

// Üst bölümdeki büyük sayılar. value sayısal; prefix/suffix biçim içindir.
const headline = [
  { value: sentAbroadTotal, suffix: '', label: c('kez gencimizi yurt dışına gönderdik', 'times we sent a young person abroad'), source: c(`${escTotalVol} kendi ESC projelerimizle · ${sendingTotal} ortak projelerle`, `${escTotalVol} through our own ESC projects · ${sendingTotal} through partner projects`), tone: 'blue' },
  { value: escTotalVol, suffix: '', label: c('gönüllü kendi ESC projelerimizle gitti', 'volunteers went through our own ESC projects'), source: c('5 ESC projesi · 2021–2025 çağrıları', '5 ESC projects · 2021–2025 calls'), tone: 'red' },
  { value: escTotalGrant, suffix: ' €', label: c('ESC hibesi', 'in ESC grants'), source: c('Azami hibe toplamı', 'Sum of maximum grants'), tone: 'red' },
  { value: sendingTotal, suffix: '', label: c('genci ortak projelere gönderdik', 'young people sent to partner projects'), source: c(`Gönderici kuruluş · ${sendEsc} ESC + ${sendErasmus} Erasmus+`, `Sending organisation · ${sendEsc} ESC + ${sendErasmus} Erasmus+`), tone: 'amber' },
  { value: 75, suffix: '', label: c('genci Kilis’te ağırladık', 'young people hosted in Kilis'), source: c('Life for PRR (~50) + No More Walls (25)', 'Life for PRR (~50) + No More Walls (25)'), tone: 'green' },
  { value: prodes.participants, suffix: '', label: c('genç zekâ oyunları ve robotik kodlama eğitimini tamamladı', 'young people completed mind games and robotic coding training'), source: c(`%${prodes.satisfaction} memnuniyet · ön test–son test`, `${prodes.satisfaction}% satisfied · pre/post test`), tone: 'violet' },
];

const title = c('Etki ve Şeffaflık', 'Impact and Transparency');
const intro = c(
  'Kaç kişiye ulaştığımızı, bu sayıları nereden aldığımızı ve gençlerin hayatında neyin değiştiğini tek sayfada topluyoruz.',
  'How many people we reach, where those numbers come from and what changes for young people, in one place.',
);
---

<BaseLayout
  lang={lang}
  title={`${title} — KOZ-DER`}
  description={intro}
  alternate={alternatePath(lang, 'impact')}
>
  <Breadcrumb
    lang={lang}
    kicker={c('Hesap verebilirlik', 'Accountability')}
    items={[{ label: t('nav.home'), href: path(lang, 'home') }, { label: title, href: path(lang, 'impact') }]}
    pageTitle={title}
    intro={intro}
  />

  <section class="impact-hero" aria-labelledby="impact-hero-heading">
    <div class="impact-blobs" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container mx-auto px-4 relative">
      <h2 id="impact-hero-heading" class="impact-hero-title">{c('Rakamlarla KOZ-DER', 'KOZ-DER in numbers')}</h2>
      <p class="impact-hero-lead">{c('Her sayının kaynağı kartın altında yazıyor. Farklı faaliyetlerin sayılarını birbirine eklemiyoruz.', 'Every figure names its source. We never add up numbers from different activities.')}</p>
      <div class="stat-grid" data-countup-root>
        {headline.map(h => (
          <article class:list={['stat-glass', `tone-${h.tone}`]} tabindex="0">
            <strong class:list={['stat-value', h.value >= 10000 && 'long']}><span data-countup={h.value} data-lang={lang}>{new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR').format(h.value)}</span>{h.suffix}</strong>
            <p class="stat-label">{h.label}</p>
            <p class="stat-source">{h.source}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="container mx-auto px-4 py-12 sm:py-20 space-y-16 sm:space-y-24">

    <section aria-labelledby="verified-heading">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-brand-stamp">{c('Doğrulanmış sonuçlar', 'Verified outcomes')}</p>
      <h2 id="verified-heading" class="mb-4 max-w-4xl font-display text-3xl font-black leading-tight tracking-tightest text-brand-ink sm:text-4xl">{c('Kaynağıyla birlikte verilen sayılar.', 'Figures shown with their source.')}</h2>
      <p class="mb-8 max-w-3xl leading-relaxed text-ink-soft">{c('Her sayının altında program, yıl ve sayım türü yazıyor. Farklı faaliyetlerin sayılarını birbirine eklemiyoruz.', 'Each figure shows its programme, year and type of count. We do not add up figures from different activities.')}</p>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {metrics.map(m => (
          <article class="stat-glass tone-red" tabindex="0">
            <strong class="stat-value">{m.value}</strong>
            <p class="stat-label">{m.label}</p>
            <p class="stat-source">{m.source}</p>
          </article>
        ))}
      </div>
      <p class="mt-5 text-sm leading-relaxed text-ink-soft">{en ? impact.metricsNote_en : impact.metricsNote_tr}</p>
    </section>

    <section aria-labelledby="published-heading">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-brand-stamp">{c('Bu sitede', 'On this site')}</p>
      <h2 id="published-heading" class="mb-4 font-display text-3xl font-black leading-tight tracking-tightest text-brand-ink sm:text-4xl">{c('Yayınlanmış projeler ve hikâyeler.', 'Published projects and stories.')}</h2>
      <p class="mb-8 max-w-3xl leading-relaxed text-ink-soft">{c('Bu sayılar sitedeki sayfalardan otomatik hesaplanır. Derneğin tüm geçmişini değil, burada yayımlanan çalışmaları gösterir. Hikâye sayısı, yararlanıcı sayısı değildir.', 'These numbers are counted automatically from the pages on this site. They show published work, not the association’s full history. The number of stories is not a number of beneficiaries.')}</p>
      <div class="grid gap-4 sm:grid-cols-3">
        {published.map(m => (
          <article class="stat-glass tone-blue" tabindex="0">
            <strong class="stat-value">{m.value}</strong>
            <p class="stat-label">{m.label}</p>
            <p class="stat-source">{m.source}</p>
          </article>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="rounded-xl bg-brand-ink px-5 py-3 font-bold text-white hover:bg-brand-stamp" href={path(lang, 'projects')}>{c('Tüm projeler →', 'All projects →')}</a>
        <a class="rounded-xl border border-line-strong px-5 py-3 font-bold text-brand-ink hover:border-brand-stamp" href={path(lang, 'stories')}>{c('Tüm hikâyeler →', 'All stories →')}</a>
      </div>
    </section>

    {latestStories.length > 0 && (
      <section aria-labelledby="change-heading">
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-brand-stamp">{c('Gençlerin anlatımıyla', 'In their own words')}</p>
        <h2 id="change-heading" class="mb-8 font-display text-3xl font-black leading-tight tracking-tightest text-brand-ink sm:text-4xl">{c('Gençlerin hayatında ne değişti?', 'What changed for young people?')}</h2>
        <div class="story-rotator" data-story-rotator data-interval="5500" aria-live="polite">
          {latestStories.map((st, i) => {
            const card = storyCard(st);
            return (
              <a href={card.href} class:list={['story-glass', i < 3 && 'is-on']} data-story data-bg={card.img} style={i < 3 && card.img ? `--bg:url('${card.img}')` : undefined} aria-hidden={i < 3 ? undefined : 'true'} tabindex={i < 3 ? undefined : -1}>
                <span class="story-shade" aria-hidden="true"></span>
                <span class="story-body">
                  <span class="story-country">{card.country}</span>
                  <span class="story-name">{card.name}</span>
                  <span class="story-program">{card.program}</span>
                  <span class="story-summary">{card.summary}</span>
                  <span class="story-read">{t('common.readStory')} →</span>
                </span>
              </a>
            );
          })}
        </div>
        <p class="mt-4 text-sm text-ink-soft">{c(`${latestStories.length} gönüllü hikâyesi sırayla gösteriliyor. Üzerine gelince durur.`, `${latestStories.length} volunteer stories in rotation. Hover to pause.`)}</p>
      </section>
    )}

    <section aria-labelledby="esc-heading">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.16em] text-brand-stamp">{c('Avrupa Dayanışma Programı', 'European Solidarity Corps')}</p>
      <h2 id="esc-heading" class="mb-4 font-display text-3xl font-black leading-tight tracking-tightest text-brand-ink sm:text-4xl">{c('Yürüttüğümüz ESC gönüllülük projeleri', 'ESC volunteering projects we run')}</h2>
      <p class="mb-6 max-w-3xl leading-relaxed text-ink-soft">{en ? impact.escLead.note_en : impact.escLead.note_tr}</p>
      <div class="overflow-x-auto rounded-2xl border border-line bg-white">
        <table class="w-full min-w-[640px] text-left text-sm">
          <thead class="bg-brand-cream text-xs uppercase tracking-[0.12em] text-brand-stamp">
            <tr><th class="p-3">{c('Çağrı', 'Call')}</th><th class="p-3">{c('Gönüllü', 'Volunteers')}</th><th class="p-3">{c('Ülkeler', 'Countries')}</th><th class="p-3 text-right">{c('Hibe', 'Grant')}</th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            {escRows.map(r => (
              <tr>
                <td class="p-3 font-bold text-brand-ink">{r.call}<span class="block text-[11px] font-normal text-ink-soft">{r.code}</span></td>
                <td class="p-3 text-brand-ink">{r.volunteers}</td>
                <td class="p-3 text-ink-soft">{en ? r.countries_en : r.countries_tr}</td>
                <td class="p-3 text-right font-bold text-brand-ink">{eur(r.grant)}</td>
              </tr>
            ))}
          </tbody>
          <tfoot class="bg-brand-cream font-bold text-brand-ink">
            <tr><td class="p-3">{c('Toplam', 'Total')}</td><td class="p-3">{escTotalVol}</td><td class="p-3"></td><td class="p-3 text-right">{eur(escTotalGrant)}</td></tr>
          </tfoot>
        </table>
      </div>
    </section>

    <section aria-labelledby="sending-heading" class="grid gap-8 lg:grid-cols-2">
      <div>
        <h2 id="sending-heading" class="mb-3 font-display text-2xl font-black text-brand-ink">{c('Gönderici kuruluş olarak', 'As sending organisation')}</h2>
        <p class="mb-4 text-sm leading-relaxed text-ink-soft">{en ? impact.sending.note_en : impact.sending.note_tr}</p>
        <div class="send-total" tabindex="0">
          <strong>{sendingTotal}</strong>
          <span>{c(`genç · ${sendEsc} ESC + ${sendErasmus} Erasmus+`, `young people · ${sendEsc} ESC + ${sendErasmus} Erasmus+`)}</span>
        </div>
        <ul class="mt-3 space-y-2">
          {sendRows.map(r => (
            <li class="send-row" tabindex="0">
              <span class="send-year">{r.year}</span>
              <span class="flex-1 text-sm text-ink-soft">{en ? r.where_en : r.where_tr}</span>
              <b class="send-count">{r.esc + r.erasmus}</b>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs text-ink-soft">{en ? impact.sending.upcoming_en : impact.sending.upcoming_tr}</p>
      </div>
      <div>
        <h2 class="mb-3 font-display text-2xl font-black text-brand-ink">{c('Kilis’te ev sahipliği', 'Hosting in Kilis')}</h2>
        <p class="mb-4 text-sm leading-relaxed text-ink-soft">{c('Kilis’te ağırladığımız uluslararası gençlik değişimleri.', 'International youth exchanges we hosted in Kilis.')}</p>
        <ul class="space-y-3">
          {(impact.hosting as any[]).map(r => (
            <li class="rounded-2xl border border-line bg-white p-4">
              <p class="font-bold text-brand-ink">{r.year} · {r.title}</p>
              <p class="mt-1 text-sm text-ink-soft">{en ? r.count_en : r.count_tr}{(en ? r.budget_en : r.budget_tr) && ` · ${en ? r.budget_en : r.budget_tr}`}</p>
              <a class="mt-2 inline-block text-xs font-bold text-brand-stamp underline" href={reportHref(r.source)}>{c('Kaynak: YK raporu', 'Source: board report')} {r.year}</a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section aria-labelledby="prodes-heading" class="prodes-card">
      <div class="impact-blobs small" aria-hidden="true"><span></span><span></span></div>
      <div class="relative grid gap-8 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <p class="text-sm font-bold text-brand-stamp">{c('İçişleri Bakanlığı', 'Ministry of Interior')} · {prodes.period}</p>
          <h2 id="prodes-heading" class="mt-2 font-display text-3xl font-black leading-tight text-brand-ink">{en ? prodes.title_en : prodes.title_tr}</h2>
          <p class="mt-3 leading-relaxed text-ink-soft">{c('Kilis’te gençler için zekâ oyunları ve robotik kodlama eğitimleri ile beş atölye istasyonlu bir festival. Sonuçlar katılımcıların ön test ve son test yanıtlarından geliyor.', 'Mind games and robotic coding training for young people in Kilis, closing with a festival of five workshop stations. Results come from participants’ pre- and post-tests.')}</p>
          <div class="mt-6 grid grid-cols-2 gap-3">
            <div class="stat-glass mini tone-violet" tabindex="0"><strong class="stat-value">{prodes.participants}</strong><p class="stat-label">{c('katılımcı', 'participants')}</p></div>
            <div class="stat-glass mini tone-green" tabindex="0"><strong class="stat-value">%{prodes.satisfaction}</strong><p class="stat-label">{c('memnuniyet', 'satisfied')}</p></div>
            <div class="stat-glass mini tone-amber" tabindex="0"><strong class="stat-value">%{prodes.recommend}</strong><p class="stat-label">{c('başkasına tavsiye eder', 'would recommend')}</p></div>
            <div class="stat-glass mini tone-blue" tabindex="0"><strong class="stat-value">{new Intl.NumberFormat(en ? 'en-IE' : 'tr-TR', { minimumFractionDigits: 2 }).format(prodes.trainerScore)}<small>/5</small></strong><p class="stat-label">{c('eğitmen puanı', 'trainer rating')}</p></div>
          </div>
        </div>
        <div class="lg:col-span-3">
          <div class="flex flex-wrap items-end justify-between gap-2">
            <h3 class="font-display text-xl font-black text-brand-ink">{c('Bütçe nereye harcandı?', 'Where did the budget go?')}</h3>
            <p class="text-sm text-ink-soft">{tl(prodes.spent)} / {tl(prodes.budget)} {c('kullanıldı', 'used')} (%{Math.round((prodes.spent / prodes.budget) * 100)})</p>
          </div>
          <div class="spend-bar mt-4" role="img" aria-label={prodesSpend.map(r => `${r.label}: ${Math.round(r.pct)}%`).join(', ')}>
            {prodesSpend.map(r => <span style={`width:${r.pct}%;background:${r.color}`} title={`${r.label}: ${tl(r.amount)}`}></span>)}
          </div>
          <ul class="mt-5 space-y-2">
            {prodesSpend.map(r => (
              <li class="spend-row">
                <span class="spend-dot" style={`background:${r.color}`}></span>
                <span class="flex-1 text-brand-ink">{r.label}</span>
                <span class="font-bold text-brand-ink">{tl(r.amount)}</span>
                <span class="w-12 text-right text-sm text-ink-soft">%{Math.round(r.pct)}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-xs text-ink-soft">{c('Kaynak:', 'Source:')} {en ? prodes.source_en : prodes.source_tr}</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="finance-heading" class="prodes-card">
      <div class="impact-blobs small" aria-hidden="true"><span></span><span></span></div>
      <div class="relative">
        <h2 id="finance-heading" class="font-display text-3xl font-black leading-tight text-brand-ink">{c('Yıllara göre gelir ve gider', 'Income and spending by year')}</h2>
        <p class="mt-3 max-w-3xl leading-relaxed text-ink-soft">{en ? fin.note_en : fin.note_tr}</p>
        <div class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="stat-glass mini tone-green" tabindex="0"><strong class="stat-value">{tlShort(finIncome)}</strong><p class="stat-label">{c('toplam gelir', 'total income')} · {finRows[0].year}–{finRows[finRows.length - 1].year}</p></div>
          <div class="stat-glass mini tone-red" tabindex="0"><strong class="stat-value">{tlShort(finExpense)}</strong><p class="stat-label">{c('toplam gider', 'total spending')}</p></div>
          <div class="stat-glass mini tone-blue" tabindex="0"><strong class="stat-value">%{Math.round((finPublic / finIncome) * 100)}</strong><p class="stat-label">{c('gelirin kamu ve Ulusal Ajans desteklerinden geldi', 'of income came from public and National Agency grants')}</p></div>
        </div>
        <div class="fin-legend mt-8"><span><i style="background:#2f7d58"></i>{c('Gelir', 'Income')}</span><span><i style="background:#bd4029"></i>{c('Gider', 'Spending')}</span></div>
        <ul class="fin-chart mt-3">
          {finRows.map(r => (
            <li class="fin-row" tabindex="0">
              <span class="fin-year">{r.year}</span>
              <div class="fin-bars">
                <div class="fin-bar"><span class="fin-fill inc" style={`width:${Math.max(1, (r.income / finMax) * 78)}%`}></span><b>{tlShort(r.income)}</b></div>
                <div class="fin-bar"><span class="fin-fill exp" style={`width:${Math.max(1, (r.expense / finMax) * 78)}%`}></span><b>{tlShort(r.expense)}</b></div>
              </div>
              <span class="fin-balance">{c('Yıl sonu', 'Year end')}<br /><b>{tlShort(r.balance)}</b></span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
