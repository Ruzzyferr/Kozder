---
import { getLangFromUrl, useTranslations, path, type Lang } from '../i18n';

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const socials = [
  { name: 'Instagram', icon: 'instagram', href: 'https://www.instagram.com/kozder2018' },
  { name: 'Facebook', icon: 'facebook', href: 'https://www.facebook.com/kozder2018' },
  { name: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/in/kozder2018' },
  { name: 'YouTube', icon: 'youtube', href: 'https://www.youtube.com/@kozder2018' },
  { name: 'TikTok', icon: 'tiktok', href: 'https://www.tiktok.com/@kozder2018' },
  { name: 'X', icon: 'x', href: 'https://x.com/kozder2018' },
];

const navColumns = [
  { title: t('footer.discover'), links: [
    { href: path(lang, 'projects'), text: t('nav.projects') },
    { href: path(lang, 'events'), text: t('nav.events') },
    { href: path(lang, 'news'), text: t('nav.news') },
    { href: path(lang, 'stories'), text: t('nav.stories') },
    { href: path(lang, 'posts'), text: t('nav.posts') },
  ]},
  { title: t('footer.org'), links: [
    { href: path(lang, 'about'), text: t('nav.about') },
    { href: path(lang, 'membership'), text: t('nav.membership') },
    { href: '/documents/KA1_Partner_Profile_2026.pdf', text: lang === 'en' ? 'KA1 Partner Profile' : 'KA1 Ortaklık Profili', external: true },
    { href: '/documents/KA2_Partner_Profile_2026.pdf', text: lang === 'en' ? 'KA2 Partner Profile' : 'KA2 Ortaklık Profili', external: true },
    { href: path(lang, 'faq'), text: t('footer.faqShort') },
    { href: path(lang, 'links'), text: t('footer.links') },
    { href: path(lang, 'contact'), text: t('nav.contact') },
  ]},
  { title: t('footer.programs'), links: [
    { href: 'https://europa.eu/youth/solidarity_en', text: 'ESC', external: true },
    { href: 'https://erasmus-plus.ec.europa.eu/', text: 'Erasmus+', external: true },
    { href: path(lang, 'privacy'), text: t('footer.kvkk') },
  ]},
];

const socialImages = {"Instagram": "data:image/svg+xml;base64,", "Facebook": "data:image/svg+xml;base64,", "LinkedIn": "data:image/svg+xml;base64,", "YouTube": "data:image/svg+xml;base64,", "TikTok": "data:image/svg+xml;base64,", "X": "data:image/svg+xml;base64,"};
---
<div class="koz-glass"><footer class="full-footer">
<div class="footer-wrap"><div class="footer-brand">KOZ<span>·</span>DER</div>
<div class="footer-grid">
<section class="footer-about"><p>{t('footer.blurb')}</p><div class="socials">
{socials.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}><span class="social-logo"><img src={socialImages[s.name]} width="19" height="19" alt="" /></span></a>)}
</div></section>
{navColumns.map(col=><section><h3>{col.title}</h3>{col.links.map(link=><a href={link.href} target={link.external?'_blank':undefined} rel={link.external?'noopener noreferrer':undefined}>{link.text}</a>)}</section>)}
<section><h3>{t('footer.contact')}</h3><address>Kazım Karabekir Mh.<br />İstiklal Cd. No:33D<br />79000 Kilis · Türkiye</address><a href="tel:+905511972997">+90 551 197 29 97</a><a href="mailto:bilgi@kozder.com">bilgi@kozder.com</a></section>
</div>
<div class="footer-bottom"><span>© {currentYear} KOZ-DER · {t('footer.rights')}</span><div class="footer-right"><span class="visitor"><span class="visitor-label">{lang==='en'?'Visitors':'Ziyaretçi'}</span><strong class="visitor-value" id="goatcounter-total">—</strong></span><span>Kilis · Türkiye</span></div></div>
</div></footer></div>
<script is:inline data-goatcounter="https://kozder.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
<script is:inline>
  (() => {
    const counter = document.getElementById('goatcounter-total');
    if (!counter) return;

    fetch('https://kozder.goatcounter.com/counter/TOTAL.json?start=2026-08-16')
      .then((response) => {
        if (!response.ok) throw new Error('Counter unavailable');
        return response.json();
      })
      .then((data) => {
        const goatCount = Number.parseInt(String(data.count || '0').replace(/[^\d]/g, ''), 10) || 0;
        const totalCount = 13768 + goatCount;
        const locale = document.documentElement.lang === 'en' ? 'en-US' : 'tr-TR';
        counter.textContent = new Intl.NumberFormat(locale).format(totalCount);
      })
      .catch(() => {
        counter.textContent = '—';
      });
  })();
</script>
