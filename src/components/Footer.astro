---
import { getLangFromUrl, useTranslations, path, type Lang } from '../i18n';

interface Props { lang?: Lang }
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();

const socials = [
  { name: 'Instagram', icon: 'instagram', href: 'https://www.instagram.com/kozder2018' },
  { name: 'Facebook', icon: 'facebook', href: 'https://www.facebook.com/kozder2018' },
  { name: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/in/kozder2018' },
  { name: 'YouTube', icon: 'youtube', href: 'https://www.youtube.com/@kozder2018' },
  { name: 'TikTok', icon: 'tiktok', href: 'https://www.tiktok.com/@kozder2018' },
  { name: 'X', icon: 'x', href: 'https://x.com/kozder2018' },
];

const navColumns = [
  { title: t('footer.discover'), links: [
    { href: path(lang, 'projects'), text: t('nav.projects') },
    { href: path(lang, 'events'), text: t('nav.events') },
    { href: path(lang, 'news'), text: t('nav.news') },
    { href: path(lang, 'stories'), text: t('nav.stories') },
    { href: path(lang, 'posts'), text: t('nav.posts') },
  ]},
  { title: t('footer.org'), links: [
    { href: path(lang, 'about'), text: t('nav.about') },
    { href: '/documents/KA1_Partner_Profile_2026.pdf', text: lang === 'en' ? 'KA1 Partner Profile' : 'KA1 Ortaklık Profili', external: true },
    { href: '/documents/KA2_Partner_Profile_2026.pdf', text: lang === 'en' ? 'KA2 Partner Profile' : 'KA2 Ortaklık Profili', external: true },
    { href: path(lang, 'faq'), text: t('footer.faqShort') },
    { href: path(lang, 'links'), text: t('footer.links') },
    { href: path(lang, 'contact'), text: t('nav.contact') },
  ]},
  { title: t('footer.programs'), links: [
    { href: 'https://europa.eu/youth/solidarity_en', text: 'ESC', external: true },
    { href: 'https://erasmus-plus.ec.europa.eu/', text: 'Erasmus+', external: true },
    { href: path(lang, 'privacy'), text: t('footer.kvkk') },
  ]},
];
---

<footer class="relative mt-20 bg-brand-ink text-brand-cream">
  <div class="h-2 stripes-walnut"></div>

  <div class="container mx-auto px-4 py-14">

    <div class="border-b border-brand-cream/30 pb-10 mb-10">
      <h2 class="font-display font-black text-5xl sm:text-7xl lg:text-8xl tracking-tightest leading-[0.85] text-brand-cream">
        KOZ<span class="text-brand-stamp">·</span>DER
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <p class="text-sm text-brand-cream leading-relaxed max-w-md mb-6">
          {t('footer.blurb')}
        </p>

        <div class="flex items-center gap-2 flex-wrap" aria-label={lang === 'en' ? 'Social media accounts' : 'Sosyal medya hesapları'}>
          {socials.map(s => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.name}
              title={s.name}
              class="h-11 w-11 shrink-0 border border-brand-cream/70 text-brand-cream hover:bg-brand-cream hover:text-brand-ink hover:border-brand-cream flex items-center justify-center transition-colors"
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" aria-hidden="true">
                {s.icon === 'instagram' ? (
                  <>
                    <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
                    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                    <circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" />
                  </>
                ) : s.icon === 'facebook' ? (
                  <path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.673 3.667h-3.246v8.245A12 12 0 1 0 9.101 23.691Z" />
                ) : s.icon === 'linkedin' ? (
                  <path fill="currentColor" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124ZM7.119 20.452H3.555V9H7.12v11.452Z" />
                ) : s.icon === 'youtube' ? (
                  <path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z" />
                ) : s.icon === 'tiktok' ? (
                  <path fill="currentColor" d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z" />
                ) : (
                  <path fill="currentColor" d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993Zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182Z" />
                )}
              </svg>
            </a>
          ))}
        </div>
      </div>

      {navColumns.map(col => (
        <div class="lg:col-span-2">
          <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-postage mb-4">{col.title}</h3>
          <ul class="text-sm -my-1.5">
            {col.links.map(link => (
              <li>
                <a
                  href={link.href}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  class="text-brand-cream hover:text-brand-stamp transition-colors inline-flex items-center gap-1.5 font-medium py-2 min-h-[40px] sm:min-h-0 sm:py-1.5"
                >
                  {link.text}
                  {link.external && <span class="text-[10px]">↗</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="lg:col-span-3">
        <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-brand-postage mb-4">{t('footer.contact')}</h3>
        <address class="not-italic text-sm text-brand-cream leading-relaxed space-y-2">
          <p>Kazım Karabekir Mh.<br/>İstiklal Cd. No:33D<br/>79000 Kilis · TR</p>
          <p>
            <a href="tel:+905511972997" class="hover:text-brand-stamp transition-colors inline-flex items-center min-h-[40px] sm:min-h-0 sm:py-0.5 font-semibold">+90 551 197 29 97</a>
            <a href="mailto:bilgi@kozder.com" class="hover:text-brand-stamp transition-colors inline-flex items-center min-h-[40px] sm:min-h-0 sm:py-0.5 font-semibold">bilgi@kozder.com</a>
          </p>
        </address>
      </div>
    </div>

    <div class="border-t border-brand-cream/15 mt-12 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-brand-cream/80">
      <p>© {currentYear} KOZ-DER · {t('footer.rights')}</p>
      <div class="flex flex-wrap items-center gap-3">
        <span
          class="inline-flex h-7 items-center overflow-hidden rounded border border-brand-cream/30"
          aria-label={lang === 'en' ? 'KOZ-DER total visitor count' : 'KOZ-DER toplam ziyaretçi sayısı'}
        >
          <span class="bg-brand-cream/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider">
            {lang === 'en' ? 'Visitors' : 'Ziyaretçi'}
          </span>
          <span id="goatcounter-total" class="min-w-9 px-2 py-1 text-center text-[11px] font-black text-brand-postage">—</span>
        </span>
        <p class="tracking-[0.12em] uppercase text-[10px] text-brand-cream/70">
          Kilis · Türkiye
        </p>
      </div>
    </div>
  </div>
</footer>

<script is:inline data-goatcounter="https://kozder.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
<script is:inline>
  (() => {
    const counter = document.getElementById('goatcounter-total');
    if (!counter) return;

    fetch('https://kozder.goatcounter.com/counter/TOTAL.json?start=2026-08-16')
      .then((response) => {
        if (!response.ok) throw new Error('Counter unavailable');
        return response.json();
      })
      .then((data) => {
        const goatCount = Number.parseInt(String(data.count || '0').replace(/[^\d]/g, ''), 10) || 0;
        const totalCount = 13768 + goatCount;
        const locale = document.documentElement.lang === 'en' ? 'en-US' : 'tr-TR';
        counter.textContent = new Intl.NumberFormat(locale).format(totalCount);
      })
      .catch(() => {
        counter.textContent = '—';
      });
  })();
</script>
