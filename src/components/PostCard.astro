---
import { formatEventDate } from '../utils/date';

interface Props {
  title: string;
  summary: string;
  date: string;
  tags: string[];
  slug: string;
}

const { title, summary, date, tags, slug } = Astro.props;
const formattedDate = formatEventDate(date);
---

<a href={`/duyurular/${slug}`} class="block group h-full">
  <article class="relative h-full bg-brand-cream border-2 border-brand-ink p-6 sm:p-7 transition-all duration-300 hover:-translate-y-1 hover:translate-x-0.5 flex flex-col" style="box-shadow: 4px 4px 0 0 #6B4630;">
    <time datetime={date} class="text-xs font-bold uppercase tracking-[0.2em] text-brand-walnut mb-4">{formattedDate}</time>

    <h3 class="font-display font-bold text-xl sm:text-2xl text-brand-ink mb-4 group-hover:text-brand-stamp transition-colors leading-[1.15] tracking-tight">
      {title}
    </h3>
    <p class="text-sm text-ink-soft mb-5 line-clamp-3 flex-1 leading-relaxed">
      {summary}
    </p>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-5">
        {tags.map(tag => (
          <span class="text-[11px] font-bold uppercase tracking-[0.1em] px-2 py-1 border border-brand-ink/40 text-brand-walnut">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="pt-4 border-t border-brand-ink/15 flex items-center justify-between mt-auto">
      <span class="text-sm font-bold uppercase tracking-wider text-brand-walnut group-hover:text-brand-stamp transition-colors">Devamını oku</span>
      <span class="text-brand-walnut group-hover:text-brand-stamp group-hover:translate-x-1 transition-all">→</span>
    </div>
  </article>
</a>
