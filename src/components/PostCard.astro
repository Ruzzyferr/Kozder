---
import { formatEventDate } from '../utils/date';

interface Props {
  title: string;
  summary: string;
  date: string;
  tags: string[];
  slug: string;
}

const { title, summary, date, tags, slug } = Astro.props;
const formattedDate = formatEventDate(date);
---

<a href={`/duyurular/${slug}`} class="group block h-full">
  <article class="card card-hover h-full bg-brand-cream p-6 sm:p-7 flex flex-col">
    <time datetime={date} class="text-[10px] font-semibold uppercase tracking-[0.18em] text-brand-stamp">
      {formattedDate}
    </time>

    <h3 class="mt-4 font-display font-bold text-xl sm:text-[1.4rem] text-brand-ink leading-[1.14] tracking-tight group-hover:text-brand-stamp transition-colors duration-300">
      {title}
    </h3>

    <p class="mt-3 text-sm text-ink-soft leading-relaxed line-clamp-4 flex-1">{summary}</p>

    {tags.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-1.5">
        {tags.map(tag => (
          <li class="text-[10px] font-semibold uppercase tracking-[0.12em] px-2 py-1 border border-line-strong text-ink-muted">
            {tag}
          </li>
        ))}
      </ul>
    )}

    <span class="mt-6 pt-4 border-t border-line flex items-center justify-between text-[11px] font-semibold uppercase tracking-[0.16em] text-brand-walnut">
      Devamını oku
      <span class="text-base transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
    </span>
  </article>
</a>
