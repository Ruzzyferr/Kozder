---
import { formatEventDate, formatEventTime } from '../utils/date';

interface Props {
  title: string;
  date: string;
  time?: string;
  location: string;
  coverImage?: string;
  slug: string;
}

const { title, date, time, location, coverImage, slug } = Astro.props;
const formattedDate = formatEventDate(date);
const formattedTime = formatEventTime(time);
---

<a href={`/etkinlikler/${slug}`} class="block group h-full">
  <article class="relative h-full bg-brand-cream border-2 border-brand-ink transition-all duration-300 hover:-translate-y-1 hover:translate-x-0.5 flex flex-col" style="box-shadow: 4px 4px 0 0 #6B4630;">
    {coverImage && (
      <div class="relative aspect-[3/2] bg-surface-muted overflow-hidden border-b-2 border-brand-ink">
        <img
          src={coverImage}
          alt={title}
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )}
    <div class="p-5 sm:p-6 flex-1 flex flex-col">
      <h3 class="font-display font-bold text-xl sm:text-2xl text-brand-ink mb-4 group-hover:text-brand-stamp transition-colors leading-[1.1] tracking-tight line-clamp-2">
        {title}
      </h3>

      <div class="space-y-2 text-sm text-ink-soft mt-auto pt-4 border-t border-brand-ink/15">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-brand-walnut flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="text-brand-ink font-semibold">{formattedDate}</span>
          {formattedTime && (
            <>
              <span class="text-brand-walnut">·</span>
              <span class="text-brand-ink font-semibold">{formattedTime}</span>
            </>
          )}
        </div>
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-brand-walnut flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span class="text-brand-ink leading-snug">{location}</span>
        </div>
      </div>
    </div>
  </article>
</a>
