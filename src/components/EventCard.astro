---
import CardMedia from './CardMedia.astro';
import { formatEventDate, formatEventTime, getEventDateSortKey } from '../utils/date';

interface Props {
  title: string;
  date: string;
  time?: string;
  location: string;
  coverImage?: string;
  coverFit?: 'cover' | 'contain';
  slug: string;
  /** Tarihi geçmiş etkinlikler rozetle işaretlenir. */
  past?: boolean;
}

const { title, date, time, location, coverImage, coverFit = 'cover', slug, past = false } = Astro.props;
const formattedDate = formatEventDate(date);
const formattedTime = formatEventTime(time);

const key = getEventDateSortKey(date);
const d = key ? new Date(key) : null;
const day = d ? String(d.getDate()).padStart(2, '0') : '·';
const month = d ? d.toLocaleDateString('tr-TR', { month: 'short' }).replace('.', '').toUpperCase() : '';
---

<a href={`/etkinlikler/${slug}`} class="group block h-full">
  <article class="card card-hover h-full bg-brand-cream flex flex-col">
    <CardMedia src={coverImage} alt={title} fit={coverFit} ratio="aspect-square">
      <span class="absolute top-3 left-3 bg-brand-cream/95 backdrop-blur-sm px-2.5 py-1.5 text-center leading-none">
        <span class="block font-display font-black text-lg text-brand-ink tracking-tightest">{day}</span>
        <span class="mt-0.5 block text-[9px] font-semibold uppercase tracking-[0.14em] text-brand-stamp">{month}</span>
      </span>
      {past && (
        <span class="absolute top-3 right-3 bg-brand-ink/85 backdrop-blur-sm text-brand-cream text-[10px] font-semibold uppercase tracking-[0.16em] px-2.5 py-1.5">
          Geçmiş
        </span>
      )}
    </CardMedia>

    <div class="p-5 sm:p-6 flex-1 flex flex-col">
      <h3 class="font-display font-bold text-xl text-brand-ink leading-[1.15] tracking-tight line-clamp-2 group-hover:text-brand-stamp transition-colors duration-300">
        {title}
      </h3>

      <dl class="mt-auto pt-5 space-y-1.5 text-sm">
        <div class="flex gap-2">
          <dt class="sr-only">Tarih</dt>
          <dd class="text-brand-ink font-medium">
            {formattedDate}{formattedTime ? ` · ${formattedTime}` : ''}
          </dd>
        </div>
        <div class="flex gap-2">
          <dt class="sr-only">Konum</dt>
          <dd class="text-ink-muted leading-snug">{location}</dd>
        </div>
      </dl>
    </div>
  </article>
</a>
