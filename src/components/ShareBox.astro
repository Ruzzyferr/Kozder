---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
---

<div class="bg-brand-cream border border-brand-ink p-6" data-share>
  <p class="text-xs font-bold uppercase tracking-[0.2em] text-brand-stamp mb-3">Paylaş</p>
  <div class="grid grid-cols-3 gap-2">
    <a href={`https://wa.me/?text=${encodeURIComponent(title + ' ' + url)}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center h-11 border border-brand-ink/40 hover:bg-brand-ink hover:text-brand-cream text-sm font-bold uppercase tracking-wider transition-colors">WhatsApp</a>
    <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center h-11 border border-brand-ink/40 hover:bg-brand-ink hover:text-brand-cream text-sm font-bold uppercase tracking-wider transition-colors">X</a>
    <button type="button" data-copy={url} class="flex items-center justify-center h-11 border border-brand-ink/40 hover:bg-brand-ink hover:text-brand-cream text-sm font-bold uppercase tracking-wider transition-colors">Link</button>
  </div>
  <p data-copy-toast class="mt-3 text-xs font-bold uppercase tracking-wider text-brand-stamp hidden">Kopyalandı ✓</p>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-share] button[data-copy]').forEach(btn => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const toast = btn.closest('[data-share]')?.querySelector<HTMLElement>('[data-copy-toast]');
        toast?.classList.remove('hidden');
        setTimeout(() => toast?.classList.add('hidden'), 2000);
      } catch {}
    });
  });
</script>
