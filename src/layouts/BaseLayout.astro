---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { ORG_SCHEMA } from '../utils/seo';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  socialUrl?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
  lang?: Lang;
  /** Aynı sayfanın diğer dildeki yolu — hreflang için. */
  alternate?: string;
}

const {
  title,
  description,
  image = '/images/logo.png',
  imageAlt = title,
  imageWidth,
  imageHeight,
  socialUrl,
  noindex = false,
  jsonLd,
  alternate,
} = Astro.props;
const lang: Lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialURL = socialUrl ? new URL(socialUrl, Astro.site) : canonicalURL;
const ogImage = new URL(image, Astro.site);
const cleanImagePath = ogImage.pathname.toLowerCase();
const ogImageType = cleanImagePath.endsWith('.png')
  ? 'image/png'
  : cleanImagePath.endsWith('.gif')
    ? 'image/gif'
    : 'image/jpeg';
// hreflang adresleri karşı sayfanın canonical'ıyla birebir aynı olmalı;
// canonical'lar sonda eğik çizgi taşıyor.
const altURL = alternate ? new URL(alternate.endsWith('/') ? alternate : `${alternate}/`, Astro.site) : null;
const other: Lang = lang === 'tr' ? 'en' : 'tr';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FBFBFA" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/png" href="/images/logo.png?v=2" />
    <link rel="shortcut icon" href="/images/logo.png?v=2" />
    <link rel="apple-touch-icon" href="/images/logo.png?v=2" />

    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {altURL && <link rel="alternate" hreflang={other} href={altURL} />}
    {altURL && <link rel="alternate" hreflang={lang} href={canonicalURL} />}
    {altURL && <link rel="alternate" hreflang="x-default" href={lang === 'tr' ? canonicalURL : altURL} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KOZ-DER" />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta property="og:url" content={socialURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    {imageWidth && <meta property="og:image:width" content={imageWidth} />}
    {imageHeight && <meta property="og:image:height" content={imageHeight} />}
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={socialURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <JsonLd data={ORG_SCHEMA} />
    {jsonLd && <JsonLd data={jsonLd} />}

    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-brand-paper text-ink antialiased font-body relative">
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 wash"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-ink focus:text-brand-cream focus:rounded-none focus:border-2 focus:border-brand-cream focus:shadow-stampLg focus:outline-none"
    >
      {t('a11y.skip')}
    </a>

    <Header lang={lang} alternate={alternate} />

    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  :root {
    --canvas: #FBFBFA;
    --surface: #FFFFFF;
    --sunken: #F3F3F1;
    --ink: #0B0B0C;
    --body: #4B4B54;
    --muted: #67676F;
    --accent: #CE3A1F;

    --line-subtle: rgb(11 11 12 / 0.06);
    --line: rgb(11 11 12 / 0.10);
    --line-strong: rgb(11 11 12 / 0.20);

    /* Nötr, geniş, yumuşak. Kahve tonlu gölge yeni palette kirli duruyordu. */
    --e1: 0 1px 2px rgb(11 11 12 / 0.04), 0 1px 3px rgb(11 11 12 / 0.05);
    --e2: 0 2px 4px rgb(11 11 12 / 0.03), 0 10px 28px -8px rgb(11 11 12 / 0.10);
    --e3: 0 4px 10px rgb(11 11 12 / 0.04), 0 28px 64px -16px rgb(11 11 12 / 0.16);

    --r-card: 18px;
    --r-media: 14px;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --focus-ring: 0 0 0 2px #FFFFFF, 0 0 0 4px rgb(225 68 43 / 0.6);
  }

  html { scroll-behavior: smooth; }

  body {
    font-feature-settings: 'kern' 1, 'liga' 1, 'calt' 1, 'ss01' 1;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  *:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 8px;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    letter-spacing: -0.035em;
  }

  /* Büyük başlıklarda optik boyut + hafif daraltma: iri puntoda daha sıkı,
     daha "editoryal" bir renk veriyor. */
  .font-display {
    font-variation-settings: 'opsz' 72, 'wdth' 92;
  }

  ::selection { background: var(--accent); color: #FFFFFF; }

  /* ---- Yüzey sistemi ---------------------------------------------------- */
  .card {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    box-shadow: var(--e1);
    overflow: hidden;
    transition: box-shadow 0.35s var(--ease), transform 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }
  .card-2 { box-shadow: var(--e2); }
  .card-3 { box-shadow: var(--e3); }

  .card-hover:hover {
    box-shadow: var(--e3);
    transform: translateY(-4px);
    border-color: rgb(11 11 12 / 0.14);
  }

  .panel-ink {
    background: var(--ink);
    color: #FFFFFF;
    border-radius: var(--r-card);
  }

  .hairline { border: 1px solid var(--line); }
  .hairline-t { border-top: 1px solid var(--line); }
  .hairline-b { border-bottom: 1px solid var(--line); }

  .rule-double {
    border-top: 1px solid var(--line-strong);
    border-bottom: 0;
    height: 1px;
  }

  .lift { box-shadow: var(--e2); }
  .lift-stamp { box-shadow: var(--e1); }
  .stamp-ring { box-shadow: inset 0 0 0 1px currentColor; }

  /* Cam başlık */
  .glass {
    background: rgb(251 251 250 / 0.72);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
  }

  /* Bölüm arkası renk yıkaması */
  .wash {
    background-image: radial-gradient(1100px 560px at 10% -12%, rgb(225 68 43 / 0.07), transparent 60%),
      radial-gradient(880px 460px at 94% 6%, rgb(47 107 255 / 0.05), transparent 62%);
  }

  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    transition-delay: var(--d, 0ms);
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  /* Izgara/liste çocuklarını sırayla getirir — tek seferde belirmek
     "şablon" hissi veriyor, kademeli giriş elle kurulmuş izlenimi bırakıyor. */
  .stagger > * {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--ease), transform 0.7s var(--ease);
    transition-delay: var(--d, 0ms);
  }
  .stagger.is-visible > * { opacity: 1; transform: translateY(0); }

  /* Hero görseli yavaşça yerine oturur */
  @keyframes hero-in {
    from { opacity: 0; transform: scale(1.06); }
    to   { opacity: 1; transform: scale(1); }
  }
  .hero-media img {
    animation: hero-in 1.4s var(--ease) both;
  }

  /* Bağlantı altı çizgisi soldan açılır */
  .link-sweep {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.45s var(--ease);
  }
  .link-sweep:hover { background-size: 100% 1px; }

  /* ---- Makale tipografisi ---------------------------------------------- */
  .prose-kozder {
    color: var(--body);
    font-size: 1.0625rem;
    line-height: 1.75;
    font-family: 'Instrument Sans', system-ui, sans-serif;
  }

  .prose-kozder > p:first-of-type::first-letter {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-variation-settings: 'opsz' 96, 'wdth' 88;
    font-weight: 700;
    font-size: 3.6rem;
    line-height: 0.82;
    float: left;
    padding: 0.3rem 0.7rem 0 0;
    color: var(--ink);
  }

  .prose-kozder p { margin-bottom: 1.25rem; }

  .prose-kozder h1 {
    font-size: 2rem; font-weight: 700; color: var(--ink);
    margin: 2.5rem 0 1rem; letter-spacing: -0.035em; line-height: 1.14;
  }


  .prose-kozder h2 {
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--ink);
    margin: 2.75rem 0 1rem;
    padding-bottom: 0;
    border-bottom: 0;
    letter-spacing: -0.035em;
    line-height: 1.18;
  }

  .prose-kozder h3 {
    font-size: 1.28rem; font-weight: 600; color: var(--ink);
    margin: 2rem 0 0.65rem; letter-spacing: -0.028em; line-height: 1.28;
  }

  .prose-kozder ul { list-style: none; padding-left: 0; margin-bottom: 1.25rem; }
  .prose-kozder ul li { position: relative; padding-left: 1.35rem; margin-bottom: 0.55rem; }
  .prose-kozder ul li::before {
    content: "";
    position: absolute;
    left: 0; top: 0.66em;
    width: 6px; height: 6px;
    border-radius: 99px;
    background: var(--accent);
  }

  .prose-kozder strong {
    color: var(--ink);
    font-weight: 600;
    background: none;
  }

  .prose-kozder a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
    font-weight: 500;
    transition: color 0.25s var(--ease);
  }
  .prose-kozder a:hover { color: var(--accent); }

  .prose-kozder blockquote {
    border-left: 2px solid var(--accent);
    padding: 0.2rem 0 0.2rem 1.4rem;
    margin: 2rem 0;
    background: none;
    font-style: normal;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-variation-settings: 'opsz' 32, 'wdth' 95;
    font-size: 1.22rem;
    font-weight: 500;
    line-height: 1.5;
    color: var(--ink);
  }

  .modern-content { color: var(--body); }

  /* Marquee */
  /* Keyframe'i burada tanımlıyoruz: Tailwind config'deki `marquee-x` sadece
     `animate-marquee-x` utility'si kullanıldığında CSS'e basılıyor, burada ise
     ham sınıf üzerinden çağrılıyor. */
  @keyframes marquee-x {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    /* Kutucukların sert gölgesi (4px) kırpılmasın. */
    padding-block: 0.25rem 0.75rem;
  }
  .marquee__track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 2rem;
    /* Sondaki boşluk parçanın genişliğine dahil olmalı ki iki kopya
       -50%'de kusursuz eklensin. */
    padding-right: 2rem;
    margin: 0;
    padding-left: 0;
    list-style: none;
    animation: marquee-x 34s linear infinite;
    will-change: transform;
  }
  .marquee__track--reverse {
    animation-direction: reverse;
  }
  /* Yükseklik logo başına --logo-h ile geliyor (LogoMarquee, en-boy oranına
     göre hesaplıyor); dar ekranda hepsi orantılı küçülüyor. */
  .marquee__logo {
    width: auto;
    height: auto;
    max-height: var(--logo-h, 56px);
    max-width: 10rem;
    object-fit: contain;
  }
  @media (max-width: 640px) {
    .marquee__logo {
      max-height: calc(var(--logo-h, 56px) * 0.82);
      max-width: 8.5rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .marquee:hover .marquee__track {
      animation-play-state: paused;
    }
  }
  /* Klavye kullanıcısı bağlantıya geldiğinde durur; fareyle tıklanan bağlantı
     odağı üzerinde tutup şeridi kalıcı olarak durdurmaz. */
  .marquee:has(a:focus-visible) .marquee__track {
    animation-play-state: paused;
  }

  /* Diagonal stripe utility for postcard banners */
  .stripes-walnut {
    background-image: repeating-linear-gradient(
      135deg,
      #6B4630 0,
      #6B4630 8px,
      #231C1C 8px,
      #231C1C 16px
    );
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; transition: none; }
    *, *::before, *::after { animation-duration: 0s !important; transition-duration: 0s !important; }
    /* Animasyon kapalıyken logolar kırpılıp erişilemez kalmasın:
       şerit elle kaydırılabilir hale gelsin, ikinci kopya gizlensin. */
    .marquee__track { animation: none !important; }
    .marquee { overflow-x: auto; }
    .marquee__track[aria-hidden='true'] { display: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
  );

  function init() {
    const items = document.querySelectorAll('.reveal, .stagger');
    if (reduce) {
      items.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    items.forEach((el) => {
      // Kademeli grupların çocuklarına artan gecikme ver
      if (el.classList.contains('stagger')) {
        [...el.children].forEach((child, i) => {
          child.style.setProperty('--d', `${Math.min(i, 8) * 70}ms`);
        });
      }
      observer.observe(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<script>
  import {
    formatEventDate,
    getEventDateSortKey,
    getNextWeeklyEventDate,
    type EventWeekday,
  } from '../utils/date';
  import {
    buildEventStartDate,
    buildIcsString,
    googleCalendarUrl,
    isAllDay,
  } from '../utils/calendar';

  let recurringEventsTimer: number | undefined;

  function refreshRecurringEvents() {
    document.querySelectorAll<HTMLElement>('[data-recurring-event="weekly"]').forEach((element) => {
      const weekday = element.dataset.weekday as EventWeekday | undefined;
      if (!weekday) return;

      const time = element.dataset.time || '00:00';
      const timezone = element.dataset.timezone || 'Europe/Istanbul';
      const lang = element.dataset.lang === 'en' ? 'en' : 'tr';
      const effectiveDate = getNextWeeklyEventDate(weekday, time, timezone);
      const includeWeekday = element.dataset.showWeekday === 'true';
      const formattedDate = formatEventDate(effectiveDate, { weekday: includeWeekday, lang });

      element.querySelectorAll<HTMLElement>('[data-event-date]').forEach((node) => {
        node.textContent = formattedDate;
      });

      const dateKey = getEventDateSortKey(effectiveDate);
      if (dateKey) {
        const date = new Date(dateKey);
        const day = String(date.getDate()).padStart(2, '0');
        const month = date
          .toLocaleDateString(lang === 'en' ? 'en-GB' : 'tr-TR', { month: 'short' })
          .replace('.', '')
          .toUpperCase();

        element.querySelectorAll<HTMLElement>('[data-event-day]').forEach(node => {
          node.textContent = day;
        });
        element.querySelectorAll<HTMLElement>('[data-event-month]').forEach(node => {
          node.textContent = month;
        });
      }

      const gcalLink = element.querySelector<HTMLAnchorElement>('[data-event-gcal]');
      const icsLink = element.querySelector<HTMLAnchorElement>('[data-event-ics]');
      if (!gcalLink && !icsLink) return;

      const start = buildEventStartDate(effectiveDate, time, timezone);
      if (!start) return;
      const allDay = isAllDay(start);
      const end = new Date(start.getTime() + (allDay ? 0 : 2 * 60 * 60 * 1000));
      const title = element.dataset.eventTitle || 'KOZ-DER Speaking Club';
      const location = element.dataset.eventLocation || '';
      const url = element.dataset.eventUrl || window.location.href;
      const uid = element.dataset.eventUid || 'speakingclub-2026@kozder.com';
      const calendarEvent = {
        uid,
        title,
        description: `${title}\n\n${url}`,
        location,
        start,
        end,
        url,
        allDay,
        timeZone: timezone,
      };

      if (gcalLink) gcalLink.href = googleCalendarUrl(calendarEvent);
      if (icsLink) {
        icsLink.href = `data:text/calendar;charset=utf-8,${encodeURIComponent(buildIcsString(calendarEvent))}`;
      }
    });
  }

  function initRecurringEvents() {
    refreshRecurringEvents();
    if (recurringEventsTimer) window.clearInterval(recurringEventsTimer);
    recurringEventsTimer = window.setInterval(refreshRecurringEvents, 30_000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initRecurringEvents, { once: true });
  } else {
    initRecurringEvents();
  }
  document.addEventListener('astro:page-load', initRecurringEvents);
</script>

<script>
  function linkifyEmailAddresses(root: Node = document.body) {
    const emailPattern = /([A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,})/gi;
    const exactEmailPattern = /^[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}$/i;
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];

    while (walker.nextNode()) {
      const node = walker.currentNode as Text;
      const parent = node.parentElement;
      if (!parent || parent.closest('a, script, style, code, pre, textarea, input, [contenteditable]')) continue;

      emailPattern.lastIndex = 0;
      if (emailPattern.test(node.textContent || '')) textNodes.push(node);
    }

    textNodes.forEach((node) => {
      const parts = (node.textContent || '').split(emailPattern);
      if (parts.length < 2) return;

      const fragment = document.createDocumentFragment();
      parts.forEach((part) => {
        if (exactEmailPattern.test(part)) {
          const link = document.createElement('a');
          link.href = `mailto:${part}`;
          link.textContent = part;
          link.className = 'underline decoration-brand-stamp underline-offset-4 hover:text-brand-stamp transition-colors';
          fragment.appendChild(link);
        } else {
          fragment.appendChild(document.createTextNode(part));
        }
      });
      node.parentNode?.replaceChild(fragment, node);
    });
  }

  function initEmailLinks() {
    linkifyEmailAddresses(document.body);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmailLinks, { once: true });
  } else {
    initEmailLinks();
  }
  document.addEventListener('astro:page-load', initEmailLinks);

  document.addEventListener('click', (event) => {
    const clicked = event.target;
    if (!(clicked instanceof Element)) return;

    const emailLink = clicked.closest('a[href^="mailto:"]');
    if (!(emailLink instanceof HTMLAnchorElement)) return;

    const address = emailLink.href.replace(/^mailto:/i, '').split('?')[0];
    if (!address) return;

    event.preventDefault();
    const gmailComposeUrl = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(address)}`;
    window.open(gmailComposeUrl, '_blank', 'noopener,noreferrer');
  });
</script>

