---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { ORG_SCHEMA } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { title, description, image = '/og-image.svg', noindex = false, jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#6B4630" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/png" href="/images/logo.png?v=2" />
    <link rel="shortcut icon" href="/images/logo.png?v=2" />
    <link rel="apple-touch-icon" href="/images/logo.png?v=2" />

    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KOZ-DER" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..900,0..100,0..1&family=JetBrains+Mono:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&family=Oswald:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <JsonLd data={ORG_SCHEMA} />
    {jsonLd && <JsonLd data={jsonLd} />}

    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-brand-paper text-ink antialiased font-body relative">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-ink focus:text-brand-cream focus:rounded-none focus:border-2 focus:border-brand-cream focus:shadow-stampLg focus:outline-none"
    >
      İçeriğe atla
    </a>

    <Header />

    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-paper: #F4ECD8;
    --color-cream: #FFFBF1;
    --color-walnut: #6B4630;
    --color-ink: #231C1C;
    --color-stamp: #9C2A1B;
    --focus-ring: 0 0 0 3px rgb(155 42 27 / 0.35);
  }

  html {
    scroll-behavior: smooth;
  }

  *:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Oswald', sans-serif;
  }

  ::selection {
    background: #6B4630;
    color: #FFFBF1;
  }

  /* Postcard rule — thin double line divider */
  .rule-double {
    border-top: 1px solid #231C1C;
    border-bottom: 1px solid #231C1C;
    height: 4px;
  }

  /* Editorial drop shadow lifts off the page */
  .lift {
    box-shadow: 0 1px 0 0 rgba(35,28,28,0.4), 6px 6px 0 0 rgba(107,70,48,0.18);
  }

  .lift-stamp {
    box-shadow: 4px 4px 0 0 #231C1C;
  }

  /* Inverse stamp ring */
  .stamp-ring {
    box-shadow: inset 0 0 0 2px currentColor;
  }

  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Article typography (used inside .prose-kozder) */
  .prose-kozder {
    color: #3F3530;
    font-size: 1.05rem;
    line-height: 1.75;
    font-family: 'Montserrat', sans-serif;
  }

  .prose-kozder > p:first-of-type::first-letter {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 700;
    font-size: 4.25rem;
    line-height: 0.85;
    float: left;
    padding: 0.3rem 0.75rem 0 0;
    color: #6B4630;
  }

  .prose-kozder p {
    margin-bottom: 1.25rem;
  }

  .prose-kozder h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2.125rem;
    font-weight: 800;
    color: #161110;
    margin: 2.75rem 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #161110;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .prose-kozder h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #161110;
    margin: 2rem 0 0.75rem;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .prose-kozder ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1.25rem;
  }

  .prose-kozder ul li {
    position: relative;
    padding-left: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .prose-kozder ul li::before {
    content: "✦";
    position: absolute;
    left: 0;
    top: 0;
    color: #6B4630;
    font-weight: 700;
  }

  .prose-kozder strong {
    color: #231C1C;
    font-weight: 700;
    background: linear-gradient(transparent 60%, rgba(247,197,72,0.4) 60%);
  }

  .prose-kozder a {
    color: #6B4630;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    font-weight: 600;
  }

  .prose-kozder a:hover {
    color: #9C2A1B;
  }

  .prose-kozder blockquote {
    border-left: 4px solid #6B4630;
    padding: 0.75rem 1.5rem;
    margin: 2rem 0;
    background: rgba(247,197,72,0.12);
    font-style: italic;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.15rem;
    color: #231C1C;
  }

  /* Backwards-compat for any pages still using modern-content */
  .modern-content {
    color: #3F3530;
  }

  /* Marquee */
  .marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 2rem;
  }
  .marquee__track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 2rem;
    animation: marquee-x 35s linear infinite;
    padding-right: 2rem;
  }

  /* Diagonal stripe utility for postcard banners */
  .stripes-walnut {
    background-image: repeating-linear-gradient(
      135deg,
      #6B4630 0,
      #6B4630 8px,
      #231C1C 8px,
      #231C1C 16px
    );
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; transition: none; }
    *, *::before, *::after { animation-duration: 0s !important; transition-duration: 0s !important; }
    .marquee__track { animation: none !important; }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  });
</script>
