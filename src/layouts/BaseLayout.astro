---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { ORG_SCHEMA } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const { title, description, image = '/og-image.svg', noindex = false, jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F5F1E7" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <link rel="icon" type="image/png" href="/images/logo.png?v=2" />
    <link rel="shortcut icon" href="/images/logo.png?v=2" />
    <link rel="apple-touch-icon" href="/images/logo.png?v=2" />

    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KOZ-DER" />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,300..900,0..100,0..1&family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <JsonLd data={ORG_SCHEMA} />
    {jsonLd && <JsonLd data={jsonLd} />}

    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-brand-paper text-ink antialiased font-body relative">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:bg-brand-ink focus:text-brand-cream focus:rounded-none focus:border-2 focus:border-brand-cream focus:shadow-stampLg focus:outline-none"
    >
      İçeriğe atla
    </a>

    <Header />

    <main id="main-content" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --color-paper: #F5F1E7;
    --color-cream: #FFFDF8;
    --color-walnut: #6B4630;
    --color-ink: #14100F;
    --color-stamp: #9C2A1B;

    /* Saç teli çizgiler — kalın mürekkep kenarlığın yerini alır */
    --line-subtle: rgb(20 16 15 / 0.07);
    --line: rgb(20 16 15 / 0.13);
    --line-strong: rgb(20 16 15 / 0.26);

    /* Üç kademeli yumuşak yükseklik. Sert ofset gölge artık kullanılmıyor. */
    --e1: 0 1px 2px rgb(20 16 15 / 0.04), 0 2px 8px -3px rgb(107 70 48 / 0.10);
    --e2: 0 2px 4px rgb(20 16 15 / 0.04), 0 10px 26px -8px rgb(107 70 48 / 0.16);
    --e3: 0 4px 10px rgb(20 16 15 / 0.05), 0 22px 54px -14px rgb(107 70 48 / 0.22);

    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --focus-ring: 0 0 0 2px #FFFDF8, 0 0 0 4px rgb(155 42 27 / 0.55);
  }

  /* Fraunces optik boyut ekseni: büyük puntoda display, küçükte metin kesimi */
  .font-display {
    font-variation-settings: 'opsz' 96;
  }

  body {
    font-feature-settings: 'kern' 1, 'liga' 1, 'calt' 1;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  html {
    scroll-behavior: smooth;
  }

  *:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 3px;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.025em;
  }

  ::selection {
    background: #6B4630;
    color: #FFFDF8;
  }

  /* ---- Yüzey sistemi -------------------------------------------------
     Kartlar zeminden RENKLE değil IŞIKLA ayrılır: saç teli çizgi + yumuşak
     gölge. `.card` sessiz varsayılan, `.card-2` öne çıkan yüzey. Eski sert
     ofset gölge (`Npx Npx 0 0`) artık hiçbir yerde üretilmiyor. ------------ */
  .card {
    /* Arka plan bilinçli olarak belirtilmiyor: kutucukların kendi bg-* sınıfı
       (bg-brand-cream, bg-white) geçerli kalsın, sınıf sırası kazası olmasın. */
    border: 1px solid var(--line);
    box-shadow: var(--e1);
    transition: box-shadow 0.3s var(--ease), transform 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .card-2 { box-shadow: var(--e2); }
  .card-3 { box-shadow: var(--e3); }

  /* Etkileşimli kartlar. Kalkış küçük tutuluyor; abartılı hareket ucuz durur. */
  .card-hover:hover {
    box-shadow: var(--e3);
    transform: translateY(-3px);
    border-color: var(--line-strong);
  }

  /* Koyu panel — bilinçli aksan. Kalın mürekkep kenarlığın hâlâ hak ettiği yer. */
  .panel-ink {
    background: var(--color-ink);
    color: var(--color-cream);
    box-shadow: var(--e2);
  }

  .hairline { border: 1px solid var(--line); }
  .hairline-t { border-top: 1px solid var(--line); }
  .hairline-b { border-bottom: 1px solid var(--line); }

  /* İnce çift çizgi ayraç */
  .rule-double {
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-subtle);
    height: 3px;
  }

  /* Eski adlar yeni sisteme bağlandı */
  .lift { box-shadow: var(--e2); }
  .lift-stamp { box-shadow: var(--e1); }
  .stamp-ring { box-shadow: inset 0 0 0 1px currentColor; }

  /* Scroll reveal — 20px'lik sıçrama fazla göze çarpıyordu */
  .reveal {
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- Makale tipografisi (.prose-kozder) ---------------------------- */
  .prose-kozder {
    color: #4A403A;
    font-size: 1.0625rem;
    line-height: 1.75;
    font-family: 'Instrument Sans', system-ui, sans-serif;
  }

  .prose-kozder > p:first-of-type::first-letter {
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'opsz' 144;
    font-weight: 600;
    font-size: 4rem;
    line-height: 0.82;
    float: left;
    padding: 0.32rem 0.7rem 0 0;
    color: var(--color-walnut);
  }

  .prose-kozder p { margin-bottom: 1.25rem; }

  /* Gövdede h1 kalmamalı (sayfa şablonu zaten bir tane üretiyor) ama
     kaçarsa biçimsiz görünmesin. */
  .prose-kozder h1 {
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'opsz' 72;
    font-size: 2.1rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 2.5rem 0 1.1rem;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }

  .prose-kozder h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'opsz' 60;
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--color-ink);
    margin: 2.75rem 0 1.1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
    letter-spacing: -0.028em;
    line-height: 1.18;
  }

  .prose-kozder h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'opsz' 36;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 2rem 0 0.7rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .prose-kozder ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1.25rem;
  }

  .prose-kozder ul li {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: 0.5rem;
  }

  /* Süslü yıldız yerine sessiz bir tire — dinamik aralığın parçası */
  .prose-kozder ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.6rem;
    height: 1px;
    background: var(--color-walnut);
    opacity: 0.7;
  }

  .prose-kozder strong {
    color: var(--color-ink);
    font-weight: 600;
    background: linear-gradient(transparent 62%, rgba(240,194,74,0.32) 62%);
  }

  .prose-kozder a {
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: var(--color-walnut);
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    font-weight: 500;
    transition: color 0.2s var(--ease), text-decoration-color 0.2s var(--ease);
  }

  .prose-kozder a:hover {
    color: var(--color-stamp);
    text-decoration-color: var(--color-stamp);
  }

  .prose-kozder blockquote {
    border-left: 2px solid var(--color-walnut);
    padding: 0.4rem 0 0.4rem 1.5rem;
    margin: 2rem 0;
    background: none;
    font-style: normal;
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'opsz' 32, 'SOFT' 60;
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--color-ink);
  }

  /* Backwards-compat for any pages still using modern-content */
  .modern-content {
    color: #4A403A;
  }

  /* Marquee */
  /* Keyframe'i burada tanımlıyoruz: Tailwind config'deki `marquee-x` sadece
     `animate-marquee-x` utility'si kullanıldığında CSS'e basılıyor, burada ise
     ham sınıf üzerinden çağrılıyor. */
  @keyframes marquee-x {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee {
    display: flex;
    overflow: hidden;
    user-select: none;
    /* Kutucukların sert gölgesi (4px) kırpılmasın. */
    padding-block: 0.25rem 0.75rem;
  }
  .marquee__track {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 2rem;
    /* Sondaki boşluk parçanın genişliğine dahil olmalı ki iki kopya
       -50%'de kusursuz eklensin. */
    padding-right: 2rem;
    margin: 0;
    padding-left: 0;
    list-style: none;
    animation: marquee-x 34s linear infinite;
    will-change: transform;
  }
  .marquee__track--reverse {
    animation-direction: reverse;
  }
  /* Yükseklik logo başına --logo-h ile geliyor (LogoMarquee, en-boy oranına
     göre hesaplıyor); dar ekranda hepsi orantılı küçülüyor. */
  .marquee__logo {
    width: auto;
    height: auto;
    max-height: var(--logo-h, 56px);
    max-width: 10rem;
    object-fit: contain;
  }
  @media (max-width: 640px) {
    .marquee__logo {
      max-height: calc(var(--logo-h, 56px) * 0.82);
      max-width: 8.5rem;
    }
  }
  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track {
    animation-play-state: paused;
  }

  /* Diagonal stripe utility for postcard banners */
  .stripes-walnut {
    background-image: repeating-linear-gradient(
      135deg,
      #6B4630 0,
      #6B4630 8px,
      #231C1C 8px,
      #231C1C 16px
    );
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .reveal { opacity: 1; transform: none; transition: none; }
    *, *::before, *::after { animation-duration: 0s !important; transition-duration: 0s !important; }
    /* Animasyon kapalıyken logolar kırpılıp erişilemez kalmasın:
       şerit elle kaydırılabilir hale gelsin, ikinci kopya gizlensin. */
    .marquee__track { animation: none !important; }
    .marquee { overflow-x: auto; }
    .marquee__track[aria-hidden='true'] { display: none; }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  });
</script>
